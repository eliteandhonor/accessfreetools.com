{
  "name": "accessfreetools.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Access Free Tools - fast, free web utilities starting with a basic calculator.",
  "scripts": {
    "dev": "astro dev",
    "typecheck": "tsc --noEmit",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "audit:site": "vitest run src/data/siteContentAudit.test.ts",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm test && npm run build && npm run check:links && npm run check:structured-data && npm run security:audit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.6",
    "@astrojs/react": "^5.0.4",
    "astro": "^6.1.9",
    "lucide-react": "^1.11.0",
    "nodemailer": "^8.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
