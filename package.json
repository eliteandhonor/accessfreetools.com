{
  "name": "accessfreetools.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Access Free Tools - fast, free web utilities starting with a basic calculator.",
  "scripts": {
    "dev": "astro dev",
    "typecheck": "tsc --noEmit",
    "build": "astro build",
    "postbuild": "node scripts/mirror-static-output.mjs",
    "start": "node ./app.js",
    "preview": "astro preview",
    "test": "vitest run --configLoader runner",
    "audit:site": "vitest run --configLoader runner src/data/siteContentAudit.test.ts",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:site": "node scripts/check-built-site.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:ai-assets": "node scripts/check-ai-lazy-assets.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "assets:social": "node scripts/generate-social-cards.mjs",
    "promotion:pinterest-assets": "node scripts/generate-pinterest-assets.mjs",
    "promotion:pinterest": "node scripts/pinterest-organic-publisher.mjs",
    "promotion:pinterest:starter": "node scripts/pinterest-organic-publisher.mjs --slug=tools,free-calculator-resources,percentage-calculator,basic-calculator,mortgage-calculator,bmi-calculator,wallpaper-calculator,ai-tools,image-to-text-ocr-tool --publish",
    "promotion:pinterest:second-wave": "node scripts/pinterest-organic-publisher.mjs --slug=voltage-drop-calculator,sand-calculator,markdown-table-generator,body-surface-area-calculator,speed-calculator,payment-calculator,hex-calculator,amp-hours-to-watt-hours-calculator --publish",
    "promotion:pinterest:cleanup": "node scripts/pinterest-organic-publisher.mjs --cleanup-drafts",
    "promotion:pinterest:rss-report": "node scripts/pinterest-rss-report.mjs",
    "promotion:medium:images": "node scripts/generate-medium-hero-assets.mjs",
    "promotion:medium": "node scripts/medium-promotion-agent.mjs",
    "promotion:medium:starter": "node scripts/medium-promotion-agent.mjs --all",
    "promotion:medium:quality": "npm run promotion:medium:images && node scripts/medium-promotion-agent.mjs --all && node scripts/check-medium-writing-quality.mjs output/promotion/medium",
    "promotion:medium:quality:first": "npm run promotion:medium:images && node scripts/medium-promotion-agent.mjs --slug=right-free-online-calculator && node scripts/check-medium-writing-quality.mjs output/promotion/medium/right-free-online-calculator.md",
    "promotion:reddit": "node scripts/reddit-promotion-agent.mjs --all",
    "promotion:reddit:quality": "node scripts/reddit-promotion-agent.mjs --all && node scripts/check-reddit-promotion-quality.mjs output/promotion/reddit/drafts",
    "promotion:reddit:setup-browser": "node scripts/reddit-external-setup.mjs --keep-open",
    "promotion:reddit:verify-profile": "node scripts/reddit-verify-profile-post.mjs",
    "promotion:bluesky": "node scripts/bluesky-promotion-agent.mjs --all",
    "promotion:bluesky:avatar": "node scripts/generate-bluesky-avatar.mjs",
    "promotion:bluesky:profile-audit": "node scripts/bluesky-profile-audit.mjs",
    "promotion:bluesky:profile-update": "node scripts/bluesky-profile-update.mjs",
    "promotion:bluesky:quality": "node scripts/bluesky-promotion-agent.mjs --all && node scripts/check-bluesky-promotion-quality.mjs output/promotion/bluesky/drafts",
    "promotion:bluesky:publish": "node scripts/bluesky-promotion-agent.mjs --all --publish --confirm-public-post",
    "promotion:quora": "node scripts/quora-promotion-agent.mjs",
    "promotion:quora:quality": "node scripts/quora-promotion-agent.mjs && node scripts/check-quora-promotion-quality.mjs output/promotion/quora/drafts",
    "promotion:devto": "node scripts/devto-promotion-agent.mjs",
    "promotion:devto:quality": "node scripts/devto-promotion-agent.mjs && node scripts/check-devto-promotion-quality.mjs output/promotion/devto/drafts",
    "promotion:devto:publish": "node scripts/devto-promotion-agent.mjs --publish --confirm-public-post",
    "promotion:weekly-review": "npm run promotion:pinterest-assets && npm run promotion:pinterest:rss-report && npm run promotion:medium:quality && npm run promotion:reddit:quality && npm run promotion:bluesky:quality && npm run promotion:quora:quality && npm run promotion:devto:quality",
    "aft": "node scripts/aft-cli.mjs",
    "marketing:orchestrate": "node scripts/marketing-orchestrator-report.mjs",
    "hostinger:status": "node scripts/hostinger-status.mjs",
    "hostinger:websites": "node scripts/hostinger-websites.mjs",
    "hostinger:dns-audit": "node scripts/hostinger-dns-audit.mjs",
    "hostinger:deployments": "node scripts/hostinger-deployments.mjs",
    "hostinger:logs": "node scripts/hostinger-logs.mjs",
    "hostinger:mcp:help": "node scripts/hostinger-mcp-wrapper.mjs -- --help",
    "dataforseo:account": "node scripts/dataforseo-account.mjs",
    "dataforseo:status": "node scripts/dataforseo-status.mjs",
    "dataforseo:status:sandbox": "node scripts/dataforseo-status.mjs --sandbox",
    "seo:onpage-audit": "node scripts/seo-onpage-audit.mjs",
    "automation:env-check": "node scripts/automation-environment-check.mjs",
    "automation:monthly-onpage": "node scripts/monthly-onpage-automation.mjs",
    "automation:monthly-onpage:dry-run": "node scripts/monthly-onpage-automation.mjs --dry-run",
    "search-console": "node scripts/search-console.mjs",
    "search-console:submit-discovery": "node scripts/search-console.mjs --submit-discovery",
    "search-console:inspect-key-urls": "node scripts/search-console.mjs --inspect-key-urls",
    "seo:self-evaluate": "node scripts/seo-agent-self-evaluation.mjs",
    "seo:daily": "node scripts/dataforseo-account.mjs --min-balance=2 --warn-balance=10 && node scripts/dataforseo-status.mjs && node scripts/search-console.mjs --inspect-key-urls && node scripts/seo-agent-self-evaluation.mjs && node scripts/indexnow-submit.mjs --verify-key",
    "audit:local": "node scripts/deep-audit-local.mjs",
    "audit:indexing-protection": "node scripts/indexing-protection-audit.mjs",
    "audit:ai-crawler": "node scripts/ai-crawler-visibility-audit.mjs",
    "audit:hubs": "node scripts/hub-strength-audit.mjs",
    "audit:semantic-depth": "node scripts/semantic-depth-audit.mjs",
    "recognition:track": "node scripts/recognition-tracker.mjs",
    "content:usage-notes": "node scripts/usage-data-asset-report.mjs",
    "audit:deep": "node scripts/deep-audit-runner.mjs",
    "audit:deep:no-paid": "node scripts/deep-audit-runner.mjs --skip-paid",
    "audit:deep:no-paid:fast": "node scripts/deep-audit-runner.mjs --skip-paid --skip-smoke --skip-check --skip-search-console",
    "indexnow:verify-key": "node scripts/indexnow-submit.mjs --verify-key",
    "indexnow:dry-run": "node scripts/indexnow-submit.mjs --all --dry-run",
    "indexnow:submit": "node scripts/indexnow-submit.mjs --all --verify-production",
    "test:smoke": "npm run build && node scripts/run-playwright-smoke.mjs",
    "check:secrets": "node scripts/check-secret-redaction.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm test && npm run build && npm run check:links && npm run check:site && npm run check:structured-data && npm run check:performance && npm run check:ai-assets && npm run check:secrets && npm run security:audit",
    "check:production-sitemap": "node scripts/check-production-sitemap.mjs",
    "promotion:reddit:publish-profile": "node scripts/reddit-publish-profile-post.mjs --confirm-public-post",
    "automation:chrome-check": "node scripts/check-chrome-control-plugin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.6",
    "@astrojs/react": "^5.0.4",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "astro": "^6.1.9",
    "franc-min": "^6.2.0",
    "lucide-react": "^1.11.0",
    "nodemailer": "^8.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "commander": "^14.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
