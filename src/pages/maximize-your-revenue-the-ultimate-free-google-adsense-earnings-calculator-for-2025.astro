---
export const prerender = true;
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Ad Revenue Calculator | Access Free Tools"
  description="A shortcut to the Access Free Tools ad revenue calculator."
  path="/tools/ad-revenue-calculator/"
  noindex
>
  <script is:inline>
    window.location.replace('/tools/ad-revenue-calculator/');
  </script>

  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / Ad Revenue Calculator</p>
    <h1>Ad Revenue Calculator</h1>
    <p>
      This shortcut points to the current ad revenue calculator. If you are not moved automatically,
      open the calculator below.
    </p>
    <p><a class="card-link" href="/tools/ad-revenue-calculator/">Open ad revenue calculator</a></p>
  </section>
</BaseLayout>
