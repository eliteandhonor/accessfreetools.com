---
export const prerender = true;
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Age Calculator | Access Free Tools"
  description="A shortcut to the Access Free Tools age calculator."
  path="/tools/age-calculator/"
  noindex
>
  <script is:inline>
    window.location.replace('/tools/age-calculator/');
  </script>

  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / Age Calculator</p>
    <h1>Age Calculator</h1>
    <p>
      This shortcut points to the current age calculator. If you are not moved automatically,
      open the calculator below.
    </p>
    <p><a class="card-link" href="/tools/age-calculator/">Open age calculator</a></p>
  </section>
</BaseLayout>
