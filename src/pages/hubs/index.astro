---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import { topicalHubs } from '../../data/hubs';

const hubUseNotes = [
  'Use a hub when one calculator is not enough. A mortgage or personal-loan question may need payment, affordability, APR, fee, and payoff checks before the answer feels useful.',
  'Start with the tool that matches the main job, then open a support tool when the result turns into a comparison, a second estimate, or a warning sign.',
  'Read the matching guide when a result depends on assumptions. Finance, health, home project, electrical, and AI tools all need clear limits before people trust the output.',
  'Hubs also help internal links stay natural. They connect tools by task instead of pushing every visitor through one giant list.',
];
const hubStartingPoints = [
  {
    title: 'Planning a home loan',
    body: 'Open the mortgage hub when a house number needs a second check. Payment, affordability, refinance, and down-payment tools answer different parts of the same decision.',
  },
  {
    title: 'Borrowing or paying down debt',
    body: 'Open the loan and debt hub to estimate payments, compare APR and fees, review amortization, or test how extra payments change payoff time.',
  },
  {
    title: 'Checking a number',
    body: 'Open the percentage hub when the question is really about change, discount, increase, decrease, ratios, or comparing two values without guessing.',
  },
  {
    title: 'Sizing a project',
    body: 'Open the materials hub before buying sand, paint, flooring, concrete, or other project supplies. The result is a planning estimate, not a contractor sign-off.',
  },
  {
    title: 'Checking electrical numbers',
    body: 'Open the electrical hub when watts, amps, voltage, resistance, energy cost, or wire-run planning turns into more than one calculation. Keep installation and protection decisions with the applicable code and a qualified person.',
  },
  {
    title: 'Using browser tools',
    body: 'Open the AI or developer hub when you need a tool that explains inputs, privacy limits, file behavior, or output checks before you trust the result.',
  },
];
---

<BaseLayout
  title="Topical Tool Hubs | Access Free Tools"
  description="Browse focused hubs for mortgages, debt payoff, percentages, home materials, electrical calculators, browser AI, and developer utilities."
  path="/hubs/"
>
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Hubs', path: '/hubs/' },
    ]}
  />
  <CollectionStructuredData
    name="Topical Tool Hubs"
    description="Focused topic hubs that connect related tools, guides, and trust notes."
    path="/hubs/"
    items={topicalHubs.map((hub) => ({ name: hub.title, path: `/hubs/${hub.slug}/` }))}
    maxItems={topicalHubs.length}
  />

  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / Hubs</p>
    <h1>Topical Tool Hubs</h1>
    <p>
      Focused clusters for jobs that usually need more than one tool: home loans, debt payoff,
      percentages, project materials, electrical calculations, browser AI, and developer utilities.
    </p>
  </section>

  <section class="section-band sitemap-section">
    <div class="section-heading">
      <h2>Choose a hub</h2>
      <p>Each hub links the primary tools, matching guides, and the checks that keep the result useful.</p>
    </div>
    <div class="sitemap-link-grid">
      {topicalHubs.map((hub) => (
        <a href={`/hubs/${hub.slug}/`}>
          <strong>{hub.title}</strong>
          <span>{hub.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-band section-band-soft">
    <div class="section-heading">
      <h2>How to use a hub</h2>
      <p>
        Hubs are built for real paths through the library, not a pile of repeated links.
      </p>
    </div>
    <div class="feature-list">
      {hubUseNotes.map((note) => <p>{note}</p>)}
    </div>
  </section>

  <section class="section-band">
    <div class="section-heading">
      <h2>Pick the path that matches the job</h2>
      <p>
        If you already know the exact calculator, use it. If the task has more than one step,
        start with a hub and follow the links that match the next question.
      </p>
    </div>
    <div class="feature-list">
      {hubStartingPoints.map((point) => (
        <p><strong>{point.title}:</strong> {point.body}</p>
      ))}
    </div>
  </section>
</BaseLayout>
