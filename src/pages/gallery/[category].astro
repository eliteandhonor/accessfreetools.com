---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import { toolArtCategorySummaries, versionToolArtPath, type ToolArtManifestEntry } from '../../data/toolArt';

export function getStaticPaths() {
  return toolArtCategorySummaries
    .filter((category) => category.entries.length > 0)
    .map((category) => ({
      params: { category: category.slug },
      props: { category },
    }));
}

interface Props {
  category: (typeof toolArtCategorySummaries)[number];
}

const { category } = Astro.props;
const toolEntries = category.entries.filter((entry: ToolArtManifestEntry) => entry.kind === 'tool');
const guideEntries = category.entries.filter((entry: ToolArtManifestEntry) => entry.kind === 'guide');
const title = `${category.name} Smoke-Kawaii Art Gallery | Access Free Tools`;
const description = `Browse approved images for ${category.name.toLowerCase()} tool pages and matching guide pages on Access Free Tools.`;
const pageUrl = `https://accessfreetools.com/gallery/${category.slug}/`;
const categoryGalleryNotes = [
  `${category.name} artwork is only useful when it matches the page job. A tool image should make the input, result, or setting easier to understand.`,
  `Guide images are for walkthrough context. They should support examples, formulas, mistakes, or limits instead of acting like random decoration.`,
  'Every card sends visitors back to the matching tool or guide page, so the image is connected to the thing it explains.',
  'The gallery shows approved images that match real tools and guides. Draft or placeholder images stay out of the public gallery.',
];
const categoryFocusLinks: Record<string, { href: string; title: string; text: string }[]> = {
  converters: [
    {
      href: '/tools/conversion-calculator/',
      title: 'Conversion Calculator',
      text: 'Start here for common length, mass, volume, and temperature conversions.',
    },
    {
      href: '/tools/currency-calculator/',
      title: 'Currency Calculator',
      text: 'Use a manual exchange rate, fee percent, inverse-rate check, and provider-rate warning.',
    },
    {
      href: '/tools/oven-temperature-converter/',
      title: 'Oven Temperature Converter',
      text: 'Convert Fahrenheit, Celsius, and gas marks for recipes and appliance settings.',
    },
    {
      href: '/tools/cooking-measurement-converter/',
      title: 'Cooking Measurement Converter',
      text: 'Convert cups, tablespoons, grams, ounces, and common kitchen units.',
    },
  ],
};
const focusLinks = categoryFocusLinks[category.slug] ?? [];
const representativeEntries = category.entries.slice(0, 60);
const imageStructuredData = {
  '@context': 'https://schema.org',
  '@graph': representativeEntries.map((entry: ToolArtManifestEntry) => ({
    '@type': 'ImageObject',
    name: `${entry.toolName} ${entry.kind} image`,
    description: entry.alt,
    caption: entry.caption,
    contentUrl: `https://accessfreetools.com${entry.imagePath}`,
    thumbnailUrl: `https://accessfreetools.com${entry.thumbnailPath}`,
    width: 1200,
    height: 630,
    inLanguage: 'en',
    isPartOf: pageUrl,
    about: {
      '@type': 'WebPage',
      name: entry.toolName,
      url: `https://accessfreetools.com${entry.pagePath}`,
    },
  })),
};
---

<BaseLayout title={title} description={description} path={`/gallery/${category.slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(imageStructuredData)} />
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Gallery', path: '/gallery/' },
      { name: category.name, path: `/gallery/${category.slug}/` },
    ]}
  />
  <CollectionStructuredData
    name={`${category.name} Smoke-Kawaii Gallery`}
    description={description}
    path={`/gallery/${category.slug}/`}
    items={representativeEntries.map((entry: ToolArtManifestEntry) => ({ name: `${entry.toolName} ${entry.kind} image`, path: entry.pagePath }))}
    maxItems={representativeEntries.length}
  />

  <section class="page-intro gallery-hero">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/gallery/">Gallery</a> / {category.name}</p>
    <h1>{category.name} Smoke-Kawaii Gallery</h1>
    <p>
      {category.summary} This gallery connects each visual back to the page where it helps: tool
      images open the live utility, and guide images open the matching walkthrough.
    </p>
    <p>
      These are approved Access Free Tools page images, not stock art. Each card keeps the original
      caption, image size, and link to the matching tool or guide page.
    </p>
  </section>

  <section class="section-band gallery-preview-band">
    <div class="section-heading">
      <h2>Tool page artwork</h2>
      <p>These images link to live tools with calculators, examples, FAQs, and result notes.</p>
    </div>
    <div class="gallery-grid">
      {toolEntries.map((entry: ToolArtManifestEntry) => (
        <a class="gallery-card" id={`${entry.slug}-${entry.kind}`} href={entry.pagePath}>
          <img
            src={versionToolArtPath(entry.thumbnailPath)}
            alt={entry.alt}
            width="480"
            height="252"
            loading="lazy"
            decoding="async"
          />
          <span>Tool image</span>
          <strong>{entry.toolName}</strong>
          <small>{entry.caption}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="section-band section-band-soft gallery-preview-band">
    <div class="section-heading">
      <h2>Guide page artwork</h2>
      <p>These images link to guides with inputs, examples, formulas, limits, and mistakes to avoid.</p>
    </div>
    <div class="gallery-grid">
      {guideEntries.map((entry: ToolArtManifestEntry) => (
        <a class="gallery-card" id={`${entry.slug}-${entry.kind}`} href={entry.pagePath}>
          <img
            src={versionToolArtPath(entry.thumbnailPath)}
            alt={entry.alt}
            width="480"
            height="252"
            loading="lazy"
            decoding="async"
          />
          <span>Guide image</span>
          <strong>{entry.toolName}</strong>
          <small>{entry.caption}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="section-band gallery-preview-band">
    <div class="section-heading">
      <h2>What makes this image set worth indexing</h2>
      <p>
        Approved gallery pages stay indexable because the images have page context, captions, and
        links back to useful tools.
      </p>
    </div>
    <div class="feature-list">
      {categoryGalleryNotes.map((note) => <p>{note}</p>)}
    </div>
  </section>

  {focusLinks.length > 0 && (
    <section class="section-band section-band-soft gallery-preview-band" aria-labelledby="gallery-focus-heading">
      <div class="section-heading">
        <h2 id="gallery-focus-heading">Start with the matching converter</h2>
        <p>
          The gallery is useful when each image points back to a real task. These converter pages
          are the best places to start before browsing the artwork.
        </p>
      </div>
      <div class="category-link-list">
        {focusLinks.map((link) => (
          <a href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
