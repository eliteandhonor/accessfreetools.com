---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import { toolArtCategorySummaries, toolArtEntries, versionToolArtPath } from '../../data/toolArt';

const activeCategories = toolArtCategorySummaries.filter((category) => category.entries.length > 0);
const featuredEntries = toolArtEntries
  .filter((entry) => entry.kind === 'tool')
  .slice(0, 24);
const hasApprovedArt = toolArtEntries.length > 0;
const galleryChecks = [
  'Only approved tool and guide images are public. Draft, queued, rejected, placeholder, or failed-QA art stays out of the gallery and image sitemap.',
  'Each image links back to the exact tool or guide it was made for. A calculator picture should not point to a loose image page with no useful next step.',
  'Alt text and captions describe the actual tool image, not a vague mascot or category label. That helps readers, image search, and accessibility tools understand why the picture is here.',
  'Small thumbnails load on gallery pages, while the full artwork stays tied to the tool, guide, and image sitemap entry.',
];
const imageStructuredData = {
  '@context': 'https://schema.org',
  '@graph': featuredEntries.map((entry) => ({
    '@type': 'ImageObject',
    name: `${entry.toolName} tool image`,
    description: entry.alt,
    caption: entry.caption,
    contentUrl: `https://accessfreetools.com${entry.imagePath}`,
    thumbnailUrl: `https://accessfreetools.com${entry.thumbnailPath}`,
    width: 1200,
    height: 630,
    inLanguage: 'en',
    isPartOf: 'https://accessfreetools.com/gallery/',
    about: {
      '@type': 'WebPage',
      name: entry.toolName,
      url: `https://accessfreetools.com${entry.pagePath}`,
    },
  })),
};
---

<BaseLayout
  title="Smoke-Kawaii Tool Images Gallery | Access Free Tools"
  description="Browse approved Access Free Tools image pages, with visual artwork connected to tool pages and matching guide pages."
  path="/gallery/"
  noindex={!hasApprovedArt}
>
  {hasApprovedArt && <script type="application/ld+json" set:html={JSON.stringify(imageStructuredData)} />}
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Gallery', path: '/gallery/' },
    ]}
  />
  <CollectionStructuredData
    name="Smoke-Kawaii Tool Images Gallery"
    description="Gallery hub for approved artwork connected to Access Free Tools utilities and guides."
    path="/gallery/"
    items={activeCategories.map((category) => ({ name: category.name, path: `/gallery/${category.slug}/` }))}
    maxItems={activeCategories.length}
  />

  <section class="page-intro gallery-hero">
    <p class="breadcrumb"><a href="/">Home</a> / Gallery</p>
    <h1>Smoke-Kawaii Tool Images Gallery</h1>
    <p>
      This gallery only shows approved artwork that belongs with a real tool or guide page. Draft,
      placeholder, and failed-review images stay hidden.
    </p>
    <p>
      The point is simple: every public image should help explain a specific utility, then send the
      visitor back to that tool or its guide.
    </p>
  </section>

  {hasApprovedArt ? (
    <>
      <section class="section-band gallery-category-band">
        <div class="section-heading">
          <h2>Browse by category</h2>
          <p>Each category page groups artwork by the kind of tool it helps explain.</p>
        </div>
        <div class="gallery-category-grid">
          {activeCategories.map((category) => {
            const cover = category.entries[0];

            return (
              <a href={`/gallery/${category.slug}/`}>
                {cover && (
                  <img
                    src={versionToolArtPath(cover.thumbnailPath)}
                    alt={cover.alt}
                    title={cover.caption}
                    width="480"
                    height="252"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <strong>{category.name}</strong>
                <span>{category.toolCount} tool images and {category.guideCount} guide images. {category.summary}</span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="section-band section-band-soft gallery-preview-band">
        <div class="section-heading">
          <h2>Featured tool visuals</h2>
          <p>A quick sample from the approved artwork. Open a category to see the matching guide images too.</p>
        </div>
        <div class="gallery-grid">
          {featuredEntries.map((entry) => (
            <a class="gallery-card" id={`${entry.slug}-${entry.kind}`} href={entry.pagePath}>
              <img
                src={versionToolArtPath(entry.thumbnailPath)}
                alt={entry.alt}
                title={entry.caption}
                width="480"
                height="252"
                loading="lazy"
                decoding="async"
              />
              <span>{entry.categoryName}</span>
              <strong>{entry.toolName}</strong>
              <small>{entry.caption}</small>
            </a>
          ))}
        </div>
      </section>

      <section class="section-band gallery-preview-band">
        <div class="section-heading">
          <h2>How this gallery is kept useful</h2>
          <p>
            The gallery is meant to support the tools, not distract from them. These checks keep
            image SEO tied to real pages and real tasks.
          </p>
        </div>
        <div class="feature-list">
          {galleryChecks.map((check) => <p>{check}</p>)}
        </div>
      </section>
    </>
  ) : (
    <section class="section-band section-band-soft gallery-preview-band">
      <div class="section-heading">
        <h2>Gallery approval queue</h2>
        <p>
          Public gallery entries stay hidden until the exact image for that tool or guide passes
          a visual check.
        </p>
      </div>
      <div class="trust-callout">
        <strong>Quality rule:</strong> weak repeated art is not published. Approved images must
        look unique and clearly match the actual tool or guide.
      </div>
    </section>
  )}
</BaseLayout>
