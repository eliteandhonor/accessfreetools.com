---
export const prerender = true;
import BaseLayout from '../components/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { categories } from '../data/categories';
import { toolAliases } from '../data/toolAliases';
import { tools } from '../data/tools';
import '../styles/home-blog-discovery.css';

const categoriesWithTools = categories.filter(category => tools.some(tool => tool.category === category.slug));
const publicToolPageCount = tools.length + toolAliases.length;
const featuredToolSlugs = [
  'basic-calculator', 'fraction-calculator', 'date-calculator',
  'bmi-calculator', 'password-generator', 'sales-tax-calculator',
];
const featuredTools = featuredToolSlugs
  .map(slug => tools.find(tool => tool.slug === slug))
  .filter((tool): tool is NonNullable<typeof tool> => Boolean(tool));
const taskShortcuts = [
  { href: '/tools/percentage-calculator/', title: 'Work out a discount', detail: 'Percentages and price changes' },
  { href: '/tools/mortgage-calculator/', title: 'Estimate a mortgage payment', detail: 'Loan, rate, term, and costs' },
  { href: '/tools/conversion-calculator/', title: 'Convert pounds to kilograms', detail: 'Weight and other units' },
  { href: '/tools/image-to-text-ocr-tool/', title: 'Turn an image into text', detail: 'Browser OCR with accuracy limits' },
  { href: '/tools/wallpaper-calculator/', title: 'Plan wallpaper rolls', detail: 'Room size, coverage, and waste' },
  { href: '/tools/text-case-converter/', title: 'Change text case', detail: 'Uppercase, lowercase, and more' },
];
---

<BaseLayout
  title="Access Free Tools | Free Online Calculators and Utilities"
  description="Use Access Free Tools for free online calculators, converters, browser AI tools, and plain-English guides for math, finance, health, home projects, and more."
>
  <div class="task-first-home">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="hero-copy">
        <h1 id="home-heading">Access Free Tools</h1>
        <p>Free calculators and browser utilities for everyday tasks. Choose a task or search for what you need.</p>
      </div>
      <form class="home-task-search" action="/tools/" method="get" role="search">
        <label for="tool-search">Search free tools</label>
        <div class="home-search-controls">
          <input id="tool-search" name="q" type="search" placeholder="Try percentage discount or mortgage payment" />
          <button class="button-primary" type="submit">Search</button>
        </div>
        <p>No signup needed. Each tool explains its inputs and limits.</p>
      </form>
      <nav class="home-task-shortcuts" aria-label="Choose a task">
        {taskShortcuts.map(task => <a href={task.href}><strong>{task.title}</strong><span>{task.detail}</span></a>)}
      </nav>
    </section>

    <section class="section-band home-category-section" aria-labelledby="home-categories-heading">
      <div class="section-heading">
        <h2 id="home-categories-heading">Browse by category</h2>
        <p>Choose a subject when you do not know the tool name.</p>
      </div>
      <nav class="home-category-choices" aria-label="Tool categories">
        {categoriesWithTools.map(category => <a href={`/categories/${category.slug}/`}>{category.name}</a>)}
      </nav>
      <p class="home-library-links">
        <a href="/tools/">Search all {publicToolPageCount} tool URLs</a>
        <a href="/hubs/">Browse task hubs</a>
      </p>
    </section>

    <section class="section-band section-band-soft home-selected-tools" aria-labelledby="home-tools-heading">
      <div class="section-heading">
        <h2 id="home-tools-heading">More tools to start with</h2>
        <p>Quick arithmetic, dates, fractions, tax, and everyday checks.</p>
      </div>
      <div class="tool-grid">{featuredTools.map(tool => <ToolCard tool={tool} />)}</div>
    </section>

    <section class="section-band home-tool-explanations" aria-labelledby="home-help-heading">
      <div class="section-heading">
        <h2 id="home-help-heading">Check what the answer means</h2>
        <p>Useful numbers need context. Read the example, assumptions, and limits before relying on a result.</p>
      </div>
      <div class="home-help-grid">
        <article>
          <h3>Follow an example</h3>
          <p>The {tools.length} matching tool guides explain inputs, formulas, common mistakes, and estimates.</p>
          <a href="/blog/">Find a guide or article</a>
        </article>
        <article>
          <h3>Understand privacy</h3>
          <p>Many tools run in your browser. AI tools explain model downloads and where your work is processed.</p>
          <a href="/privacy-policy/">Read the privacy notes</a>
        </article>
        <article>
          <h3>Learn about the site</h3>
          <p>Access Free Tools is a growing library of practical utilities with plain-language help.</p>
          <a href="/why-access-free-tools/">Why this site exists</a>
          <a href="/free-calculator-resources/">Calculator resources</a>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
