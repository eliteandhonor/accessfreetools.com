---
import BaseLayout from '../../components/BaseLayout.astro';

export const prerender = true;

const pagePath = '/admin/agent-tools/';
const mcpExample = JSON.stringify(
  {
    jsonrpc: '2.0',
    id: 1,
    method: 'tools/call',
    params: {
      name: 'run_tool',
      arguments: {
        slug: 'percentage-calculator',
        inputs: {
          mode: 'percent-of',
          percent: 18,
          value: 240,
        },
      },
    },
  },
  null,
  2,
);
const waitingExample = JSON.stringify({ status: 'waiting' }, null, 2);
---

<BaseLayout
  title="Agent Tools | Access Free Tools"
  description="Private Access Free Tools agent report hub for Ask, API, MCP, SEO, internal links, and content quality."
  path={pagePath}
  noindex
>
  <section class="page-intro agent-tools-hero">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/admin/">Admin</a> / Agent Tools</p>
    <h1>Agent Tools</h1>
    <p>
      Private report hub for checking Ask answers, API-ready tools, MCP calls, internal links,
      SEO evidence, and content quality before agents make claims.
    </p>
  </section>

  <section class="content-section content-section-narrow agent-tools-login" data-agent-login-panel>
    <h2>Private agent login</h2>
    <p>Use the same private analytics token. Reports stay read-only and no public action runs from this page.</p>
    <form class="agent-tools-token-form" method="post" autocomplete="off" data-agent-token-form>
      <label>
        Admin token
        <input type="password" autocomplete="off" required />
      </label>
      <button class="button-primary" type="submit">Open agent tools</button>
    </form>
    <p data-agent-message>Enter the private token to load the latest report evidence.</p>
    <p><a href="/admin/">Back to private tools</a>.</p>
  </section>

  <div class="content-section content-section-narrow">
    <button class="button-secondary" type="button" hidden data-admin-logout>Log out</button>
  </div>

  <section class="section-band agent-tools-panel" hidden data-agent-dashboard>
    <div class="section-heading">
      <h2>Latest reports</h2>
      <p>
        Each card reads saved report evidence. Refresh runs safe report-only checks and does not publish,
        submit indexing, spend paid SEO credits, or edit public pages.
      </p>
    </div>
    <form class="agent-refresh-form" data-agent-refresh-form>
      <label>
        Refresh
        <select name="kind">
          <option value="all">All safe reports</option>
          <option value="ask-audit">Ask Quality Auditor</option>
          <option value="api-ready">API Registry Builder</option>
          <option value="mcp-smoke">MCP Playground Smoke</option>
          <option value="link-helper">Internal Link Helper</option>
          <option value="seo-console">Agent SEO Fix Console</option>
          <option value="content-quality">Content Quality Checker</option>
          <option value="agent-doctor">Agent Doctor</option>
        </select>
      </label>
      <button class="button-primary" type="submit">Refresh reports</button>
      <p data-agent-refresh-message>Safe refresh is ready after login.</p>
    </form>
    <form class="agent-helper-form" data-agent-helper-form>
      <label>
        Helper
        <select name="kind">
          <option value="route">Route task</option>
          <option value="evidence-pack">Evidence pack</option>
          <option value="claim-check">Claim check</option>
          <option value="tool-brief">Tool brief</option>
          <option value="agent-doctor">Agent doctor</option>
        </select>
      </label>
      <label>
        Task
        <input name="task" type="text" value="Improve Wallpaper Calculator indexing and internal links" />
      </label>
      <label>
        Lane
        <input name="lane" type="text" value="seo" />
      </label>
      <label>
        Claim
        <input name="claim" type="text" placeholder="The post is live at https://... and proof is in output/..." />
      </label>
      <label>
        Tool slug
        <input name="slug" type="text" value="percentage-calculator" />
      </label>
      <label class="agent-checkbox">
        <input name="verifyUrls" type="checkbox" />
        Verify public URLs
      </label>
      <button class="button-primary" type="submit">Run helper</button>
      <p data-agent-helper-message>Route, evidence, claim-check, brief, and doctor helpers are read-only.</p>
    </form>
    <div class="agent-tools-grid" data-agent-report-grid>
      <article class="agent-report-card">
        <strong>No reports loaded yet</strong>
        <p>Run <code>npm run aft -- ask-audit</code> or another agent command first.</p>
      </article>
    </div>
  </section>

  <section class="section-band section-band-soft agent-tools-panel" hidden data-agent-dashboard>
    <div class="section-heading">
      <h2>MCP playground</h2>
      <p>Private quick check for the public MCP endpoint. It sends one JSON-RPC request and shows the raw response.</p>
    </div>
    <div class="agent-playground">
      <form data-mcp-form>
        <label>
          MCP request
          <textarea name="payload" rows="10" spellcheck="false">{mcpExample}</textarea>
        </label>
        <button class="button-primary" type="submit">Run MCP check</button>
      </form>
      <pre data-mcp-output>{waitingExample}</pre>
    </div>
  </section>

  <section class="content-section content-section-narrow agent-tools-panel" hidden data-agent-dashboard>
    <h2>CLI commands</h2>
    <ul class="agent-command-list">
      <li><code>npm run aft -- ask-audit</code> checks Ask, REST, MCP, and tool-page availability.</li>
      <li><code>npm run aft -- api-ready</code> ranks future API registry candidates.</li>
      <li><code>npm run aft -- mcp-smoke</code> tests MCP list, search, and run calls.</li>
      <li><code>npm run aft -- link-helper</code> suggests internal links from real evidence.</li>
      <li><code>npm run aft -- seo-console</code> summarizes indexing and SEO next fixes.</li>
      <li><code>npm run aft -- content-score &lt;file&gt;</code> checks drafts for reader quality problems.</li>
      <li><code>npm run aft -- route "&lt;task&gt;"</code> chooses the specialist lane, docs, proof commands, and approval gates.</li>
      <li><code>npm run aft -- claim-check "&lt;claim&gt;" --verify-urls</code> checks proof paths and optionally verifies public URLs.</li>
      <li><code>npm run aft -- tool-brief &lt;slug&gt;</code> summarizes one tool's guide, API, sitemap, art, usage, review, and SEO proof.</li>
      <li><code>npm run aft -- agent-doctor</code> checks the local agent docs and helper command surface.</li>
    </ul>
  </section>

  <style>
    .agent-tools-hero {
      max-width: 980px;
    }

    .agent-tools-login,
    .agent-tools-panel {
      border: 1px solid var(--border);
      box-shadow: var(--soft-shadow);
    }

    .agent-tools-token-form,
    .agent-refresh-form,
    .agent-helper-form,
    .agent-playground form {
      display: grid;
      gap: 1rem;
    }

    .agent-tools-token-form label,
    .agent-refresh-form label,
    .agent-helper-form label,
    .agent-playground label {
      display: grid;
      gap: 0.45rem;
      font-weight: 700;
    }

    .agent-tools-token-form input,
    .agent-refresh-form select,
    .agent-helper-form input,
    .agent-helper-form select,
    .agent-playground textarea {
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font: inherit;
      padding: 0.85rem 1rem;
    }

    .agent-playground textarea,
    .agent-playground pre {
      font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
      font-size: 0.9rem;
      line-height: 1.5;
      overflow: auto;
    }

    .agent-tools-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }

    .agent-refresh-form {
      align-items: end;
      background: var(--surface-solid);
      border: 1px solid var(--border);
      border-radius: 8px;
      grid-template-columns: minmax(220px, 1fr) auto minmax(220px, 1fr);
      margin: 0 0 1rem;
      padding: 1rem;
    }

    .agent-helper-form {
      align-items: end;
      background: var(--surface-solid);
      border: 1px solid var(--border);
      border-radius: 8px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin: 0 0 1rem;
      padding: 1rem;
    }

    .agent-helper-form .agent-checkbox {
      align-items: center;
      display: flex;
      gap: 0.55rem;
    }

    .agent-helper-form .agent-checkbox input {
      height: 1rem;
      width: 1rem;
    }

    .agent-refresh-form p {
      margin: 0;
    }

    .agent-helper-form p {
      margin: 0;
    }

    .agent-report-card {
      background: var(--surface-solid);
      border: 1px solid var(--border);
      border-radius: 8px;
      display: grid;
      gap: 0.65rem;
      padding: 1rem;
    }

    .agent-report-card strong {
      color: var(--text);
      font-size: 1.05rem;
    }

    .agent-report-card p,
    .agent-report-card ul,
    .agent-report-card ol {
      margin: 0;
    }

    .agent-report-details {
      border-top: 1px solid var(--border);
      display: grid;
      gap: 0.8rem;
      padding-top: 0.85rem;
    }

    .agent-report-details h3 {
      font-size: 0.85rem;
      margin: 0 0 0.35rem;
      text-transform: uppercase;
    }

    .agent-report-details ul,
    .agent-report-details ol {
      display: grid;
      gap: 0.4rem;
      padding-left: 1.15rem;
    }

    .agent-report-details li {
      line-height: 1.45;
    }

    .agent-report-empty {
      color: var(--muted);
      font-style: italic;
    }

    .agent-status {
      border-radius: 999px;
      display: inline-flex;
      font-size: 0.8rem;
      font-weight: 800;
      justify-self: start;
      padding: 0.25rem 0.65rem;
      text-transform: uppercase;
    }

    .agent-status-pass {
      background: #dbf7e8;
      color: #12683d;
    }

    .agent-status-attention,
    .agent-status-not-run {
      background: #fff3cd;
      color: #7a4d00;
    }

    .agent-status-fail {
      background: #fde2e2;
      color: #a52525;
    }

    .agent-playground {
      display: grid;
      gap: 1rem;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .agent-playground pre {
      background: #102a2d;
      border-radius: 8px;
      color: #e9fff7;
      margin: 0;
      min-height: 18rem;
      padding: 1rem;
      white-space: pre-wrap;
    }

    .agent-command-list {
      display: grid;
      gap: 0.65rem;
      padding-left: 1.2rem;
    }

    @media (max-width: 760px) {
      .agent-playground {
        grid-template-columns: 1fr;
      }

      .agent-refresh-form {
        grid-template-columns: 1fr;
      }

      .agent-helper-form {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const loginPanel = document.querySelector('[data-agent-login-panel]');
      const tokenForm = document.querySelector('[data-agent-token-form]');
      const tokenInput = tokenForm?.querySelector('input[type="password"]');
      const logoutButton = document.querySelector('[data-admin-logout]');
      const message = document.querySelector('[data-agent-message]');
      const dashboards = document.querySelectorAll('[data-agent-dashboard]');
      const reportGrid = document.querySelector('[data-agent-report-grid]');
      const refreshForm = document.querySelector('[data-agent-refresh-form]');
      const refreshMessage = document.querySelector('[data-agent-refresh-message]');
      const helperForm = document.querySelector('[data-agent-helper-form]');
      const helperMessage = document.querySelector('[data-agent-helper-message]');
      const mcpForm = document.querySelector('[data-mcp-form]');
      const mcpOutput = document.querySelector('[data-mcp-output]');

      const reportLabels = {
        'agent-doctor': 'Agent Doctor',
        'api-ready': 'API Registry Builder',
        'ask-audit': 'Ask Quality Auditor',
        'claim-check': 'Claim Check',
        'content-quality': 'Content Quality Checker',
        'evidence-pack': 'Evidence Pack',
        'link-helper': 'Internal Link Helper',
        'mcp-smoke': 'MCP Playground Smoke',
        route: 'Agent Route',
        'seo-console': 'Agent SEO Fix Console',
        'tool-brief': 'Tool Brief',
      };

      const escapeHtml = (value) =>
        String(value ?? '').replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[char]);

      const setMessage = (value) => {
        if (message) message.textContent = value;
      };

      const setRefreshMessage = (value) => {
        if (refreshMessage) refreshMessage.textContent = value;
      };

      const setHelperMessage = (value) => {
        if (helperMessage) helperMessage.textContent = value;
      };

      // This credential belongs only to this page's workflow, never a shared browser session.
      let activeToken = '';
      let workflow;
      const resetAccess = () => {
        activeToken = '';
        workflow?.abort();
        workflow = undefined;
        if (tokenInput) tokenInput.value = '';
        if (logoutButton) logoutButton.hidden = true;
        if (loginPanel) loginPanel.hidden = false;
        dashboards.forEach((section) => { section.hidden = true; });
        if (reportGrid) reportGrid.textContent = '';
        if (mcpOutput) mcpOutput.textContent = '';
        helperForm?.reset();
        mcpForm?.reset();
        setRefreshMessage('Safe refresh is ready after login.');
        setHelperMessage('Enter the private token to run a helper.');
        setMessage('Enter the private token to load the latest report evidence.');
        for (const storage of ['localStorage', 'sessionStorage']) {
          try { window[storage].removeItem('access-free-tools-analytics-token'); } catch {}
        }
      };
      resetAccess();
      logoutButton?.addEventListener('click', resetAccess);
      window.addEventListener('pagehide', resetAccess);
      window.addEventListener('pageshow', (event) => { if (event.persisted) resetAccess(); });

      const showDashboard = () => {
        dashboards.forEach((section) => {
          section.hidden = false;
        });
        if (loginPanel) loginPanel.hidden = true;
      };

      const summaryText = (entry) => {
        const report = entry.report || {};
        if (!report) return 'No report has been generated yet.';
        if (report.summary) {
          return Object.entries(report.summary)
            .slice(0, 4)
            .map(([key, value]) => `${key}: ${value}`)
            .join(' | ');
        }
        if (Array.isArray(report.actions)) return `${report.actions.length} recommended actions`;
        if (Array.isArray(report.suggestions)) return `${report.suggestions.length} internal link suggestions`;
        return 'Report loaded.';
      };

      const asArray = (value) => (Array.isArray(value) ? value : []);

      const humanizeKey = (value) =>
        String(value || '')
          .replace(/([a-z])([A-Z])/g, '$1 $2')
          .replace(/[-_]/g, ' ')
          .replace(/\b\w/g, (char) => char.toUpperCase());

      const valueText = (value) => {
        if (value === null || value === undefined || value === '') return '';
        if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') return String(value);
        if (typeof value === 'object') {
          const parts = Object.entries(value)
            .filter(([, item]) => item !== null && item !== undefined && item !== '')
            .slice(0, 5)
            .map(([key, item]) => `${humanizeKey(key)}: ${valueText(item)}`);
          return parts.join(' | ');
        }
        return String(value);
      };

      const renderList = (title, items, formatter = valueText, ordered = false) => {
        const safeItems = asArray(items).filter((item) => valueText(item));
        if (!safeItems.length) return '';
        const tag = ordered ? 'ol' : 'ul';
        return `
          <div>
            <h3>${escapeHtml(title)}</h3>
            <${tag}>
              ${safeItems.map((item) => `<li>${escapeHtml(formatter(item))}</li>`).join('')}
            </${tag}>
          </div>
        `;
      };

      const renderNotes = (report) =>
        renderList('Notes', report.notes, (item) => String(item).replace(/^not enough data:\s*/i, 'Context note: '));

      const renderIssues = (report) =>
        renderList('Issues', report.issues, (item) => item, false) ||
        '<div><h3>Issues</h3><p class="agent-report-empty">No issues found.</p></div>';

      const renderWarnings = (report) =>
        renderList('Warnings', report.warnings, (item) => item, false) ||
        '<div><h3>Warnings</h3><p class="agent-report-empty">No warnings.</p></div>';

      const renderActions = (report) =>
        renderList(
          'Recommended actions',
          report.actions,
          (item) => `${item.priority ? `${item.priority}: ` : ''}${item.task || item.title || valueText(item)}${item.target ? ` (${item.target})` : ''}`,
          true,
        );

      const renderSuggestions = (report) =>
        renderList(
          'Internal link suggestions',
          report.suggestions,
          (item) => `${item.priority ? `${item.priority}: ` : ''}${item.source && item.target ? `${item.source} -> ${item.target}` : item.target || item.anchorIdea || valueText(item)}${item.why ? ` - ${item.why}` : item.reason ? ` - ${item.reason}` : ''}`,
          true,
        );

      const renderCheckedLinks = (report) =>
        renderList(
          'Checked links',
          report.checkedLinks,
          (item) => {
            const state = item.present === true ? 'present' : item.present === false ? 'missing' : 'not checked';
            return `${state}: ${item.source} -> ${item.target}`;
          },
        );

      const renderAskResults = (report) =>
        renderList(
          'Ask/API parity cases',
          report.results,
          (item) => `${item.slug}: Ask "${item.askAnswer}" | Runner "${item.runAnswer}"`,
          true,
        );

      const renderApiCandidates = (report) =>
        renderList(
          'Recommended next API tools',
          asArray(report.recommendedNext).slice(0, 6),
          (item) => `${item.name || item.slug} - score ${item.score ?? 'n/a'}, risk ${item.risk ?? 'unknown'}`,
          true,
        );

      const renderMcpChecks = (report) =>
        renderList(
          'MCP checks',
          report.checks,
          (item) => `${item.ok ? 'pass' : 'fail'}: ${item.label} (status ${item.status})`,
        );

      const renderCommands = (report) => renderList('Commands', report.commands, (item) => item);

      const renderDocs = (report) => renderList('Docs', report.docs, (item) => item.path || item);

      const renderSources = (report) =>
        renderList(
          'Sources',
          report.sources || report.sourceStatuses,
          (item) => `${item.present === true ? 'present' : item.status || 'not enough data'}: ${item.path}`,
        );

      const renderProofEvidence = (report) =>
        renderList(
          'Proof evidence',
          [
            ...asArray(report.evidence?.publicUrls).map((url) => ({ label: `URL: ${url}` })),
            ...asArray(report.evidence?.outputPathChecks).map((item) => ({
              label: `${item.exists ? 'present' : 'missing'}: ${item.path}`,
            })),
          ],
          (item) => item.label,
        );

      const renderToolBrief = (report) =>
        renderList(
          'Tool brief',
          [
            report.tool?.name ? `Tool: ${report.tool.name}` : '',
            report.guide ? `Guide: ${report.guide.exists ? 'present' : 'missing'}` : '',
            report.api ? `API-ready: ${report.api.ready ? 'yes' : 'no'}` : '',
            report.deepReview ? `Deep review: ${report.deepReview.status}` : '',
            report.searchConsole ? `Search Console: ${report.searchConsole.status}` : '',
            report.analytics ? `Usage: ${report.analytics.status}` : '',
          ],
          (item) => item,
        );

      const detailHtml = (entry) => {
        const report = entry.report || {};
        const blocks = [
          renderIssues(report),
          renderWarnings(report),
          renderNotes(report),
          renderActions(report),
          renderSuggestions(report),
          renderCheckedLinks(report),
          renderAskResults(report),
          renderApiCandidates(report),
          renderMcpChecks(report),
          renderCommands(report),
          renderDocs(report),
          renderSources(report),
          renderProofEvidence(report),
          renderToolBrief(report),
        ].filter(Boolean);

        return blocks.length
          ? `<div class="agent-report-details">${blocks.join('')}</div>`
          : '<div class="agent-report-details"><p class="agent-report-empty">No readable report details yet.</p></div>';
      };

      const renderReports = (reports) => {
        if (!reportGrid) return;
        reportGrid.innerHTML = reports
          .map((entry) => {
            const status = String(entry.status || 'not-run');
            return `
              <article class="agent-report-card">
                <span class="agent-status agent-status-${escapeHtml(status)}">${escapeHtml(status)}</span>
                <strong>${escapeHtml(reportLabels[entry.kind] || entry.kind)}</strong>
                <p>${escapeHtml(summaryText(entry))}</p>
                <p>${entry.updatedAt ? `Updated ${escapeHtml(new Date(entry.updatedAt).toLocaleString())}` : 'Not generated yet'}</p>
                ${detailHtml(entry)}
                ${entry.markdownPath ? `<p><code>${escapeHtml(entry.markdownPath)}</code></p>` : ''}
              </article>
            `;
          })
          .join('');
      };

      const loadReports = async (token) => {
        resetAccess();
        if (!token) return;
        const controller = new AbortController();
        workflow = controller;
        activeToken = token;
        token = '';
        if (logoutButton) logoutButton.hidden = false;
        setMessage('Loading agent reports...');

        try {
          const response = await fetch('/api/admin/agent-tools', {
            cache: 'no-store',
            credentials: 'omit',
            redirect: 'error',
            signal: controller.signal,
            headers: {
              accept: 'application/json',
              'x-aft-analytics-token': activeToken,
            },
          });
          const body = await response.json().catch(() => ({}));
          if (controller.signal.aborted) return;

          if (!response.ok || !body.ok) {
            resetAccess();
            setMessage('Admin token was not accepted. Enter it again to retry.');
            return;
          }

          showDashboard();
          renderReports(body.reports || []);
          setRefreshMessage('Safe refresh is ready.');
          setHelperMessage('Helpers are ready.');
        } catch {
          if (controller.signal.aborted) return;
          resetAccess();
          setMessage('Agent reports could not be loaded. Enter the token again to retry.');
        }
      };

      const refreshReports = async (kind) => {
        const controller = workflow;
        if (!activeToken || !controller || controller.signal.aborted) return;
        setRefreshMessage('Refreshing safe reports...');

        try {
          const response = await fetch('/api/admin/agent-tools', {
            cache: 'no-store',
            credentials: 'omit',
            redirect: 'error',
            signal: controller.signal,
            body: JSON.stringify({ kind }),
            headers: {
              accept: 'application/json',
              'content-type': 'application/json',
              'x-aft-analytics-token': activeToken,
            },
            method: 'POST',
          });
          const body = await response.json().catch(() => ({}));
          if (controller.signal.aborted) return;
          if (response.status === 401 || response.status === 403) {
            resetAccess();
            setMessage('Admin token was not accepted. Enter it again to retry.');
            return;
          }

          if (!response.ok || !body.ok) {
            setRefreshMessage(body.message || 'Refresh was not accepted.');
            return;
          }

          renderReports(body.reports || []);
          setRefreshMessage(`Refreshed ${Array.isArray(body.refreshed) ? body.refreshed.length : 0} report(s).`);
        } catch {
          if (controller.signal.aborted) return;
          setRefreshMessage('Refresh endpoint is not available yet. Check the Node deployment.');
        }
      };

      const runHelper = async (payload) => {
        const controller = workflow;
        if (!activeToken || !controller || controller.signal.aborted) return;
        setHelperMessage('Running helper...');

        try {
          const response = await fetch('/api/admin/agent-tools', {
            cache: 'no-store',
            credentials: 'omit',
            redirect: 'error',
            signal: controller.signal,
            body: JSON.stringify(payload),
            headers: {
              accept: 'application/json',
              'content-type': 'application/json',
              'x-aft-analytics-token': activeToken,
            },
            method: 'POST',
          });
          const body = await response.json().catch(() => ({}));
          if (controller.signal.aborted) return;
          if (response.status === 401 || response.status === 403) {
            resetAccess();
            setMessage('Admin token was not accepted. Enter it again to retry.');
            return;
          }

          if (!response.ok || !body.ok) {
            setHelperMessage(body.message || 'Helper run was not accepted.');
            return;
          }

          renderReports(body.reports || []);
          setHelperMessage(`Updated ${Array.isArray(body.refreshed) ? body.refreshed.length : 0} helper report(s).`);
        } catch {
          if (controller.signal.aborted) return;
          setHelperMessage('Helper endpoint is not available yet. Check the Node deployment.');
        }
      };

      if (tokenForm) {
        tokenForm.addEventListener('submit', (event) => {
          event.preventDefault();
          loadReports(tokenInput?.value || '');
        });
      }

      if (refreshForm) {
        refreshForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = new FormData(refreshForm);
          refreshReports(String(data.get('kind') || 'all'));
        });
      }

      if (helperForm) {
        helperForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = new FormData(helperForm);
          runHelper({
            claim: String(data.get('claim') || ''),
            kind: String(data.get('kind') || 'route'),
            lane: String(data.get('lane') || ''),
            slug: String(data.get('slug') || ''),
            task: String(data.get('task') || ''),
            verifyUrls: data.get('verifyUrls') === 'on',
          });
        });
      }

      if (mcpForm) {
        mcpForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          const controller = workflow;
          if (!mcpOutput || !activeToken || !controller || controller.signal.aborted) return;

          try {
            const data = new FormData(mcpForm);
            const payload = JSON.parse(String(data.get('payload') || '{}'));
            mcpOutput.textContent = 'Running...';
            const response = await fetch('/mcp', {
              cache: 'no-store',
              credentials: 'omit',
              redirect: 'error',
              signal: controller.signal,
              body: JSON.stringify(payload),
              headers: {
                accept: 'application/json, text/event-stream',
                'content-type': 'application/json',
              },
              method: 'POST',
            });
            const body = await response.json().catch(async () => ({ raw: await response.text() }));
            if (controller.signal.aborted) return;
            mcpOutput.textContent = JSON.stringify(body, null, 2);
          } catch (error) {
            if (controller.signal.aborted) return;
            mcpOutput.textContent = JSON.stringify(
              { error: error instanceof Error ? error.message : 'MCP request failed' },
              null,
              2,
            );
          }
        });
      }
    })();
  </script>
</BaseLayout>
