---
import BaseLayout from '../../components/BaseLayout.astro';

export const prerender = true;

const pagePath = '/admin/';
---

<BaseLayout
  title="Private Admin | Access Free Tools"
  description="Private Access Free Tools admin entry page for analytics and agent tools."
  path={pagePath}
  noindex
>
  <section class="page-intro admin-login-hero">
    <p class="breadcrumb"><a href="/">Home</a> / Admin</p>
    <h1>Private Admin</h1>
    <p>Private analytics and agent reports.</p>
  </section>

  <section class="section-band admin-destination-panel" data-admin-destinations>
    <div class="section-heading">
      <h2>Open private tools</h2>
    </div>
    <div class="admin-destination-grid">
      <article>
        <span>Usage</span>
        <h3>Analytics</h3>
        <p>See anonymous page views, tool uses, referrers, active visitors, and recent activity.</p>
        <a class="button-primary" href="/admin/analytics/" data-admin-link>Open Analytics</a>
      </article>
      <article>
        <span>Agent QA</span>
        <h3>Agent Tools</h3>
        <p>Review Ask/API/MCP parity, API-ready tools, SEO evidence, link ideas, and content checks.</p>
        <a class="button-primary" href="/admin/agent-tools/" data-admin-link>Open Agent Tools</a>
      </article>
      <article>
        <span>Privacy</span>
        <h3>Owner Browser</h3>
        <p>Exclude this browser from analytics.</p>
        <div class="admin-action-stack">
          <button class="button-secondary" type="button" data-admin-opt-out>Exclude this browser</button>
        </div>
        <p role="status" data-admin-message></p>
      </article>
    </div>
  </section>

  <style>
    .admin-login-hero {
      max-width: 960px;
    }

    .admin-destination-panel {
      border: 1px solid var(--border);
      box-shadow: var(--soft-shadow);
    }

    .admin-destination-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .admin-destination-grid article {
      background: var(--surface-solid);
      border: 1px solid var(--border);
      border-radius: 8px;
      display: grid;
      gap: 0.7rem;
      padding: 1rem;
    }

    .admin-destination-grid span {
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .admin-destination-grid h3 {
      margin: 0;
    }

    .admin-action-stack {
      display: grid;
      gap: 0.7rem;
    }

    @media (max-width: 860px) {
      .admin-destination-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const optOutKey = 'access-free-tools-analytics-opt-out';
      const message = document.querySelector('[data-admin-message]');
      const optOutButton = document.querySelector('[data-admin-opt-out]');

      const setMessage = (value) => {
        if (message) message.textContent = value;
      };

      const removeLegacyToken = () => {
        for (const storage of ['localStorage', 'sessionStorage']) {
          try { window[storage].removeItem('access-free-tools-analytics-token'); } catch {}
        }
      };
      removeLegacyToken();
      window.addEventListener('pageshow', removeLegacyToken);

      if (optOutButton) {
        optOutButton.addEventListener('click', () => {
          try {
            window.localStorage.setItem(optOutKey, 'true');
            setMessage('This browser is now excluded from Access Free Tools analytics.');
          } catch {
            setMessage('Browser storage is unavailable. The analytics preference was not saved.');
          }
        });
      }
    })();
  </script>
</BaseLayout>
