---
import BaseLayout from '../../components/BaseLayout.astro';

export const prerender = true;

const optOutKey = 'access-free-tools-analytics-opt-out';
const pagePath = Astro.props.path ?? '/admin/analytics/';
---

<BaseLayout
  title="Private Analytics | Access Free Tools"
  description="Private Access Free Tools analytics dashboard for anonymous page and tool usage."
  path={pagePath}
  noindex
>
  <section class="page-intro analytics-admin-hero">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/admin/">Admin</a> / Analytics</p>
    <h1>Private Analytics</h1>
    <p>
      Simple first-party stats for real page views and tool actions. Hostinger hPanel still helps
      with server logs, bot crawls, and error checks.
    </p>
  </section>

  <section class="content-section content-section-narrow analytics-panel" data-analytics-login-panel>
    <h2>Private analytics login</h2>
    <p>
      Hostinger is set up. This page still asks for your private analytics password so only you can
      see the usage stats.
    </p>
    <form class="analytics-login-form" data-analytics-token-form>
      <label>
        Analytics token
        <input type="password" name="token" autocomplete="current-password" required />
      </label>
      <button class="button-primary" type="submit">Open analytics</button>
    </form>
    <p class="analytics-opt-out-status" data-analytics-message>
      Enter the token from your private local config file or use the admin hub shortcut.
    </p>
    <p><a href="/admin/">Use the easier private admin login page</a>.</p>
  </section>

  <section class="section-band analytics-panel" hidden data-analytics-dashboard>
    <div class="section-heading">
      <h2>Today</h2>
      <p>
        Counts use anonymous browser events and skip obvious bots, admin pages, API routes, and
        browsers that opted out.
      </p>
    </div>
    <div class="analytics-metric-grid">
      <article>
        <span>Active now</span>
        <strong data-metric="activeVisitors">0</strong>
        <p>Visitors seen in the last 10 minutes.</p>
      </article>
      <article>
        <span>Visitors today</span>
        <strong data-metric="todayVisitors">0</strong>
        <p><span data-metric="todayNewVisitors">0</span> new, <span data-metric="todayReturningVisitors">0</span> returning.</p>
      </article>
      <article>
        <span>Tool uses today</span>
        <strong data-metric="todayToolActions">0</strong>
        <p>Calculate, generate, copy, convert, and similar actions.</p>
      </article>
      <article>
        <span>Page views today</span>
        <strong data-metric="todayPageViews">0</strong>
        <p>Human browser page-view events.</p>
      </article>
    </div>
  </section>

  <section class="section-band section-band-soft analytics-panel" hidden data-analytics-dashboard>
    <div class="section-heading">
      <h2>Most used tools</h2>
      <p>Top tool actions from the selected reporting window.</p>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table">
        <thead>
          <tr>
            <th>Tool</th>
            <th>Uses</th>
            <th>Open</th>
          </tr>
        </thead>
        <tbody data-top-tools>
          <tr><td colspan="3">No tool actions have been recorded yet.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section-band analytics-panel analytics-two-column" hidden data-analytics-dashboard>
    <div>
      <div class="section-heading">
        <h2>Top pages</h2>
        <p>Page views from the selected reporting window.</p>
      </div>
      <ol class="analytics-ranked-list" data-top-pages>
        <li><span>No page views yet</span><span>0</span></li>
      </ol>
    </div>
    <div>
      <div class="section-heading">
        <h2>Referrers</h2>
        <p>External sites sending visitors.</p>
      </div>
      <ol class="analytics-ranked-list" data-top-referrers>
        <li><span>No external referrers yet</span><span>0</span></li>
      </ol>
    </div>
  </section>

  <section class="section-band section-band-soft analytics-panel" hidden data-analytics-dashboard>
    <div class="section-heading">
      <h2>Recent activity</h2>
      <p data-generated-at>Latest anonymous page and tool events.</p>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Event</th>
            <th>Page or tool</th>
            <th>Device</th>
          </tr>
        </thead>
        <tbody data-recent-events>
          <tr><td colspan="4">No recent events yet.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="content-section content-section-narrow analytics-panel" hidden data-analytics-dashboard>
    <h2>Do not count my browser</h2>
    <p>
      Use this on your own devices. It saves a local browser flag, so it does not affect other
      real visitors.
    </p>
    <div class="analytics-opt-out-actions">
      <button class="button-primary" type="button" data-analytics-opt-out="true">Exclude this browser</button>
      <button class="button-secondary" type="button" data-analytics-opt-out="false">Count this browser again</button>
    </div>
    <p class="analytics-opt-out-status" data-analytics-opt-out-status>Checking this browser...</p>
  </section>

  <script is:inline define:vars={{ optOutKey }}>
    (() => {
      const tokenStorageKey = 'access-free-tools-analytics-token';
      const loginPanel = document.querySelector('[data-analytics-login-panel]');
      const tokenForm = document.querySelector('[data-analytics-token-form]');
      const message = document.querySelector('[data-analytics-message]');
      const dashboards = document.querySelectorAll('[data-analytics-dashboard]');
      const numberFormat = new Intl.NumberFormat('en');
      const dateFormat = new Intl.DateTimeFormat('en-AU', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'Australia/Brisbane',
      });

      const text = (selector, value) => {
        const element = document.querySelector(selector);
        if (element) element.textContent = value;
      };

      const setMetric = (name, value) => {
        text(`[data-metric="${name}"]`, numberFormat.format(Number(value || 0)));
      };

      const setRows = (selector, rows, emptyRow) => {
        const target = document.querySelector(selector);
        if (!target) return;
        target.innerHTML = rows.length > 0 ? rows.join('') : emptyRow;
      };

      const escapeHtml = (value) =>
        String(value ?? '').replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[char]);

      const showMessage = (value) => {
        if (message) message.textContent = value;
      };

      const renderSummary = (summary) => {
        dashboards.forEach((section) => {
          section.hidden = false;
        });
        if (loginPanel) loginPanel.hidden = true;

        setMetric('activeVisitors', summary.activeVisitors);
        setMetric('todayVisitors', summary.today?.visitors);
        setMetric('todayNewVisitors', summary.today?.newVisitors);
        setMetric('todayReturningVisitors', summary.today?.returningVisitors);
        setMetric('todayToolActions', summary.today?.toolActions);
        setMetric('todayPageViews', summary.today?.pageViews);

        setRows(
          '[data-top-tools]',
          (summary.topTools || []).map((item) => `
            <tr>
              <td>${escapeHtml(item.label)}</td>
              <td>${numberFormat.format(Number(item.count || 0))}</td>
              <td><a href="${escapeHtml(item.path)}">View tool</a></td>
            </tr>
          `),
          '<tr><td colspan="3">No tool actions have been recorded yet.</td></tr>',
        );

        setRows(
          '[data-top-pages]',
          (summary.topPages || []).slice(0, 10).map((item) => `
            <li>
              <a href="${escapeHtml(item.path)}">${escapeHtml(item.label)}</a>
              <span>${numberFormat.format(Number(item.count || 0))}</span>
            </li>
          `),
          '<li><span>No page views yet</span><span>0</span></li>',
        );

        setRows(
          '[data-top-referrers]',
          (summary.topReferrers || []).slice(0, 10).map((item) => `
            <li>
              <span>${escapeHtml(item.label)}</span>
              <span>${numberFormat.format(Number(item.count || 0))}</span>
            </li>
          `),
          '<li><span>No external referrers yet</span><span>0</span></li>',
        );

        setRows(
          '[data-recent-events]',
          (summary.recentEvents || []).slice(0, 15).map((event) => `
            <tr>
              <td>${escapeHtml(dateFormat.format(new Date(event.ts)))}</td>
              <td>${escapeHtml(event.type === 'tool_action' ? event.action || 'Tool action' : 'Page view')}</td>
              <td><a href="${escapeHtml(event.pagePath)}">${escapeHtml(event.toolName || event.pageTitle || event.pagePath)}</a></td>
              <td>${escapeHtml(`${event.device || 'unknown'} / ${event.browser || 'unknown'}`)}</td>
            </tr>
          `),
          '<tr><td colspan="4">No recent events yet.</td></tr>',
        );

        text(
          '[data-generated-at]',
          `Latest anonymous page and tool events. Generated ${dateFormat.format(new Date(summary.generatedAt))}.`,
        );
      };

      const loadSummary = async (token) => {
        if (!token) return;

        showMessage('Loading analytics...');
        try {
          const response = await fetch('/api/analytics/events', {
            headers: {
              'accept': 'application/json',
              'x-aft-analytics-token': token,
            },
          });
          const body = await response.json().catch(() => ({}));

          if (!response.ok || !body.summary) {
            showMessage(body.message || 'Analytics token was not accepted. Use the admin hub or enter the saved token.');
            return;
          }

          window.sessionStorage.setItem(tokenStorageKey, token);
          renderSummary(body.summary);
        } catch {
          showMessage('Analytics endpoint is not available yet. Check Hostinger PHP/Node deployment settings.');
        }
      };

      const storedToken = window.sessionStorage.getItem(tokenStorageKey) || '';
      loadSummary(storedToken);

      if (tokenForm) {
        tokenForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = new FormData(tokenForm);
          loadSummary(String(data.get('token') || ''));
        });
      }

      const optOutStatus = document.querySelector('[data-analytics-opt-out-status]');
      const updateStatus = () => {
        const isOptedOut = window.localStorage.getItem(optOutKey) === 'true';
        if (optOutStatus) {
          optOutStatus.textContent = isOptedOut
            ? 'This browser is excluded from Access Free Tools analytics.'
            : 'This browser is currently counted unless your IP is excluded on the server.';
        }
      };

      document.querySelectorAll('[data-analytics-opt-out]').forEach((button) => {
        button.addEventListener('click', () => {
          if (button.getAttribute('data-analytics-opt-out') === 'true') {
            window.localStorage.setItem(optOutKey, 'true');
          } else {
            window.localStorage.removeItem(optOutKey);
          }
          updateStatus();
        });
      });

      updateStatus();
    })();
  </script>
</BaseLayout>
