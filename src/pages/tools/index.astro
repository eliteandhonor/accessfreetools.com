---
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import ToolsLaunchpad from '../../components/ToolsLaunchpad';
import { categories } from '../../data/categories';
import { toolAliases } from '../../data/toolAliases';
import { tools } from '../../data/tools';

const searchTools = tools.map((tool) => ({
  slug: tool.slug,
  name: tool.name,
  category: tool.category,
  summary: tool.summary,
  icon: tool.icon,
  searchText: [
    tool.name,
    tool.summary,
    tool.description,
    tool.category,
    ...(tool.aliases ?? []),
    ...toolAliases
      .filter((alias) => alias.targetSlug === tool.slug)
      .flatMap((alias) => [alias.name, alias.description, ...alias.searchTerms]),
    ...tool.useCases,
    ...tool.examples.map((example) => example.label),
  ].join(' '),
}));
---

<BaseLayout
  title="All Free Tools | Access Free Tools"
  description="Browse free calculators, converters, text tools, and everyday browser utilities from Access Free Tools."
  path="/tools/"
>
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Tools', path: '/tools/' },
    ]}
  />
  <CollectionStructuredData
    name="All Free Tools"
    description="Browse free calculators and browser utilities from Access Free Tools."
    path="/tools/"
    items={tools.map((tool) => ({
      name: tool.name,
      path: `/tools/${tool.slug}/`,
      description: tool.summary,
    }))}
  />
  <ToolsLaunchpad categories={categories} tools={searchTools} client:load />
</BaseLayout>
