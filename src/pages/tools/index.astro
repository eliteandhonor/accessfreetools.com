---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import ToolsLaunchpad from '../../components/ToolsLaunchpad';
import { categories } from '../../data/categories';
import { getToolSearchIndex } from '../../data/toolSearchIndex';
import { TOOL_PAGE_SIZE, toolMatchesDiscoveryCategory } from '../../lib/toolDiscovery';
import '../../styles/tool-discovery.css';

const searchTools = getToolSearchIndex();
const initialSearchTools = searchTools.slice(0, TOOL_PAGE_SIZE).map(({ slug, name, category, summary, icon }) => ({
  slug,
  name,
  category,
  summary,
  icon,
  searchText: [name, summary, category].join(' '),
}));
const toolsByInitial = Array.from(
  [...searchTools]
    .sort((a, b) => a.name.localeCompare(b.name))
    .reduce((groups, tool) => {
      const letter = /^[a-z]/i.test(tool.name) ? tool.name[0].toUpperCase() : '#';
      const currentGroup = groups.get(letter) ?? [];
      currentGroup.push(tool);
      groups.set(letter, currentGroup);
      return groups;
    }, new Map<string, typeof searchTools>()),
  ([letter, groupedTools]) => ({ letter, tools: groupedTools }),
);
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    searchTools.filter((tool) => toolMatchesDiscoveryCategory(tool, category.slug)).length,
  ]),
);

---

<BaseLayout
  title="Free Online Calculators and Tools | Access Free Tools"
  description="Browse free online calculators, converters, AI browser tools, text tools, guides, and everyday utilities from Access Free Tools."
  path="/tools/"
>
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Tools', path: '/tools/' },
    ]}
  />
  <CollectionStructuredData
    name="Free Online Calculators and Tools"
    description="Browse free online calculators, converters, AI browser tools, text tools, and everyday browser utilities from Access Free Tools."
    path="/tools/"
    maxItems={100}
    items={searchTools.map((tool) => ({
      name: tool.name,
      path: `/tools/${tool.slug}/`,
      description: tool.summary,
    }))}
  />
  <ToolsLaunchpad
    categories={categories}
    categoryCounts={categoryCounts}
    searchIndexUrl="/tool-search-index.json"
    tools={initialSearchTools}
    totalToolCount={searchTools.length}
    client:load
  />

  <nav class="tools-directory-help" aria-label="More ways to find a tool">
    <a href="/categories/">Browse category guides</a>
    <a href="/hubs/">Explore tools by task</a>
    <a href="/blog/">Read examples and instructions</a>
  </nav>

  <details class="tools-directory-inventory">
    <summary id="tools-az-heading">Browse every tool by name: A–Z ({searchTools.length} links)</summary>
    <p>All public tool pages, including alternate names for the same calculator or utility.</p>
    <div class="tools-az-grid">
      {toolsByInitial.map((group) => (
        <section class="tools-az-group" aria-labelledby={`tools-az-${group.letter}`}>
          <h3 id={`tools-az-${group.letter}`}>{group.letter}</h3>
          <ul>
            {group.tools.map((tool) => (
              <li>
                <a href={`/tools/${tool.slug}/`}>{tool.name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </details>
</BaseLayout>
