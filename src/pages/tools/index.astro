---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import ToolsLaunchpad from '../../components/ToolsLaunchpad';
import { categories } from '../../data/categories';
import { getToolSearchIndex } from '../../data/toolSearchIndex';
import { tools } from '../../data/tools';

const searchTools = getToolSearchIndex();
const initialSearchTools = searchTools.slice(0, 96);
const toolsByInitial = Array.from(
  [...searchTools]
    .sort((a, b) => a.name.localeCompare(b.name))
    .reduce((groups, tool) => {
      const letter = /^[a-z]/i.test(tool.name) ? tool.name[0].toUpperCase() : '#';
      const currentGroup = groups.get(letter) ?? [];
      currentGroup.push(tool);
      groups.set(letter, currentGroup);
      return groups;
    }, new Map<string, typeof searchTools>()),
  ([letter, groupedTools]) => ({ letter, tools: groupedTools }),
);
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    searchTools.filter((tool) => tool.category === category.slug).length,
  ]),
);
const discoveryHubs = [
  {
    href: '/categories/calculators/',
    title: 'Free online calculators',
    text: 'Start with basic math, percentages, fractions, statistics, geometry, and number calculators.',
  },
  {
    href: '/categories/finance/',
    title: 'Finance calculators',
    text: 'Estimate payments, mortgage costs, interest, taxes, salary, inflation, and investment numbers.',
  },
  {
    href: '/categories/health-fitness/',
    title: 'Health and fitness calculators',
    text: 'Use educational BMI, calorie, pregnancy, nutrition, pace, and body-measurement estimates with clear limits.',
  },
  {
    href: '/categories/home-projects/',
    title: 'Home project calculators',
    text: 'Plan concrete, wallpaper, paint, rebar, roofing, sand, electrical, and material estimates.',
  },
  {
    href: '/categories/ai-tools/',
    title: 'Browser AI tools',
    text: 'Try OCR, language detection, reading level, tone, keywords, and other browser-side helpers.',
  },
  {
    href: '/categories/developer-tools/',
    title: 'Developer tools',
    text: 'Run subnet, password, JSON, URL, UTM, token, and formatting helpers without opening a heavy app.',
  },
];
const warmToolLinks = [
  {
    href: '/tools/basic-calculator/',
    title: 'Basic calculator online free',
    text: 'A simple calculator for everyday arithmetic, keyboard input, and quick result checks.',
  },
  {
    href: '/tools/percentage-calculator/',
    title: 'Percentage calculator',
    text: 'Work out discounts, tips, markups, percent change, and reverse percentages.',
  },
  {
    href: '/tools/tip-calculator/',
    title: 'Tip calculator',
    text: 'Split tips, check totals, and compare common tip percentages without guessing.',
  },
  {
    href: '/tools/mortgage-calculator/',
    title: 'Mortgage calculator',
    text: 'Estimate monthly payment, interest, taxes, insurance, PMI, HOA, and loan balance assumptions.',
  },
  {
    href: '/tools/loan-calculator/',
    title: 'Loan calculator',
    text: 'Compare loan payment, total interest, term length, and rate scenarios before trusting a quote.',
  },
  {
    href: '/tools/bmi-calculator/',
    title: 'BMI calculator',
    text: 'Check the BMI formula, category result, and why it is only a screening estimate.',
  },
  {
    href: '/tools/calorie-calculator/',
    title: 'Calorie calculator',
    text: 'Estimate daily calories from age, body size, activity, and goal assumptions with health limits.',
  },
  {
    href: '/tools/image-to-text-ocr-tool/',
    title: 'Image to text OCR',
    text: 'Extract text from screenshots or images in the browser and learn what OCR can miss.',
  },
  {
    href: '/tools/watts-to-amps-calculator/',
    title: 'Watts to amps calculator',
    text: 'Convert watts, volts, phase, and power factor into an amps estimate with electrical safety limits.',
  },
  {
    href: '/tools/wallpaper-calculator/',
    title: 'Wallpaper calculator',
    text: 'Estimate rolls from room size, openings, roll coverage, pattern repeat, and waste percent.',
  },
  {
    href: '/tools/prompt-token-estimator/',
    title: 'Prompt token estimator',
    text: 'Estimate prompt tokens from text length, then check why exact tokenizer counts can vary by model.',
  },
];
const guideEntryLinks = [
  {
    href: '/blog/',
    title: 'All calculator and utility guides',
    text: 'Search every guide when you need examples, formulas, input explanations, and result limits.',
  },
  {
    href: '/blog/how-to-use-ad-revenue-calculator/',
    title: 'Ad revenue calculator guide',
    text: 'Learn pageviews, RPM, CTR, CPC, and why ad earnings are only estimates.',
  },
  {
    href: '/blog/how-to-use-mortgage-calculator/',
    title: 'Mortgage calculator guide',
    text: 'See how loan amount, rate, term, taxes, insurance, PMI, and HOA change the payment estimate.',
  },
  {
    href: '/blog/how-to-use-income-tax-calculator/',
    title: 'Income tax guide',
    text: 'Understand taxable income, filing status, deductions, credits, and why tax estimates need caution.',
  },
  {
    href: '/blog/how-to-use-watts-to-amps-calculator/',
    title: 'Watts to amps guide',
    text: 'Use watts, volts, and phase type to understand electrical current estimates.',
  },
  {
    href: '/blog/how-to-use-wallpaper-calculator/',
    title: 'Wallpaper calculator guide',
    text: 'Learn waste percent, pattern repeat, roll coverage, openings, and dye lot checks before buying rolls.',
  },
  {
    href: '/blog/how-to-use-image-to-text-ocr-tool/',
    title: 'OCR tool guide',
    text: 'Use image quality, language selection, privacy notes, and double-checking to get better OCR results.',
  },
  {
    href: '/blog/how-to-use-amp-hours-to-watt-hours-calculator/',
    title: 'Amp-hours to watt-hours guide',
    text: 'Compare battery capacity with voltage so amp-hour labels make more sense.',
  },
  {
    href: '/blog/how-to-use-sand-calculator/',
    title: 'Sand calculator guide',
    text: 'Estimate sand volume, bag count, tons, and waste before a small project.',
  },
  {
    href: '/blog/how-to-use-payment-calculator/',
    title: 'Payment calculator guide',
    text: 'Break down loan payment inputs, interest, term length, and planning limits.',
  },
  {
    href: '/blog/how-to-use-prompt-token-estimator/',
    title: 'Prompt token estimator guide',
    text: 'Understand rough token estimates, context windows, model differences, and why final counts can change.',
  },
];
---

<BaseLayout
  title="Free Online Calculators and Tools | Access Free Tools"
  description="Browse free online calculators, converters, AI browser tools, text tools, guides, and everyday utilities from Access Free Tools."
  path="/tools/"
>
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Tools', path: '/tools/' },
    ]}
  />
  <CollectionStructuredData
    name="Free Online Calculators and Tools"
    description="Browse free online calculators, converters, AI browser tools, text tools, and everyday browser utilities from Access Free Tools."
    path="/tools/"
    maxItems={100}
    items={searchTools.map((tool) => ({
      name: tool.name,
      path: `/tools/${tool.slug}/`,
      description: tool.summary,
    }))}
  />
  <ToolsLaunchpad
    categories={categories}
    categoryCounts={categoryCounts}
    searchIndexUrl="/tool-search-index.json"
    tools={initialSearchTools}
    totalToolCount={searchTools.length}
    client:load
  />

  <section class="discovery-panel tools-index-context" aria-labelledby="tools-discovery-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Start here</p>
        <h2 id="tools-discovery-heading">Find the right free online tool faster</h2>
      </div>
      <p>
        You can search the whole library, but the fastest path is usually a hub. Pick the job
        first, then open the tool or guide that matches the question.
      </p>
    </div>
    <div class="discovery-link-grid">
      {discoveryHubs.map((hub) => (
        <a href={hub.href}>
          <strong>{hub.title}</strong>
          <span>{hub.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="discovery-panel discovery-panel-quiet" aria-labelledby="warm-tools-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Popular checks</p>
        <h2 id="warm-tools-heading">Useful tools people search for first</h2>
      </div>
      <p>
        These are simple entry points for common jobs. Each page links to its matching guide.
      </p>
    </div>
    <div class="discovery-link-grid">
      {warmToolLinks.map((link) => (
        <a href={link.href}>
          <strong>{link.title}</strong>
          <span>{link.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="discovery-panel" aria-labelledby="tools-guide-path-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Guides and examples</p>
        <h2 id="tools-guide-path-heading">Use a guide when the answer needs context</h2>
      </div>
      <p>
        Some searches need more than a number. These guide paths explain what the inputs mean,
        how to read the result, and which mistakes to avoid before using the answer.
      </p>
    </div>
    <div class="discovery-link-grid">
      {guideEntryLinks.map((link) => (
        <a href={link.href}>
          <strong>{link.title}</strong>
          <span>{link.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="discovery-panel discovery-panel-quiet" aria-labelledby="tools-az-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">A-Z index</p>
        <h2 id="tools-az-heading">Every public tool link</h2>
      </div>
      <p>
        This plain list links to the full library, including alternate-name pages that point to the
        matching tool.
      </p>
    </div>
    <div class="tools-az-grid">
      {toolsByInitial.map((group) => (
        <section class="tools-az-group" aria-labelledby={`tools-az-${group.letter}`}>
          <h3 id={`tools-az-${group.letter}`}>{group.letter}</h3>
          <ul>
            {group.tools.map((tool) => (
              <li>
                <a href={`/tools/${tool.slug}/`}>{tool.name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
