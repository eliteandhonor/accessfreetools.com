export const prerender = true;

export function getStaticPaths() {
  const toolPaths = tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));

  const aliasPaths = toolAliases
    .map((alias) => {
      const tool = tools.find((candidate) => candidate.slug === alias.targetSlug);

      return tool
        ? {
            params: { slug: alias.slug },
            props: { tool, alias },
          }
        : undefined;
    })
    .filter((path): path is { params: { slug: string }; props: { tool: ToolDefinition; alias: ToolAlias } } =>
      Boolean(path),
    );

  return [...toolPaths, ...aliasPaths];
}

