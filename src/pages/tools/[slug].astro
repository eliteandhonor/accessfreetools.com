              ? 'Monthly, yearly, and RPM shown'
              : tool.slug === 'auto-loan-calculator'
              ? 'Payment, interest, and total cost'
              : tool.slug === 'business-loan-calculator'
              ? 'Payment, fees, and cash received'
              : tool.slug === 'canadian-mortgage-calculator'
              ? 'Payment, LTV, and interest'
              : tool.slug === 'down-payment-calculator'
              ? 'Cash needed, LTV, and closing costs'
              : tool.slug === 'fha-loan-calculator'
              ? 'Payment, MIP, and LTV'
              : tool.slug === 'loan-calculator'
              ? 'Payment, total paid, and interest'
              : tool.slug === 'finance-calculator'
              ? 'Balance, deposits, and growth'
              : tool.slug === 'investment-calculator'
              ? 'Balance, contributions, and growth'
              : tool.slug === 'estate-tax-calculator'
              ? 'Exclusion and excess shown'
              : tool.slug === 'income-tax-calculator'
              ? 'Taxable income and bracket'
              : tool.slug === 'marriage-tax-calculator'
              ? 'Joint vs two-single tax'
              : 'Payment or total shown'}
          </span>
          <span>Example inputs</span>
          <span>Tab-only history</span>
        </div>
      )
