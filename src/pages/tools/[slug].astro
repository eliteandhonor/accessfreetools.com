          <span>All factors</span>
          <span>Factor pairs</span>
          <span>Prime factorization</span>
          <span>Prime check</span>
        </div>
      )
    }

    {
      isPrimeFactorizationTool && (
        <div class="advanced-tool-points" aria-label="Prime factorization calculator highlights">
          <span>Prime factors</span>
          <span>Power form</span>
          <span>Prime check</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isLongDivisionTool && (
        <div class="advanced-tool-points" aria-label="Long division calculator highlights">
          <span>Quotient</span>
          <span>Remainder</span>
          <span>Decimal answer</span>
          <span>Division check</span>
        </div>
      )
    }

    {
      isRoundingTool && (
        <div class="advanced-tool-points" aria-label="Rounding calculator highlights">
          <span>Decimal places</span>
          <span>Significant figures</span>
          <span>Place value</span>
          <span>Multiple methods</span>
        </div>
      )
