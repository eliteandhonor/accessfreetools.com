    {
      isAiTool && (
        <div class="advanced-tool-points ai-tool-points" aria-label={`${tool.name} highlights`}>
          <span>Browser-only input</span>
          <span>No upload to Access Free Tools</span>
          <span>Lazy model loading</span>
          <span>Copy after checking</span>
        </div>
      )
    }

    {
      tool.slug === 'triangle-calculator' && (
        <aside class="trust-note" aria-label="Triangle Calculator formula notes">
          <strong>Three sides only</strong>
          <p>
            Use this page when you know all three side lengths. It checks the triangle inequality first,
            then uses Heron&apos;s formula for area and the law of cosines for the angle estimates.
            If you know base and height instead, use the Area Calculator triangle mode.
          </p>
          <p>
            Sources used for this review:{' '}
            <a href="https://openstax.org/books/prealgebra-2e/pages/c-geometric-formulas" rel="noreferrer" target="_blank">
              OpenStax geometric formulas
            </a>
            {' and '}
            <a href="https://www.khanacademy.org/math/geometry-home/geometry-volume-surface-area/heron-formula-tutorial/v/heron-s-formula" rel="noreferrer" target="_blank">
              Khan Academy Heron&apos;s formula
            </a>
            .
          </p>
        </aside>
      )
    }

    {
      tool.slug === 'golf-handicap-calculator' && (
        <aside class="trust-note" aria-label="Golf Handicap Calculator formula notes">
          <strong>Estimate, not official posting</strong>
          <p>
            Use this page to check one adjusted round or one tee setup. Score differential uses adjusted gross score,
            Course Rating, Slope Rating, and PCC. Course handicap uses Handicap Index, Slope Rating, Course Rating,
            and par. Playing handicap then applies the allowance for the format.
          </p>
          <p>
            Sources used for this review:{' '}
            <a
              href="https://digital-pd.usga.org/content/usga/home-page/handicapping/world-handicap-system/world-handicap-system-usga-golf-faqs/faqs---what-is-a-score-differential.html"
              rel="noreferrer"
              target="_blank"
            >
              USGA score differential
            </a>
            {' and '}
            <a
              href="https://digital-pd.usga.org/content/usga/home-page/handicapping/world-handicap-system/world-handicap-system-usga-golf-faqs/faqs---calculate-course-handicap-and-playing-handicap.html"
              rel="noreferrer"
              target="_blank"
            >
              USGA course handicap
            </a>
            .
          </p>
        </aside>
      )
    }

    {
      tool.slug === 'gas-mileage-calculator' && (
        <aside class="trust-note" aria-label="Gas Mileage Calculator formula notes">
          <strong>Same tank, same window</strong>
          <p>
            Use miles and gallons from the same fill-up or trip. MPG is miles divided by gallons. Gallons per 100 miles
            flips the idea around so you can compare fuel used over the same distance.
          </p>
          <p>
            Good references:{' '}
            <a href="https://www.epa.gov/greenvehicles/miles-gallon-mpg-math" rel="noreferrer" target="_blank">
              EPA MPG math
            </a>{' '}
            and{' '}
            <a href="https://www.energy.gov/energysaver/driving-more-efficiently" rel="noreferrer" target="_blank">
              DOE efficient driving guidance.
            </a>
          </p>
        </aside>
      )
    }

    {
