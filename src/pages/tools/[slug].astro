const utilityToolInstructions = utilityToolVariant
  ? [
      ...(utilityToolInstructionsBySlug[tool.slug] ?? [
        'Enter the requested dates, times, grades, dimensions, network values, password options, or units.',
        'Check the assumptions shown on the page, especially school scales, payroll rules, concrete waste, subnet type, or security handling.',
        'Press the calculate button to see the answer, supporting metrics, and formula steps.',
        'Use examples, recent answers, or copy the result while keeping the estimate limits in mind.',
      ]),
    ]
  : undefined;
const aiToolInstructions = aiToolVariant
  ? [
      'Enter text or choose an image for the AI task.',
      'Press the main action button so the browser can load any needed model or language files.',
      'Read the label, score, notes, and limits before copying anything important.',
      'Check the original text or image yourself because browser AI output can still be wrong.',
    ]
  : undefined;
const toolInstructions = statsToolInstructions[tool.slug] ?? geometryToolInstructions[tool.slug] ?? financeToolInstructions ?? healthToolInstructions ?? utilityToolInstructions ?? aiToolInstructions ?? (isPercentageTool
  ? [
      'Choose the percentage question you want to answer.',
      'Enter the values for percent-of, what-percent, percentage change, adjustment, or reverse percentage.',
      'Press Calculate percentage to see the answer, formula, and steps.',
      'Use examples, recent answers, or copy answer while you compare values.',
    ]
  : isPercentErrorTool
  ? [
      'Enter the measured or experimental value from your result.',
      'Enter the accepted, true, or theoretical value you are comparing against.',
      'Add a unit label if it helps your answer read clearly.',
      'Press Calculate percent error to see absolute percent error, signed percent error, and steps.',
    ]
  : isHalfLifeTool
  ? [
      'Choose whether you want remaining amount, elapsed time, or half-life.',
      'Enter the known initial amount and the other values requested for that mode.',
      'Use matching time units for elapsed time and half-life, such as hours with hours.',
      'Press Calculate half-life to see the answer, percentages, formula steps, and recent history.',
    ]
  : isExponentTool
  ? [
      'Enter the base number.',
      'Enter the exponent as a whole number, decimal, or simple fraction such as 1/2.',
      'Press Calculate exponent to see the power, scientific notation, and steps.',
      'Use examples, recent answers, or copy the answer while you compare powers.',
    ]
  : isLogTool
  ? [
      'Enter the positive value you want to evaluate.',
      'Enter a positive base that is not 1, such as 2, 10, or e.',
      'Press Calculate log to see the logarithm, ln, log10, power check, and steps.',
      'Use examples, recent answers, or copy the answer while you study logarithms.',
    ]
  : isRatioTool
  ? [
      'Choose Simplify, Equivalent, or Split total.',
      'Enter the ratio parts or the known equivalent-ratio values.',
      'Press Calculate ratio to see the answer, scale factor or shares, and steps.',
      'Use examples, recent answers, or copy the answer while comparing proportions.',
    ]
  : isRootTool
  ? [
      'Enter the radicand, which is the value inside the root.',
      'Enter a whole-number root index, such as 2 for square root or 3 for cube root.',
      'Press Calculate root to see the answer, exponent form, power check, and steps.',
      'Use examples, recent answers, or copy the answer while checking root problems.',
    ]
  : isQuadraticTool
  ? [
      'Enter coefficients a, b, and c from standard form ax^2 + bx + c = 0.',
      'Press Calculate roots to use the quadratic formula.',
      'Review the roots, discriminant, vertex, axis of symmetry, and step-by-step work.',
      'Use examples, recent answers, or copy the answer while you study or graph.',
    ]
  : isBinaryTool
  ? [
      'Enter the first binary number using only 0 and 1.',
      'Choose add, subtract, multiply, or divide.',
      'Enter the second binary number, then press Calculate binary.',
      'Review the binary answer, decimal answer, steps, conversions, and recent answers.',
    ]
  : isHexTool
  ? [
      'Enter the first hex number using 0-9 and A-F.',
      'Choose add, subtract, multiply, or divide.',
      'Enter the second hex number, then press Calculate hex.',
      'Review the hex answer, decimal answer, binary answer, steps, conversions, and recent answers.',
    ]
  : isRandomTool
  ? [
      'Enter the minimum and maximum whole numbers for the range.',
      'Choose how many random numbers to generate.',
      'Turn on unique results, sorting, or exclusions when your list needs those rules.',
      'Press Generate numbers, then copy the result or compare it with recent results.',
    ]
  : isLeastCommonMultipleTool
  ? [
      'Enter at least two positive whole numbers separated by commas, spaces, or semicolons.',
      'Press Calculate LCM to find the smallest shared positive multiple.',
      'Review the exact answer, input range, and LCM steps.',
      'Use examples, recent answers, or copy answer while checking fraction or schedule problems.',
    ]
  : isGreatestCommonFactorTool
  ? [
      'Enter at least two positive whole numbers separated by commas, spaces, or semicolons.',
      'Press Calculate GCF to find the largest shared divisor.',
      'Review the exact answer, input range, and Euclidean-algorithm style steps.',
      'Use examples, recent answers, or copy answer while simplifying fractions or ratios.',
    ]
  : isFactorTool
  ? [
      'Enter one positive whole number.',
      'Press Find factors to list all factors and factor pairs.',
      'Review the prime factorization and whether the number is prime.',
      'Use examples, recent answers, or copy answer while checking divisibility work.',
    ]
  : isPrimeFactorizationTool
  ? [
      'Enter one positive whole number.',
      'Press Factor into primes to break it into prime factors.',
      'Review repeated prime factors as exponents and check whether the number is prime.',
      'Use examples, recent answers, or copy the result while checking factorization work.',
    ]
  : isLongDivisionTool
  ? [
      'Enter the problem as dividend / divisor, such as 9876 / 24.',
      'Press Divide to find the quotient and remainder.',
      'Review the decimal answer and the multiplication check.',
      'Use examples, recent answers, or copy the result while practicing division.',
    ]
  : isRoundingTool
  ? [
      'Choose decimal places, significant figures, or place value mode.',
      'Choose nearest, round up, round down, or truncate.',
      'Enter the number and precision, then press Round value.',
      'Review the rounded answer, difference, steps, examples, and recent answers.',
    ]
  : isMatrixTool
  ? [
      'Choose 2x2 or 3x3 matrix size.',
      'Choose add, subtract, multiply, determinant, or transpose.',
      'Enter Matrix A and Matrix B when the operation needs both matrices.',
      'Press Calculate matrix to see the result, steps, examples, copy, and history.',
    ]
  : isScientificNotationTool
  ? [
      'Choose To scientific or To standard mode.',
      'Enter the standard number, or enter the coefficient and exponent.',
      'Press Convert notation to see scientific notation, standard form, coefficient, and exponent.',
      'Use examples, recent answers, or copy answer while checking science notation.',
    ]
  : isBigNumberTool
  ? [
      'Enter two whole numbers, using commas or spaces if that makes long values easier to read.',
      'Choose add, subtract, multiply, or divide.',
      'Press Calculate big number to get an exact integer answer.',
      'Review quotient and remainder for division, steps, recent answers, and copy output.',
    ]
  : isFractionTool
  ? [
      'Enter each fraction using the whole number, numerator, and denominator boxes.',
      'Choose add, subtract, multiply, or divide.',
      'Press Calculate fraction to see the simplified answer, improper fraction, decimal, and steps.',
      'Use examples, swap, copy answer, or recent answers while you work.',
    ]
  : isScientificTool
  ? [
      'Type an expression or use the scientific keypad.',
      'Choose DEG or RAD before using trigonometry.',
      'Use functions such as sin, cos, tan, log, ln, sqrt, cbrt, powers, pi, and e.',
      'Press equals or Enter, then copy the result or reuse an expression from history.',
    ]
  : [
      'Enter your first number using the buttons or keyboard.',
      'Choose an operation such as plus, minus, multiply, or divide.',
      'Enter the next number, then press equals or Enter.',
      'Copy the result or keep calculating with the history panel nearby.',
    ]);
---

<BaseLayout
  title={isAliasPage ? `${displayName} | Access Free Tools` : tool.seoTitle}
  description={isAliasPage ? displayDescription : tool.seoDescription}
  path={`/tools/${tool.slug}/`}
  socialImagePath={toolArt?.imagePath ?? toolSocialImagePath}
  socialImageAlt={toolArt?.alt}
>
  {!isAliasPage && <ToolStructuredData tool={tool} imagePath={toolArt?.imagePath} />}
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Tools', path: '/tools/' },
      { name: categoryName, path: categoryPath },
      { name: displayName, path: currentPath },
    ]}
  />

  <section class="tool-page">
    <p class="breadcrumb">
      <a href="/">Home</a> / <a href="/tools/">Tools</a> /
      <a href={categoryPath}>{categoryName}</a>
    </p>

    <div class="tool-title-row">
      <div>
        <h1>{displayName}</h1>
        <p>{displayDescription}</p>
      </div>
      <a class="button-secondary" href="/tools/">All tools</a>
    </div>

    {
      isAliasPage && (
        <div class="alias-notice">
          <strong>{displayName} is available as the {tool.name}.</strong>
          <p>
            This is the same working tool under a different name. Keeping one main version means the formula,
            examples, FAQs, and guide link do not split into two slightly different pages.
          </p>
          <a class="button-primary" href={`/tools/${tool.slug}/`}>Open {tool.name}</a>
        </div>
      )
    }

    {toolArt && <ToolArtFigure entry={toolArt} eager={true} />}

    {
      isKawaiiTool && (
        <section class="kawaii-tool-hero" aria-label="Kawaii calculator style">
          <div>
            <span>Kawaii math mode</span>
            <h2>Soft colors, same useful calculator.</h2>
            <p>
              A playful pastel version of the calculator with copy result, keyboard support,
              percentages, and session history.
            </p>
          </div>
          <img
            src="/images/kawaii-calculator-mascot.webp"
            alt="A pastel kawaii calculator mascot with cute stationery."
            title="Pastel kawaii calculator mascot for the working calculator interface."
            height="720"
            loading="eager"
            width="900"
          />
        </section>
      )
    }

    {
      isScientificTool && (
        <div class="scientific-tool-points" aria-label="Scientific calculator highlights">
          <span>Keyboard support</span>
          <span>DEG / RAD mode</span>
          <span>Expression history</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isPercentageTool && (
        <div class="percentage-tool-points" aria-label="Percentage calculator highlights">
          <span>Percent of</span>
          <span>Percentage change</span>
          <span>Discounts and markups</span>
          <span>Reverse percent</span>
        </div>
      )
    }

    {
      isExponentTool && (
        <div class="exponent-tool-points" aria-label="Exponent calculator highlights">
          <span>Positive powers</span>
          <span>Negative exponents</span>
          <span>Fraction exponents</span>
          <span>Scientific notation</span>
        </div>
      )
    }

    {
      isLogTool && (
        <div class="log-tool-points" aria-label="Log calculator highlights">
          <span>Custom bases</span>
          <span>ln and log10</span>
          <span>Change-of-base steps</span>
          <span>Power check</span>
        </div>
      )
    }

    {
      isRatioTool && (
        <div class="ratio-tool-points" aria-label="Ratio calculator highlights">
          <span>Simplify ratios</span>
          <span>Equivalent ratios</span>
          <span>Split totals</span>
          <span>Step-by-step work</span>
        </div>
      )
    }

    {
      isRootTool && (
        <div class="root-tool-points" aria-label="Root calculator highlights">
          <span>Square roots</span>
          <span>Cube roots</span>
          <span>Nth roots</span>
          <span>Exponent form</span>
        </div>
      )
    }

    {
      isQuadraticTool && (
        <div class="quadratic-tool-points" aria-label="Quadratic formula calculator highlights">
          <span>Real and complex roots</span>
          <span>Discriminant</span>
          <span>Vertex and axis</span>
          <span>Step-by-step work</span>
        </div>
      )
    }

    {
      isBinaryTool && (
        <div class="binary-tool-points" aria-label="Binary calculator highlights">
          <span>Binary arithmetic</span>
          <span>Decimal conversion</span>
          <span>Remainders</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isHexTool && (
        <div class="binary-tool-points hex-tool-points" aria-label="Hex calculator highlights">
          <span>Hex arithmetic</span>
          <span>Decimal conversion</span>
          <span>Binary output</span>
          <span>Remainders</span>
        </div>
      )
    }

    {
      isHalfLifeTool && (
        <div class="half-life-tool-points" aria-label="Half-life calculator highlights">
          <span>Remaining amount</span>
          <span>Elapsed time</span>
          <span>Solve half-life</span>
          <span>Decay steps</span>
        </div>
      )
    }

    {
      isPercentErrorTool && (
        <div class="percent-error-tool-points" aria-label="Percent error calculator highlights">
          <span>Accepted vs measured</span>
          <span>Absolute percent error</span>
          <span>Signed direction</span>
          <span>Step-by-step work</span>
        </div>
      )
    }

    {
      isRandomTool && (
        <div class="random-tool-points" aria-label="Random number generator highlights">
          <span>Min and max range</span>
          <span>Multiple results</span>
          <span>Unique mode</span>
          <span>Exclude and copy</span>
        </div>
      )
    }

    {
      isFractionTool && (
        <div class="fraction-tool-points" aria-label="Fraction calculator highlights">
          <span>Mixed numbers</span>
          <span>Simplified answers</span>
          <span>Step-by-step work</span>
          <span>Decimal conversion</span>
        </div>
      )
    }

    {
      isLeastCommonMultipleTool && (
        <div class="advanced-tool-points" aria-label="Least common multiple calculator highlights">
          <span>Two or more numbers</span>
          <span>Exact LCM</span>
          <span>Common denominators</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isGreatestCommonFactorTool && (
        <div class="advanced-tool-points" aria-label="Greatest common factor calculator highlights">
          <span>Two or more numbers</span>
          <span>Exact GCF</span>
          <span>Euclidean steps</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isFactorTool && (
        <div class="advanced-tool-points" aria-label="Factor calculator highlights">
          <span>All factors</span>
          <span>Factor pairs</span>
          <span>Prime factorization</span>
          <span>Prime check</span>
        </div>
      )
    }

    {
      isPrimeFactorizationTool && (
        <div class="advanced-tool-points" aria-label="Prime factorization calculator highlights">
          <span>Prime factors</span>
          <span>Power form</span>
          <span>Prime check</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isLongDivisionTool && (
