---
import BaseLayout from '../../components/BaseLayout.astro';
import BasicCalculator from '../../components/BasicCalculator';
import BinaryCalculator from '../../components/BinaryCalculator';
import BigNumberCalculator from '../../components/BigNumberCalculator';
import ExponentCalculator from '../../components/ExponentCalculator';
import FractionCalculator from '../../components/FractionCalculator';
import GeometryCalculator, { type GeometryToolVariant } from '../../components/GeometryCalculator';
import HalfLifeCalculator from '../../components/HalfLifeCalculator';
import HexCalculator from '../../components/HexCalculator';
import LogCalculator from '../../components/LogCalculator';
import MatrixCalculator from '../../components/MatrixCalculator';
import NumberTheoryCalculator from '../../components/NumberTheoryCalculator';
import PercentErrorCalculator from '../../components/PercentErrorCalculator';
import PercentageCalculator from '../../components/PercentageCalculator';
import QuadraticFormulaCalculator from '../../components/QuadraticFormulaCalculator';
import RatioCalculator from '../../components/RatioCalculator';
import RandomNumberGenerator from '../../components/RandomNumberGenerator';
import RootCalculator from '../../components/RootCalculator';
import RoundingCalculator from '../../components/RoundingCalculator';
import ScientificCalculator from '../../components/ScientificCalculator';
import ScientificNotationCalculator from '../../components/ScientificNotationCalculator';
import StatsCalculator, { type StatsToolVariant } from '../../components/StatsCalculator';
import ToolCard from '../../components/ToolCard.astro';
import ToolStructuredData from '../../components/ToolStructuredData.astro';
import { getCategoryName, getRelatedTools, tools, type ToolDefinition } from '../../data/tools';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const relatedTools = getRelatedTools(tool);
const isCalculatorTool = tool.slug === 'basic-calculator' || tool.slug === 'kawaii-calculator';
const isKawaiiTool = tool.slug === 'kawaii-calculator';
const isScientificTool = tool.slug === 'scientific-calculator';
const isFractionTool = tool.slug === 'fraction-calculator';
const isPercentageTool = tool.slug === 'percentage-calculator';
const isPercentErrorTool = tool.slug === 'percent-error-calculator';
const isHalfLifeTool = tool.slug === 'half-life-calculator';
const isExponentTool = tool.slug === 'exponent-calculator';
const isLogTool = tool.slug === 'log-calculator';
const isRatioTool = tool.slug === 'ratio-calculator';
const isRootTool = tool.slug === 'root-calculator';
const isQuadraticTool = tool.slug === 'quadratic-formula-calculator';
const isBinaryTool = tool.slug === 'binary-calculator';
const isHexTool = tool.slug === 'hex-calculator';
const isRandomTool = tool.slug === 'random-number-generator';
const isLeastCommonMultipleTool = tool.slug === 'least-common-multiple-calculator';
const isGreatestCommonFactorTool = tool.slug === 'greatest-common-factor-calculator';
const isFactorTool = tool.slug === 'factor-calculator';
const isRoundingTool = tool.slug === 'rounding-calculator';
const isMatrixTool = tool.slug === 'matrix-calculator';
const isScientificNotationTool = tool.slug === 'scientific-notation-calculator';
const isBigNumberTool = tool.slug === 'big-number-calculator';
const isNumberTheoryTool = isLeastCommonMultipleTool || isGreatestCommonFactorTool || isFactorTool;
const statsToolVariants = {
  'standard-deviation-calculator': 'standard-deviation',
  'number-sequence-calculator': 'number-sequence',
  'sample-size-calculator': 'sample-size',
  'probability-calculator': 'probability',
  'statistics-calculator': 'statistics',
  'mean-median-mode-range-calculator': 'mean-median-mode-range',
  'permutation-and-combination-calculator': 'permutation-combination',
  'z-score-calculator': 'z-score',
  'confidence-interval-calculator': 'confidence-interval',
} as const satisfies Partial<Record<string, StatsToolVariant>>;
const statsToolVariant = statsToolVariants[tool.slug];
const isStatsSuiteTool = Boolean(statsToolVariant);
const geometryToolVariants = {
  'triangle-calculator': 'triangle',
  'volume-calculator': 'volume',
  'slope-calculator': 'slope',
  'area-calculator': 'area',
  'distance-calculator': 'distance',
  'circle-calculator': 'circle',
  'surface-area-calculator': 'surface-area',
  'pythagorean-theorem-calculator': 'pythagorean',
  'right-triangle-calculator': 'right-triangle',
} as const satisfies Partial<Record<string, GeometryToolVariant>>;
const geometryToolVariant = geometryToolVariants[tool.slug];
const isGeometryTool = Boolean(geometryToolVariant);
const statsToolInstructions: Record<string, string[]> = {
  'standard-deviation-calculator': [
    'Enter a list of numbers separated by commas, spaces, or line breaks.',
    'Choose Sample when your values are a sample, or Population when the list is the full group.',
    'Press Calculate standard deviation to see variance, mean, range, and formula steps.',
    'Use examples, recent answers, or copy the result while checking statistics work.',
  ],
  'number-sequence-calculator': [
    'Choose arithmetic, geometric, or Fibonacci sequence mode.',
    'Enter the starting values and how many terms you want.',
    'Press Generate sequence to see the list, rule, and next term.',
    'Use examples, recent answers, or copy the sequence while studying patterns.',
  ],
  'sample-size-calculator': [
    'Choose a confidence level such as 90%, 95%, or 99%.',
    'Enter the margin of error and estimated population proportion as percentages.',
    'Add a finite population size only when you know the population is limited.',
    'Press Calculate sample size to see the required sample and formula steps.',
  ],
  'probability-calculator': [
    'Enter P(A) and P(B) as percentages.',
    'Leave the intersection blank for independent-event multiplication, or enter P(A and B).',
    'Press Calculate probability to see union, intersection, complements, and steps.',
    'Use examples, recent answers, or copy the result while checking probability problems.',
  ],
  'statistics-calculator': [
    'Enter a list of numbers separated by commas, spaces, or line breaks.',
    'Press Calculate statistics to see mean, median, modes, range, quartiles, and standard deviation.',
    'Review the sorted values and formula steps.',
    'Use examples, recent answers, or copy the summary while comparing data sets.',
  ],
  'mean-median-mode-range-calculator': [
    'Enter the data set using commas, spaces, or line breaks.',
    'Press Calculate summary to see the mean, median, mode, and range.',
    'Review the sorted values to understand how the center and spread were found.',
    'Use examples, recent answers, or copy the answer while doing quick statistics checks.',
  ],
  'permutation-and-combination-calculator': [
    'Enter n for the total items and r for the items selected.',
    'Press Calculate nPr and nCr to see permutation and combination counts.',
    'Use nPr when order matters and nCr when order does not matter.',
    'Review the formulas, examples, recent answers, and exact integer output.',
  ],
  'z-score-calculator': [
    'Enter the value, mean, and standard deviation.',
    'Press Calculate z-score to standardize the value.',
    'Review whether the value is above or below the mean and the approximate normal percentile.',
    'Use examples, recent answers, or copy the result while checking statistics work.',
  ],
  'confidence-interval-calculator': [
    'Choose mean interval or proportion interval mode.',
    'Choose a confidence level, then enter the sample values requested for that mode.',
    'Press Calculate interval to see the lower bound, upper bound, margin of error, and steps.',
    'Use examples, recent answers, or copy the interval while checking estimates.',
  ],
};
const geometryToolInstructions: Record<string, string[]> = {
  'triangle-calculator': [
    'Enter the three side lengths of the triangle.',
    'Add an optional unit label such as cm, m, or in.',
    'Press Calculate triangle to find area, perimeter, angles, and triangle type.',
    'Use examples, recent answers, or copy the result while checking geometry work.',
  ],
  'volume-calculator': [
    'Choose the solid shape: rectangular prism, cube, cylinder, sphere, or cone.',
    'Enter the required radius, height, side, length, or width values.',
    'Press Calculate volume to see the cubic result and formula steps.',
    'Use examples, recent answers, or copy the result for notes or homework.',
  ],
  'slope-calculator': [
    'Enter the first point as x1 and y1.',
    'Enter the second point as x2 and y2.',
    'Press Calculate slope to see rise, run, slope, and the line equation.',
    'Use examples, recent answers, or copy the result while checking coordinate problems.',
  ],
  'area-calculator': [
    'Choose the shape: rectangle, triangle, circle, trapezoid, or parallelogram.',
    'Enter the required measurements for that shape.',
    'Press Calculate area to see the square-unit result and formula steps.',
    'Use examples, recent answers, or copy the result while comparing shapes.',
  ],
  'distance-calculator': [
    'Enter the first point as x1 and y1.',
    'Enter the second point as x2 and y2.',
    'Press Calculate distance to see distance, delta x, delta y, and midpoint.',
    'Use examples, recent answers, or copy the result while checking coordinate geometry.',
  ],
  'circle-calculator': [
    'Choose the known circle measurement: radius, diameter, circumference, or area.',
    'Enter the known value and an optional unit label.',
    'Press Calculate circle to find radius, diameter, circumference, and area.',
    'Use examples, recent answers, or copy the result while solving circle problems.',
  ],
  'surface-area-calculator': [
    'Choose the solid shape: rectangular prism, cube, cylinder, sphere, or cone.',
    'Enter the required measurements for that shape.',
    'Press Calculate surface area to see the square-unit result and formula steps.',
    'Use examples, recent answers, or copy the result while checking geometry work.',
  ],
  'pythagorean-theorem-calculator': [
    'Choose whether you need the hypotenuse, leg a, or leg b.',
    'Enter the two known side lengths of the right triangle.',
    'Press Calculate side to solve the missing side with a^2 + b^2 = c^2.',
    'Use examples, recent answers, or copy the result while checking right-triangle work.',
  ],
  'right-triangle-calculator': [
    'Choose two legs or leg and hypotenuse mode.',
    'Enter the known side lengths and optional unit label.',
    'Press Calculate right triangle to find sides, area, perimeter, and acute angles.',
    'Use examples, recent answers, or copy the result while solving right triangles.',
  ],
};
const toolInstructions = statsToolInstructions[tool.slug] ?? geometryToolInstructions[tool.slug] ?? (isPercentageTool
  ? [
      'Choose the percentage question you want to answer.',
      'Enter the values for percent-of, what-percent, percentage change, adjustment, or reverse percentage.',
      'Press Calculate percentage to see the answer, formula, and steps.',
      'Use examples, recent answers, or copy answer while you compare values.',
    ]
  : isPercentErrorTool
  ? [
      'Enter the measured or experimental value from your result.',
      'Enter the accepted, true, or theoretical value you are comparing against.',
      'Add a unit label if it helps your answer read clearly.',
      'Press Calculate percent error to see absolute percent error, signed percent error, and steps.',
    ]
  : isHalfLifeTool
  ? [
      'Choose whether you want remaining amount, elapsed time, or half-life.',
      'Enter the known initial amount and the other values requested for that mode.',
      'Use matching time units for elapsed time and half-life, such as hours with hours.',
      'Press Calculate half-life to see the answer, percentages, formula steps, and recent history.',
    ]
  : isExponentTool
  ? [
      'Enter the base number.',
      'Enter the exponent as a whole number, decimal, or simple fraction such as 1/2.',
      'Press Calculate exponent to see the power, scientific notation, and steps.',
      'Use examples, recent answers, or copy the answer while you compare powers.',
    ]
  : isLogTool
  ? [
      'Enter the positive value you want to evaluate.',
      'Enter a positive base that is not 1, such as 2, 10, or e.',
      'Press Calculate log to see the logarithm, ln, log10, power check, and steps.',
      'Use examples, recent answers, or copy the answer while you study logarithms.',
    ]
  : isRatioTool
  ? [
      'Choose Simplify, Equivalent, or Split total.',
      'Enter the ratio parts or the known equivalent-ratio values.',
      'Press Calculate ratio to see the answer, scale factor or shares, and steps.',
      'Use examples, recent answers, or copy the answer while comparing proportions.',
    ]
  : isRootTool
  ? [
      'Enter the radicand, which is the value inside the root.',
      'Enter a whole-number root index, such as 2 for square root or 3 for cube root.',
      'Press Calculate root to see the answer, exponent form, power check, and steps.',
      'Use examples, recent answers, or copy the answer while checking root problems.',
    ]
  : isQuadraticTool
  ? [
      'Enter coefficients a, b, and c from standard form ax^2 + bx + c = 0.',
      'Press Calculate roots to use the quadratic formula.',
      'Review the roots, discriminant, vertex, axis of symmetry, and step-by-step work.',
      'Use examples, recent answers, or copy the answer while you study or graph.',
    ]
  : isBinaryTool
  ? [
      'Enter the first binary number using only 0 and 1.',
      'Choose add, subtract, multiply, or divide.',
      'Enter the second binary number, then press Calculate binary.',
      'Review the binary answer, decimal answer, steps, conversions, and recent answers.',
    ]
  : isHexTool
  ? [
      'Enter the first hex number using 0-9 and A-F.',
      'Choose add, subtract, multiply, or divide.',
      'Enter the second hex number, then press Calculate hex.',
      'Review the hex answer, decimal answer, binary answer, steps, conversions, and recent answers.',
    ]
  : isRandomTool
  ? [
      'Enter the minimum and maximum whole numbers for the range.',
      'Choose how many random numbers to generate.',
      'Turn on unique results, sorting, or exclusions when your list needs those rules.',
      'Press Generate numbers, then copy the result or compare it with recent results.',
    ]
  : isLeastCommonMultipleTool
  ? [
      'Enter at least two positive whole numbers separated by commas, spaces, or semicolons.',
      'Press Calculate LCM to find the smallest shared positive multiple.',
      'Review the exact answer, input range, and LCM steps.',
      'Use examples, recent answers, or copy answer while checking fraction or schedule problems.',
    ]
  : isGreatestCommonFactorTool
  ? [
      'Enter at least two positive whole numbers separated by commas, spaces, or semicolons.',
      'Press Calculate GCF to find the largest shared divisor.',
      'Review the exact answer, input range, and Euclidean-algorithm style steps.',
      'Use examples, recent answers, or copy answer while simplifying fractions or ratios.',
    ]
  : isFactorTool
  ? [
      'Enter one positive whole number.',
      'Press Find factors to list all factors and factor pairs.',
      'Review the prime factorization and whether the number is prime.',
      'Use examples, recent answers, or copy answer while checking divisibility work.',
    ]
  : isRoundingTool
  ? [
      'Choose decimal places, significant figures, or place value mode.',
      'Choose nearest, round up, round down, or truncate.',
      'Enter the number and precision, then press Round value.',
      'Review the rounded answer, difference, steps, examples, and recent answers.',
    ]
  : isMatrixTool
  ? [
      'Choose 2x2 or 3x3 matrix size.',
      'Choose add, subtract, multiply, determinant, or transpose.',
      'Enter Matrix A and Matrix B when the operation needs both matrices.',
      'Press Calculate matrix to see the result, steps, examples, copy, and history.',
    ]
  : isScientificNotationTool
  ? [
      'Choose To scientific or To standard mode.',
      'Enter the standard number, or enter the coefficient and exponent.',
      'Press Convert notation to see scientific notation, standard form, coefficient, and exponent.',
      'Use examples, recent answers, or copy answer while checking science notation.',
    ]
  : isBigNumberTool
  ? [
      'Enter two whole numbers, using commas or spaces if that makes long values easier to read.',
      'Choose add, subtract, multiply, or divide.',
      'Press Calculate big number to get an exact integer answer.',
      'Review quotient and remainder for division, steps, recent answers, and copy output.',
    ]
  : isFractionTool
  ? [
      'Enter each fraction using the whole number, numerator, and denominator boxes.',
      'Choose add, subtract, multiply, or divide.',
      'Press Calculate fraction to see the simplified answer, improper fraction, decimal, and steps.',
      'Use examples, swap, copy answer, or recent answers while you work.',
    ]
  : isScientificTool
  ? [
      'Type an expression or use the scientific keypad.',
      'Choose DEG or RAD before using trigonometry.',
      'Use functions such as sin, cos, tan, log, ln, sqrt, cbrt, powers, pi, and e.',
      'Press equals or Enter, then copy the result or reuse an expression from history.',
    ]
  : [
      'Enter your first number using the buttons or keyboard.',
      'Choose an operation such as plus, minus, multiply, or divide.',
      'Enter the next number, then press equals or Enter.',
      'Copy the result or keep calculating with the history panel nearby.',
    ]);
---

<BaseLayout title={tool.seoTitle} description={tool.seoDescription} path={`/tools/${tool.slug}/`}>
  <ToolStructuredData tool={tool} />

  <section class="tool-page">
    <p class="breadcrumb">
      <a href="/">Home</a> / <a href="/tools/">Tools</a> /
      <a href={`/categories/${tool.category}/`}>{getCategoryName(tool.category)}</a>
    </p>

    <div class="tool-title-row">
      <div>
        <h1>{tool.name}</h1>
        <p>{tool.description}</p>
      </div>
      <a class="button-secondary" href="/tools/">All tools</a>
    </div>

    {
      isKawaiiTool && (
        <section class="kawaii-tool-hero" aria-label="Kawaii calculator style">
          <div>
            <span>Kawaii math mode</span>
            <h2>Soft colors, same useful calculator.</h2>
            <p>
              A playful pastel version of the calculator with copy result, keyboard support,
              percentages, and session history.
            </p>
          </div>
          <img
            src="/images/kawaii-calculator-mascot.webp"
            alt="A pastel kawaii calculator mascot with cute stationery."
            height="720"
            loading="eager"
            width="900"
          />
        </section>
      )
    }

    {
      isScientificTool && (
        <div class="scientific-tool-points" aria-label="Scientific calculator highlights">
          <span>Keyboard support</span>
          <span>DEG / RAD mode</span>
          <span>Expression history</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isPercentageTool && (
        <div class="percentage-tool-points" aria-label="Percentage calculator highlights">
          <span>Percent of</span>
          <span>Percentage change</span>
          <span>Discounts and markups</span>
          <span>Reverse percent</span>
        </div>
      )
    }

    {
      isExponentTool && (
        <div class="exponent-tool-points" aria-label="Exponent calculator highlights">
          <span>Positive powers</span>
          <span>Negative exponents</span>
          <span>Fraction exponents</span>
          <span>Scientific notation</span>
        </div>
      )
    }

    {
      isLogTool && (
        <div class="log-tool-points" aria-label="Log calculator highlights">
          <span>Custom bases</span>
          <span>ln and log10</span>
          <span>Change-of-base steps</span>
          <span>Power check</span>
        </div>
      )
    }

    {
      isRatioTool && (
        <div class="ratio-tool-points" aria-label="Ratio calculator highlights">
          <span>Simplify ratios</span>
          <span>Equivalent ratios</span>
          <span>Split totals</span>
          <span>Step-by-step work</span>
        </div>
      )
    }

    {
      isRootTool && (
        <div class="root-tool-points" aria-label="Root calculator highlights">
          <span>Square roots</span>
          <span>Cube roots</span>
          <span>Nth roots</span>
          <span>Exponent form</span>
        </div>
      )
    }

    {
      isQuadraticTool && (
        <div class="quadratic-tool-points" aria-label="Quadratic formula calculator highlights">
          <span>Real and complex roots</span>
          <span>Discriminant</span>
          <span>Vertex and axis</span>
          <span>Step-by-step work</span>
        </div>
      )
    }

    {
      isBinaryTool && (
        <div class="binary-tool-points" aria-label="Binary calculator highlights">
          <span>Binary arithmetic</span>
          <span>Decimal conversion</span>
          <span>Remainders</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isHexTool && (
        <div class="binary-tool-points hex-tool-points" aria-label="Hex calculator highlights">
          <span>Hex arithmetic</span>
          <span>Decimal conversion</span>
          <span>Binary output</span>
          <span>Remainders</span>
        </div>
      )
    }

    {
      isHalfLifeTool && (
        <div class="half-life-tool-points" aria-label="Half-life calculator highlights">
          <span>Remaining amount</span>
          <span>Elapsed time</span>
          <span>Solve half-life</span>
          <span>Decay steps</span>
        </div>
      )
    }

    {
      isPercentErrorTool && (
        <div class="percent-error-tool-points" aria-label="Percent error calculator highlights">
          <span>Accepted vs measured</span>
          <span>Absolute percent error</span>
          <span>Signed direction</span>
          <span>Step-by-step work</span>
        </div>
      )
    }

    {
      isRandomTool && (
        <div class="random-tool-points" aria-label="Random number generator highlights">
          <span>Min and max range</span>
          <span>Multiple results</span>
          <span>Unique mode</span>
          <span>Exclude and copy</span>
        </div>
      )
    }

    {
      isFractionTool && (
        <div class="fraction-tool-points" aria-label="Fraction calculator highlights">
          <span>Mixed numbers</span>
          <span>Simplified answers</span>
          <span>Step-by-step work</span>
          <span>Decimal conversion</span>
        </div>
      )
    }

    {
      isLeastCommonMultipleTool && (
        <div class="advanced-tool-points" aria-label="Least common multiple calculator highlights">
          <span>Two or more numbers</span>
          <span>Exact LCM</span>
          <span>Common denominators</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isGreatestCommonFactorTool && (
        <div class="advanced-tool-points" aria-label="Greatest common factor calculator highlights">
          <span>Two or more numbers</span>
          <span>Exact GCF</span>
          <span>Euclidean steps</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isFactorTool && (
        <div class="advanced-tool-points" aria-label="Factor calculator highlights">
          <span>All factors</span>
          <span>Factor pairs</span>
          <span>Prime factorization</span>
          <span>Prime check</span>
        </div>
      )
    }

    {
      isRoundingTool && (
        <div class="advanced-tool-points" aria-label="Rounding calculator highlights">
          <span>Decimal places</span>
          <span>Significant figures</span>
          <span>Place value</span>
          <span>Multiple methods</span>
        </div>
      )
    }

    {
      isMatrixTool && (
        <div class="advanced-tool-points" aria-label="Matrix calculator highlights">
          <span>2x2 and 3x3</span>
          <span>Multiply matrices</span>
          <span>Determinants</span>
          <span>Transpose</span>
        </div>
      )
    }

    {
      isScientificNotationTool && (
        <div class="advanced-tool-points" aria-label="Scientific notation calculator highlights">
          <span>To scientific</span>
          <span>To standard</span>
          <span>Coefficient</span>
          <span>Exponent</span>
        </div>
      )
    }

    {
      isBigNumberTool && (
        <div class="advanced-tool-points" aria-label="Big number calculator highlights">
          <span>Exact integers</span>
          <span>Huge values</span>
          <span>Remainders</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isStatsSuiteTool && (
        <div class="advanced-tool-points" aria-label={`${tool.name} highlights`}>
          <span>Formula steps</span>
          <span>Examples included</span>
          <span>Copy results</span>
          <span>Private history</span>
        </div>
      )
    }

    {
      isGeometryTool && (
        <div class="advanced-tool-points" aria-label={`${tool.name} highlights`}>
          <span>Formula steps</span>
          <span>Examples included</span>
          <span>Copy results</span>
          <span>Private history</span>
        </div>
      )
    }

    {isCalculatorTool && <BasicCalculator variant={isKawaiiTool ? 'kawaii' : 'standard'} client:load />}
    {isPercentageTool && <PercentageCalculator client:load />}
    {isPercentErrorTool && <PercentErrorCalculator client:load />}
    {isHalfLifeTool && <HalfLifeCalculator client:load />}
    {isExponentTool && <ExponentCalculator client:load />}
    {isLogTool && <LogCalculator client:load />}
    {isRatioTool && <RatioCalculator client:load />}
    {isRootTool && <RootCalculator client:load />}
    {isQuadraticTool && <QuadraticFormulaCalculator client:load />}
    {isBinaryTool && <BinaryCalculator client:load />}
    {isHexTool && <HexCalculator client:load />}
    {isScientificTool && <ScientificCalculator client:load />}
    {isFractionTool && <FractionCalculator client:load />}
    {isRandomTool && <RandomNumberGenerator client:load />}
    {isLeastCommonMultipleTool && <NumberTheoryCalculator variant="lcm" client:load />}
    {isGreatestCommonFactorTool && <NumberTheoryCalculator variant="gcf" client:load />}
    {isFactorTool && <NumberTheoryCalculator variant="factor" client:load />}
    {isRoundingTool && <RoundingCalculator client:load />}
    {isMatrixTool && <MatrixCalculator client:load />}
    {isScientificNotationTool && <ScientificNotationCalculator client:load />}
    {isBigNumberTool && <BigNumberCalculator client:load />}
    {statsToolVariant && <StatsCalculator variant={statsToolVariant} client:load />}
    {geometryToolVariant && <GeometryCalculator variant={geometryToolVariant} client:load />}

    <section class="content-section">
      <h2>How to use the {tool.name.toLowerCase()}</h2>
      <ol class="instruction-list">
        {toolInstructions.map((instruction) => <li>{instruction}</li>)}
      </ol>
    </section>

    <section class="content-section">
      <h2>Common uses</h2>
      <div class="feature-list">
        {tool.useCases.map((useCase) => <p>{useCase}</p>)}
      </div>
    </section>

    <section class="content-section">
      <h2>Examples</h2>
      <div class="example-grid">
        {
          tool.examples.map((example) => (
            <article>
              <span>{example.label}</span>
              <strong>{example.expression}</strong>
              <p>{example.result}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class:list={['content-section', isKawaiiTool && 'kawaii-faq-section', isScientificTool && 'scientific-faq-section', isPercentageTool && 'percentage-faq-section', isPercentErrorTool && 'percent-error-faq-section', isHalfLifeTool && 'half-life-faq-section', isExponentTool && 'exponent-faq-section', isLogTool && 'log-faq-section', isRatioTool && 'ratio-faq-section', isRootTool && 'root-faq-section', isQuadraticTool && 'quadratic-faq-section', isBinaryTool && 'binary-faq-section', isHexTool && 'hex-faq-section', isFractionTool && 'fraction-faq-section', isRandomTool && 'random-faq-section', isNumberTheoryTool && 'advanced-faq-section', isRoundingTool && 'advanced-faq-section', isMatrixTool && 'advanced-faq-section', isScientificNotationTool && 'advanced-faq-section', isBigNumberTool && 'advanced-faq-section', isStatsSuiteTool && 'advanced-faq-section', isGeometryTool && 'advanced-faq-section']}>
      <div class="section-title-block">
        <h2>Frequently asked questions</h2>
        {isKawaiiTool && <p>Quick answers about the cute design, shortcuts, privacy, and copying results.</p>}
        {isScientificTool && <p>Quick answers about angle mode, supported functions, typing expressions, and privacy.</p>}
        {isPercentageTool && <p>Quick answers about percent-of, percentage change, discounts, reverse percentages, and privacy.</p>}
        {isPercentErrorTool && <p>Quick answers about formulas, accepted values, signed error, zero values, units, and privacy.</p>}
        {isHalfLifeTool && <p>Quick answers about decay formulas, units, elapsed time, solving half-life, safety limits, and privacy.</p>}
        {isExponentTool && <p>Quick answers about powers, negative exponents, zero exponents, fraction exponents, and privacy.</p>}
        {isLogTool && <p>Quick answers about valid bases, ln, log10, change-of-base, exponential checks, and privacy.</p>}
        {isRatioTool && <p>Quick answers about simplifying, equivalent ratios, splitting totals, decimals, and privacy.</p>}
        {isRootTool && <p>Quick answers about square roots, cube roots, nth roots, negative radicands, exponent form, and privacy.</p>}
        {isQuadraticTool && <p>Quick answers about the quadratic formula, discriminants, complex roots, graph details, coefficients, and privacy.</p>}
        {isBinaryTool && <p>Quick answers about base-2 numbers, arithmetic, division remainders, conversion, and privacy.</p>}
        {isHexTool && <p>Quick answers about base-16 digits, 0x inputs, arithmetic, conversion, remainders, and privacy.</p>}
        {isFractionTool && <p>Quick answers about simplifying, mixed numbers, denominators, division, and privacy.</p>}
        {isRandomTool && <p>Quick answers about ranges, unique results, exclusions, everyday randomness, and privacy.</p>}
        {isLeastCommonMultipleTool && <p>Quick answers about shared multiples, common denominators, positive integers, LCM steps, and privacy.</p>}
        {isGreatestCommonFactorTool && <p>Quick answers about shared factors, simplifying, Euclidean steps, comparing with LCM, and privacy.</p>}
        {isFactorTool && <p>Quick answers about factors, factor pairs, prime numbers, prime factorization, input limits, and privacy.</p>}
        {isRoundingTool && <p>Quick answers about decimal places, significant figures, place values, rounding methods, and privacy.</p>}
        {isMatrixTool && <p>Quick answers about matrix operations, multiplication order, determinants, supported sizes, and privacy.</p>}
        {isScientificNotationTool && <p>Quick answers about powers of 10, coefficients, exponents, standard form, and privacy.</p>}
        {isBigNumberTool && <p>Quick answers about exact integer math, huge whole numbers, division remainders, limits, and privacy.</p>}
        {isStatsSuiteTool && <p>Quick answers about formulas, inputs, examples, result copying, and private in-browser history.</p>}
        {isGeometryTool && <p>Quick answers about formulas, units, valid measurements, examples, copying, and private in-browser history.</p>}
      </div>
      <div class="faq-list">
        {
          tool.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    {relatedTools.length > 0 && (
      <section class="content-section">
        <h2>Related tools</h2>
        <div class="tool-grid">
          {relatedTools.map((relatedTool) => <ToolCard tool={relatedTool} />)}
        </div>
      </section>
    )}
  </section>
</BaseLayout>
