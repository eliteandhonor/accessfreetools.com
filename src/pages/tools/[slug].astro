    {
      tool.slug === 'income-tax-calculator' && (
        <aside class="trust-note trust-note-finance" aria-label="Income Tax Calculator 2026 federal tax-year notes">
          <strong>2026 federal numbers this page uses</strong>
          <p>
            Standard deduction: $16,100 for single or married filing separately, $32,200 for married filing jointly,
            and $24,150 for head of household. The bracket rates are 10%, 12%, 22%, 24%, 32%, 35%, and 37%.
          </p>
          <p>
            The page uses those IRS ordinary-income brackets only. It does not add state income tax, payroll tax,
            capital gains tax, withholding tables, estimated-tax penalties, AMT, or credit phaseouts.
          </p>
        </aside>
      )
    }

    {
      tool.slug === 'marriage-tax-calculator' && (
        <aside class="trust-note trust-note-finance" aria-label="Marriage Tax Calculator 2026 federal comparison notes">
          <strong>2026 federal single-vs-joint check</strong>
          <p>
            This page compares two single 2026 federal ordinary-income estimates with one married filing jointly estimate.
            For $90,000 plus $70,000, the simplified difference is $0 because the 2026 joint brackets and deduction line up closely with two single estimates.
          </p>
          <p>
            It does not compare married filing separately, state tax, payroll tax, credits, dependents, phaseouts,
            AMT, community-property rules, benefits, or whether a filing choice is right for you.
          </p>
        </aside>
      )
    }

    {
      tool.slug === 'investment-calculator' && (
        <aside class="trust-note trust-note-finance" aria-label="Investment Calculator estimate notes">
          <strong>Projection, not a promised return</strong>
          <p>
