    {
      isMatrixTool && (
        <div class="advanced-tool-points" aria-label="Matrix calculator highlights">
          <span>2x2 and 3x3</span>
          <span>Multiply matrices</span>
          <span>Determinants</span>
          <span>Transpose</span>
        </div>
      )
    }

    {
      isScientificNotationTool && (
        <div class="advanced-tool-points" aria-label="Scientific notation calculator highlights">
          <span>To scientific</span>
          <span>To standard</span>
          <span>Coefficient</span>
          <span>Exponent</span>
        </div>
      )
    }

    {
      isBigNumberTool && (
        <div class="advanced-tool-points" aria-label="Big number calculator highlights">
          <span>Exact integers</span>
          <span>Huge values</span>
          <span>Remainders</span>
          <span>Copy results</span>
        </div>
      )
    }

    {
      isStatsSuiteTool && (
        <div class="advanced-tool-points" aria-label={`${tool.name} highlights`}>
          <span>Inputs to check</span>
          <span>Example numbers</span>
          <span>Copyable answer</span>
          <span>Tab-only history</span>
        </div>
      )
    }

    {
      isGeometryTool && (
        <div class="advanced-tool-points" aria-label={`${tool.name} highlights`}>
          <span>{tool.slug === 'triangle-calculator' ? '3-side check' : 'Unit-aware inputs'}</span>
          <span>{tool.slug === 'triangle-calculator' ? 'Heron formula steps' : 'Formula note'}</span>
          <span>{tool.slug === 'triangle-calculator' ? 'Angle estimates' : 'Example numbers'}</span>
          <span>Tab-only history</span>
        </div>
      )
    }

    {
      isHealthTool && (
        <div class="advanced-tool-points health-tool-points" aria-label={`${tool.name} highlights`}>
