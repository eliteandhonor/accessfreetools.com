          <span>Example inputs</span>
          <span>Tab-only history</span>
        </div>
      )
    }

    {
      isFinanceTool && (
        <div class="advanced-tool-points finance-tool-points" aria-label={`${tool.name} highlights`}>
          <span>Estimate, not advice</span>
          <span>
