        {isQuadraticTool && <p>Quick answers about the quadratic formula, discriminants, complex roots, graph details, coefficients, and privacy.</p>}
        {isBinaryTool && <p>Quick answers about base-2 numbers, arithmetic, division remainders, conversion, and privacy.</p>}
        {isHexTool && <p>Quick answers about base-16 digits, 0x inputs, arithmetic, conversion, remainders, and privacy.</p>}
