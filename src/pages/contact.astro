---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Access Free Tools"
  description="Contact Access Free Tools for suggestions, corrections, privacy questions, disclosure questions, and site feedback."
  path="/contact/"
>
  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / Contact</p>
    <h1>Contact</h1>
    <p>
      Have a tool idea, correction, or design note? Use this page for site feedback and
      improvement requests.
    </p>
  </section>

  <section class="content-section content-section-narrow">
    <h2>Feedback</h2>
    <p>
      Send suggestions for calculators, converters, text tools, and usability improvements.
    </p>

    <h2>Email</h2>
    <p>
      General feedback: <a href="mailto:contact@accessfreetools.com">contact@accessfreetools.com</a>
    </p>
    <p>
      Privacy questions: <a href="mailto:privacy@accessfreetools.com">privacy@accessfreetools.com</a>
    </p>
    <p>
      Please do not send passwords, bank details, medical records, or other sensitive personal
      information by email.
    </p>
  </section>
</BaseLayout>
