---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Access Free Tools"
  description="Contact Access Free Tools for suggestions, corrections, privacy questions, disclosure questions, and site feedback."
  path="/contact/"
>
  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / Contact</p>
    <h1>Contact</h1>
    <p>
      Have a tool idea, correction, or design note? Use this page for site feedback and
      improvement requests.
    </p>
  </section>

  <section class="content-section content-section-narrow">
    <h2>Send a message</h2>
    <p>
      Send suggestions for calculators, converters, text tools, corrections, privacy questions,
      disclosure questions, and usability improvements.
    </p>

    <form
      class="contact-form"
      action="/api/contact"
      data-contact-form
      method="post"
    >
      <label class="contact-honeypot" aria-hidden="true">
        <span>Company</span>
        <input autocomplete="off" name="company" tabindex="-1" type="text" />
      </label>

      <div class="contact-grid">
        <label class="contact-field">
          <span>Your name</span>
          <input autocomplete="name" name="name" placeholder="Your name" type="text" />
        </label>

        <label class="contact-field">
          <span>Your email</span>
          <input autocomplete="email" name="email" placeholder="you@example.com" required type="email" />
        </label>
      </div>

      <label class="contact-field">
        <span>Topic</span>
        <select name="topic" required>
          <option value="">Choose a topic</option>
          <option value="Tool idea">Tool idea</option>
          <option value="Correction">Correction</option>
          <option value="Privacy question">Privacy question</option>
          <option value="Advertising or affiliate question">Advertising or affiliate question</option>
          <option value="General feedback">General feedback</option>
        </select>
      </label>

      <label class="contact-field">
        <span>Message</span>
        <textarea
          name="message"
          placeholder="Tell us what you noticed or what tool you would like to see next."
          required
          rows="7"
        ></textarea>
      </label>

      <div class="contact-actions">
        <button class="button-primary" type="submit">Send message</button>
        <p class="contact-status" data-contact-status role="status"></p>
      </div>
    </form>

    <p>
      Email: <a href="mailto:contact@accessfreetools.com">contact@accessfreetools.com</a>
    </p>
    <p>
      Please do not send passwords, bank details, medical records, or other sensitive personal
      information through this form or by email.
    </p>
  </section>

  <script>
    const contactForm = document.querySelector('[data-contact-form]');
    const contactStatus = document.querySelector('[data-contact-status]');

    if (contactForm instanceof HTMLFormElement && contactStatus instanceof HTMLElement) {
      contactForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submitButton = contactForm.querySelector('button[type="submit"]');
        const previousLabel = submitButton?.textContent ?? 'Send message';
        contactStatus.dataset.state = 'pending';
        contactStatus.textContent = 'Sending...';

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = 'Sending';
        }

        try {
          const formData = new FormData(contactForm);
          const payload = Object.fromEntries(formData.entries());
          const response = await fetch(contactForm.action, {
            body: JSON.stringify(payload),
            headers: {
              accept: 'application/json',
              'content-type': 'application/json',
            },
            method: 'POST',
          });
          const result = await response.json();
          contactStatus.dataset.state = response.ok ? 'success' : 'error';
          contactStatus.textContent = result.message || 'The form returned an unexpected response.';

          if (response.ok) {
            contactForm.reset();
          }
        } catch {
          contactStatus.dataset.state = 'error';
          contactStatus.textContent = 'The message could not be sent right now.';
        } finally {
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.textContent = previousLabel;
          }
        }
      });
    }
  </script>
</BaseLayout>
