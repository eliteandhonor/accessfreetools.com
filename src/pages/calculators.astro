---
export const prerender = true;
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Calculators | Access Free Tools"
  description="A shortcut to the Access Free Tools calculators category."
  path="/categories/calculators/"
  noindex
>
  <script is:inline>
    window.location.replace('/categories/calculators/');
  </script>

  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / Calculators</p>
    <h1>Free online calculators</h1>
    <p>
      This shortcut points to the main calculators category. If you are not moved automatically,
      open the calculators hub below.
    </p>
    <p><a class="card-link" href="/categories/calculators/">Open calculators</a></p>
  </section>
</BaseLayout>
