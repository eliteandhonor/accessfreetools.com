---
export const prerender = true;
import BaseLayout from '../components/BaseLayout.astro';
import { blogPosts } from '../data/blogPosts';
import { categories } from '../data/categories';
import { toolAliases } from '../data/toolAliases';
import { tools } from '../data/tools';

const liveCategoryCount = categories.filter((category) =>
  tools.some((tool) => tool.category === category.slug),
).length;
const publicToolUrlCount = tools.length + toolAliases.length;
const guideCount = blogPosts.length;

const buildRules = [
  {
    title: 'Tool first',
    text: 'The calculator, converter, checker, or generator should be useful before anyone reads a guide or sees a promotion.',
  },
  {
    title: 'Explain the inputs',
    text: 'A visitor should know what each box means, what unit belongs there, and which assumptions affect the answer.',
  },
  {
    title: 'Show a real example',
    text: 'Useful pages need a quick example because examples catch mistakes faster than a wall of formula text.',
  },
  {
    title: 'Say the limits',
    text: 'Finance, health, pregnancy, tax, construction, electrical, and AI tools are estimates unless a qualified expert says otherwise.',
  },
];

const roadmapItems = [
  {
    title: 'A bigger tool library',
    text: 'The goal is not a tiny calculator clone. The goal is a huge free utility app website with calculators, converters, AI helpers, text tools, image tools, and study tools.',
  },
  {
    title: 'Better discovery',
    text: 'As the library grows, search, categories, related tools, and blog guides need to help people find the right tool without scrolling through hundreds of cards.',
  },
  {
    title: 'Trust before revenue',
    text: 'Ads and affiliate ideas may come later, but they should never push the actual tool out of the way or make the page feel like a trap.',
  },
];
---

<BaseLayout
  title="About Access Free Tools | Free Utility App Website"
  description="Meet Access Free Tools, a growing free utility website with calculators, converters, browser AI helpers, plain guides, and tool-first pages."
  path="/about/"
>
  <section class="about-hero">
    <div class="about-hero-copy">
      <p class="breadcrumb"><a href="/">Home</a> / About</p>
      <p class="about-kicker">Free tools, built one useful page at a time</p>
      <h1>Building a giant free utility app website for everyday problems.</h1>
      <p>
        Access Free Tools exists for the small moments where people need an answer, not a sales
        funnel. Calculate a discount. Check a mortgage estimate. Convert a unit. Read text from an
        image. The site is being built to become one of the most helpful free tool libraries on the
        web, with each page clear enough for a normal person to use without guessing.
      </p>
      <div class="about-hero-actions" aria-label="About page actions">
        <a class="primary-action" href="/tools/">Browse tools</a>
        <a class="secondary-action" href="/blog/">Read guides</a>
      </div>
    </div>

    <div class="about-visual" aria-label="Access Free Tools library snapshot">
      <div class="about-visual-topline">
        <span>Access Free Tools</span>
        <strong>Library build</strong>
      </div>
      <div class="about-command-line">
        <span class="about-command-dot"></span>
        <span>find the right tool</span>
        <strong>free</strong>
      </div>
      <div class="about-stat-grid">
        <div>
          <strong>{tools.length}</strong>
          <span>canonical tools</span>
        </div>
        <div>
          <strong>{publicToolUrlCount}</strong>
          <span>public tool URLs</span>
        </div>
        <div>
          <strong>{liveCategoryCount}</strong>
          <span>active categories</span>
        </div>
        <div>
          <strong>{guideCount}</strong>
          <span>tool guides</span>
        </div>
      </div>
      <div class="about-tool-stack" aria-label="Tool library focus areas">
        <span>Calculators</span>
        <span>Converters</span>
        <span>AI helpers</span>
        <span>Text tools</span>
        <span>Image tools</span>
      </div>
    </div>
  </section>

  <section class="about-story-grid">
    <article class="about-story-panel">
      <p class="about-kicker">What this is trying to become</p>
      <h2>Not just a list of calculators.</h2>
      <p>
        A lot of utility sites are useful because they are large. That matters, but size by itself
        is not enough. Access Free Tools is trying to be large and understandable. If someone opens
        a page for <a href="/tools/wallpaper-calculator/">wallpaper waste</a>, subnet ranges,
        body mass index, percent error, ad revenue, <a href="/tools/watts-to-amps-calculator/">watts
        to amps</a>, or an OCR result, the page should explain what the answer means in plain
        English.
      </p>
      <p>
        That is the real product: quick tools with enough explanation that people can double-check
        the number before they use it for homework, a project, a budget, a post, or a decision.
      </p>
    </article>

    <aside class="about-note-panel">
      <h2>The promise</h2>
      <p>
        Keep the tool easy to reach. Keep the explanation close to the result. Keep privacy and
        limits visible. Grow the library without turning every page into clutter.
      </p>
      <a class="card-link" href="/why-access-free-tools/">Read the build standard</a>
    </aside>
  </section>

  <section class="about-section">
    <div class="about-section-header">
      <p class="about-kicker">How new pages should feel</p>
      <h2>Rules we keep coming back to.</h2>
    </div>
    <div class="about-rules-grid">
      {buildRules.map((rule) => (
        <article class="about-rule-card">
          <h3>{rule.title}</h3>
          <p>{rule.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section about-roadmap">
    <div class="about-section-header">
      <p class="about-kicker">Where it is going</p>
      <h2>The target is much bigger than today.</h2>
      <p>
        The current library is the foundation. The long-term plan is a 1000+ page utility platform
        where tools, guides, search, and category hubs work together instead of feeling like random
        pages glued onto a site.
      </p>
    </div>
    <div class="about-roadmap-grid">
      {roadmapItems.map((item) => (
        <article class="about-roadmap-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
