---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="About | Access Free Tools"
  description="Learn about Access Free Tools, a library of free calculators and everyday browser utilities."
  path="/about/"
>
  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / About</p>
    <h1>About Access Free Tools</h1>
    <p>
      Access Free Tools is a practical library of simple online utilities. The focus is speed,
      clarity, and tools that are easy to use on desktop or mobile.
    </p>
  </section>

  <section class="content-section content-section-narrow">
    <h2>How tools are made</h2>
    <p>
      Each utility uses clear controls, helpful examples, and plain-language instructions so the
      page stays useful before anything else.
    </p>
  </section>
</BaseLayout>
