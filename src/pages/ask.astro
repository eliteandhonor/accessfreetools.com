---
export const prerender = true;

import AskToolChat from '../components/AskToolChat';
import BaseLayout from '../components/BaseLayout.astro';
import { listApiTools } from '../lib/apiToolRegistry';

const tools = listApiTools().slice(0, 8);
const askChecks = [
  'The answer should come from a real tool runner, not from a model guessing the math.',
  'The response should show steps, assumptions, warnings, and a link to the matching tool page.',
  'If the question is about finance, health, pregnancy, alcohol, construction, or electrical work, treat the result as an estimate or learning aid.',
  'If the chatbot cannot route the question cleanly, use the tool library and pick the exact calculator yourself.',
];
---

<BaseLayout
  title="Ask Access Free Tools | Calculator Chatbot And Tool API"
  description="Ask a plain-English calculator or utility question. Access Free Tools routes it to a real deterministic tool and shows the answer, steps, assumptions, and link."
  path="/ask/"
>
  <section class="page-intro ask-hero">
    <p class="breadcrumb"><a href="/">Home</a> / Ask Access Free Tools</p>
    <div>
      <p class="eyebrow">Private alpha</p>
      <h1>Ask Access Free Tools</h1>
      <p>
        Ask a normal question. The chatbot chooses a real Access Free Tools utility,
        runs the deterministic calculation, and shows the answer with steps and limits.
      </p>
    </div>
  </section>

  <section class="section-band ask-layout" aria-label="Ask Access Free Tools demo">
    <div>
      <Fragment set:html="<!--INFOLINKS_OFF-->" />
      <div data-clarity-mask="true">
        <AskToolChat client:load />
      </div>
      <p class="ai-privacy-note">
        Ask may send the question you type to our hosted language-model provider so it can choose
        the right Access Free Tools utility. The calculation itself still runs through our
        deterministic tool code. Do not enter passwords, financial account details, medical
        records, or other sensitive information.
      </p>
      <Fragment set:html="<!--INFOLINKS_ON-->" />
    </div>
    <section aria-label="API-ready starter tools" class="ask-tool-panel">
      <h2>API-ready starter tools</h2>
      <p>
        This alpha starts with a focused set of calculators and developer utilities.
        More tools can be added after the shared registry proves stable.
      </p>
      <ul>
        {tools.map((tool) => <li><a href={tool.tool_url}>{tool.name}</a></li>)}
      </ul>
      <a class="card-link" href="/developers/mcp/">Developer and MCP setup</a>
    </section>
  </section>

  <section class="section-band section-band-soft">
    <div class="section-heading">
      <h2>What to check before trusting an answer</h2>
      <p>
        Ask is useful because it routes plain questions to deterministic tools. It still needs
        the same common-sense checks as the normal calculator pages.
      </p>
    </div>
    <div class="feature-list">
      {askChecks.map((check) => <p>{check}</p>)}
    </div>
  </section>
</BaseLayout>
