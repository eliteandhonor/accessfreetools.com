---
export const prerender = true;

import AskToolChat from '../components/AskToolChat';
import BaseLayout from '../components/BaseLayout.astro';
import { listApiTools } from '../lib/apiToolRegistry';

const tools = listApiTools().slice(0, 8);
---

<BaseLayout
  title="Ask Access Free Tools | Calculator Chatbot And Tool API"
  description="Ask a plain-English calculator or utility question. Access Free Tools routes it to a real deterministic tool and shows the answer, steps, assumptions, and link."
  path="/ask/"
>
  <section class="page-intro ask-hero">
    <p class="breadcrumb"><a href="/">Home</a> / Ask Access Free Tools</p>
    <div>
      <p class="eyebrow">Private alpha</p>
      <h1>Ask Access Free Tools</h1>
      <p>
        Ask a normal question. The chatbot chooses a real Access Free Tools utility,
        runs the deterministic calculation, and shows the answer with steps and limits.
      </p>
    </div>
  </section>

  <section class="section-band ask-layout" aria-label="Ask Access Free Tools demo">
    <AskToolChat client:load />
    <aside class="ask-tool-panel">
      <h2>API-ready starter tools</h2>
      <p>
        This alpha starts with a focused set of calculators and developer utilities.
        More tools can be added after the shared registry proves stable.
      </p>
      <ul>
        {tools.map((tool) => <li><a href={tool.tool_url}>{tool.name}</a></li>)}
      </ul>
      <a class="card-link" href="/developers/mcp/">Developer and MCP setup</a>
    </aside>
  </section>
</BaseLayout>
