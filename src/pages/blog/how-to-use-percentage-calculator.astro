---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import ToolArtFigure from '../../components/ToolArtFigure.astro';
import { getTool } from '../../data/tools';
import { getToolArt } from '../../data/toolArt';

const percentageCalculator = getTool('percentage-calculator');
const guideArt = getToolArt('percentage-calculator', 'guide');
const guideImageUrl = guideArt ? `https://accessfreetools.com${guideArt.imagePath}` : 'https://accessfreetools.com/social/free-guides.png';
const examples = percentageCalculator?.examples ?? [];
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Percentage Calculator Guide: Reverse Percentages',
  description:
    'Learn three reverse-percentage setups, percent change, discounts, and how to recover an original value before an increase or decrease.',
  mainEntityOfPage: 'https://accessfreetools.com/blog/how-to-use-percentage-calculator/',
  image: guideImageUrl,
  datePublished: '2026-04-30',
  dateModified: '2026-07-13',
  author: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: 'https://accessfreetools.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Access Free Tools',
  },
};
---

<BaseLayout
  title="Percentage Calculator Guide: Reverse Percentages"
  description="Reverse percentages can mean finding a whole from a part, or recovering an original value before an increase or decrease. Learn both with clear examples."
  path="/blog/how-to-use-percentage-calculator/"
  socialImagePath={guideArt?.imagePath ?? '/social/free-guides.png'}
  socialImageAlt={guideArt?.alt}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />

  <article class="blog-article">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / Reverse Percentage Guide</p>

    <header class="blog-article-header">
      <span>Reverse percentage guide</span>
      <h1>Percentage Calculator Guide: Reverse Percentages</h1>
      <p>
        A reverse percentage can ask for the whole behind a known part, or the value before a
        percentage increase or decrease. Those questions use different divisors. Pick the wrong
        one and a price that started at 100 can come back as 96.
      </p>
      <a class="button-primary" href="/tools/percentage-calculator/">Open the percentage calculator</a>
    </header>

    {guideArt && <ToolArtFigure entry={guideArt} eager={true} />}

    <div class="blog-article-layout">
      <div class="blog-article-body">
        <section class="content-section">
          <h2>Quick answer</h2>
          <p>
            Use <a href="/tools/percentage-calculator/">Percentage Calculator</a> when you need a fast
            answer for percent-of math, percent increase or decrease, a discount, a markup, or a
            reverse percentage. Reverse percent now separates a known part from a final value after
            an increase or decrease, so choose the setup that matches the wording of your problem.
          </p>
          <p>
            If the question is just a sale price, the <a href="/tools/percent-off-calculator/">Percent Off Calculator</a>
            is faster. If you are adding tax after a price, use the
            {' '}<a href="/tools/sales-tax-calculator/">Sales Tax Calculator</a>.
          </p>
        </section>

        <section class="content-section">
          <h2>Start with the mode</h2>
          <ol class="instruction-list">
            <li>Choose the percentage question that matches your problem.</li>
            <li>Type the numbers into the fields for that mode.</li>
            <li>Press Calculate percentage.</li>
            <li>Read the answer, formula line, and steps.</li>
            <li>Copy the answer if you need it in notes, homework, a message, or a spreadsheet.</li>
          </ol>
        </section>

        <section class="content-section">
          <h2>Which mode should I pick?</h2>
          <div class="feature-list">
            <p><strong>Percent of a number:</strong> answers questions like 18% of 240.</p>
            <p><strong>What percent?</strong> answers questions like 25 is what percent of 200.</p>
            <p><strong>Percentage change:</strong> compares an original value with a new value.</p>
            <p><strong>Add or subtract percent:</strong> handles discounts, markups, tax, tips, and growth.</p>
            <p><strong>Reverse percent:</strong> finds a whole from a known part, or the original value before an increase or decrease.</p>
          </div>
        </section>

        <section class="content-section">
          <h2>Five examples that cover most searches</h2>
          <div class="shortcut-table" role="table" aria-label="Percentage calculator examples">
            <div role="row">
              <strong role="cell">18% of 240</strong>
              <span role="cell">Turns 18% into 0.18, then multiplies 240 by 0.18 to get 43.2.</span>
            </div>
            <div role="row">
              <strong role="cell">25 is what % of 200</strong>
              <span role="cell">Divides 25 by 200, then multiplies by 100 to get 12.5%.</span>
            </div>
            <div role="row">
              <strong role="cell">160 to 116</strong>
              <span role="cell">Finds a drop of 44, then compares it with 160 to get a 27.5% decrease.</span>
            </div>
            <div role="row">
              <strong role="cell">120 plus 25%</strong>
              <span role="cell">Finds 25% of 120, then adds 30, so the final value is 150.</span>
            </div>
            <div role="row">
              <strong role="cell">30 is 15% of what?</strong>
              <span role="cell">Divides 30 by 0.15 to get 200.</span>
            </div>
            <div role="row">
              <strong role="cell">120 after a 20% increase</strong>
              <span role="cell">Divides 120 by 1.20 to recover the original value of 100.</span>
            </div>
            <div role="row">
              <strong role="cell">80 after a 20% decrease</strong>
              <span role="cell">Divides 80 by 0.80 to recover the original value of 100.</span>
            </div>
          </div>
        </section>

        <section class="content-section">
          <h2>Three reverse percentage formulas</h2>
          <p>
            Choose Part is % of whole when you know a part and its percentage. The original whole is
            the known part divided by the percentage as a decimal. For 30 at 15%, calculate 30 / 0.15 = 200.
          </p>
          <p>
            Choose After increase when the final value already includes a rise. A 20% increase makes
            the final value 120% of the original, so 120 / 1.20 = 100. Choose After decrease when the
            final value is smaller. A 20% decrease leaves 80%, so 80 / 0.80 = 100.
          </p>
          <p>
            Do not subtract 20% of 120 to reverse a 20% increase. That calculates 20% from the larger
            final value and returns 96. The original increase used 100 as its base, so division by 1.20
            is the correct reversal.
          </p>
        </section>

        {examples.length > 0 && (
          <section class="content-section">
            <h2>Examples from the percentage calculator</h2>
            <div class="example-grid">
              {examples.map((example) => (
                <article>
                  <span>{example.label}</span>
                  <strong>{example.expression}</strong>
                  <p>{example.result}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="content-section">
          <h2>Discounts, tips, tax, and markups</h2>
          <p>
            For a discount, choose Add or subtract percent, enter the original price, enter the
            discount percent, and choose Decrease. A $120 item with 25% off becomes $90 because
            25% of 120 is 30, and 120 - 30 = 90.
          </p>
          <p>
            For tax, tips, markup, or growth, use the same mode and choose Increase. The result
            shows the final value, and the formula line shows the amount added or subtracted.
          </p>
        </section>

        <section class="content-section">
          <h2>Percent change mistake to avoid</h2>
          <p>
            Percent change needs a starting point. If a price drops from 160 to 116, the original
            value is 160. Avoid swapping the numbers. If you reverse them, you are asking how much
            116 would need to rise to get back to 160.
          </p>
          <p>
            The whole value cannot be zero in a what-percent question. The original value cannot
            be zero in a percentage-change question. A part-of-whole reverse percentage cannot use
            0%. A reverse decrease must stay below 100% because a 100% decrease leaves no recoverable
            positive original value from the final amount.
          </p>
        </section>

        <section class="content-section">
          <h2>What the formula line means</h2>
          <p>
            The calculator shows the short math behind the answer. For percent-of questions, it
            uses value x percent / 100. For what-percent questions, it uses part / whole x 100.
            For percent change, it divides the change by the original value. Then it turns that
            result into a percent.
          </p>
          <p>
            This matches the school idea of percent as "per 100." OpenStax explains percent this
            way. Khan Academy uses the same part, whole, increase, and decrease setup in percent
            practice.
          </p>
        </section>

        <section class="content-section">
          <h2>Double-check before using the result</h2>
          <p>
            Double-check the mode, the starting value, and the sign on the result. A decrease
            should look like a decrease. A markup should make the number bigger. A discount should
            make it smaller.
          </p>
          <p>
            Avoid using this page as the final rule for a store, class, tax form, or business
            policy. The calculator shows the math. The real rule still comes from the receipt,
            teacher, spreadsheet, or official policy.
          </p>
        </section>

        <section class="content-section">
          <h2>History, privacy, and copying</h2>
          <p>
            Recent percentage answers stay visible in the current page while you work. This is
            useful when comparing discounts, prices, growth rates, or percentage changes. The tool
            keeps only a short list in the current browser tab. It is not sent to a server.
          </p>
          <p>
            Copy answer copies the displayed answer to your clipboard so you can paste it into
            notes, homework, a spreadsheet, or a message.
          </p>
        </section>

        <section class="content-section">
          <h2>Sources and limits</h2>
          <p>
            This guide checked the page against
            {' '}<a href="https://openstax.org/books/contemporary-mathematics/pages/6-1-understanding-percent">OpenStax percent basics</a>,
            {' '}<a href="https://openstax.org/books/prealgebra-2e/pages/6-2-solve-general-applications-of-percent">OpenStax percent applications</a>,
            {' '}<a href="https://www.khanacademy.org/e/percentage-change-word-problems">Khan Academy percentage-change practice</a>, and
            {' '}<a href="https://www.bbc.co.uk/bitesize/guides/z8tv6yc/revision/1">BBC Bitesize reverse percentages</a>.
          </p>
          <p>
            The calculator is for checking math. That is the limit. It does not decide the real store price, tax rule,
            coupon rule, school grading rule, or business markup policy for you.
          </p>
        </section>
      </div>

      <aside class="article-sidecar" aria-label="Related tool links">
        <h2>Open the tool</h2>
        <p>Use the percentage calculator while the numbers are still in front of you.</p>
        <a class="button-primary" href="/tools/percentage-calculator/">Percentage Calculator</a>
      </aside>
    </div>
  </article>
</BaseLayout>
