---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import BlogSearch from '../../components/BlogSearch';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import { blogPosts } from '../../data/blogPosts';
import { editorialBlogPosts } from '../../data/editorialBlogPosts';
import { getBlogSearchIndex } from '../../data/blogSearchIndex';
import '../../styles/home-blog-discovery.css';

const blogSearchIndex = getBlogSearchIndex();
const initialBlogPosts = blogSearchIndex.slice(0, 12);
const collectionItems = [...editorialBlogPosts, ...blogPosts];
const guideShortcuts = [
  { href: '/blog/how-to-use-percentage-calculator/', title: 'Discounts and percentages' },
  { href: '/blog/how-to-use-mortgage-calculator/', title: 'Mortgage payment assumptions' },
  { href: '/blog/how-to-use-fraction-calculator/', title: 'Fraction examples' },
  { href: '/blog/how-to-use-image-to-text-ocr-tool/', title: 'Clearer OCR results' },
  { href: '/blog/how-to-use-wallpaper-calculator/', title: 'Wallpaper coverage and waste' },
  { href: '/blog/how-to-use-watts-to-amps-calculator/', title: 'Watts, amps, and electrical limits' },
  { href: '/blog/how-to-use-personal-loan-calculator/', title: 'Loan payments and borrowing limits' },
  { href: '/hubs/electrical-calculators/', title: 'Electrical workflows and safety limits' },
];
---

<BaseLayout
  title="Free Calculator Guides & Utility How-Tos | Access Free Tools"
  description="Browse free calculator guides, utility how-tos, browser AI guides, and owner notes from Access Free Tools."
  path="/blog/"
>
  <BreadcrumbStructuredData items={[{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }]} />
  <CollectionStructuredData
    name="Guides and practical articles"
    description="Free calculator and utility guides plus owner notes from Access Free Tools."
    path="/blog/"
    maxItems={100}
    items={collectionItems.map(post => ({ name: post.title, path: `/blog/${post.slug}/`, description: post.summary }))}
  />
  <section class="blog-hub task-first-blog">
    <header class="blog-hero">
      <p class="breadcrumb"><a href="/">Home</a> / Blog</p>
      <h1>Guides and practical articles</h1>
      <p>Check an example, understand a formula, or read a project note. Browse {blogPosts.length} tool guides and {editorialBlogPosts.length} articles.</p>
    </header>
    <BlogSearch posts={initialBlogPosts} searchIndexUrl="/blog-search-index.json" totalPostCount={blogSearchIndex.length} client:load />
    <section class="blog-guide-starts" aria-labelledby="blog-guide-starts-heading">
      <h2 id="blog-guide-starts-heading">Start with a question</h2>
      <p>These guides explain the inputs and the limits behind the result.</p>
      <nav class="blog-guide-shortcuts" aria-label="Guide starting points">
        {guideShortcuts.map(guide => <a href={guide.href}>{guide.title}</a>)}
      </nav>
      <p><a href="/tools/">Find a tool to use now</a> or <a href="/categories/">browse tools by subject</a>.</p>
    </section>
  </section>
</BaseLayout>
