const title = 'How I Check a GitHub Project Before Installing It';
const description =
  'Brendan Chambers shares the practical repository, license, script, dependency, and sandbox checks he uses before installing a GitHub project.';
const imagePath = '/social/how-to-check-github-project-before-installing.webp';
