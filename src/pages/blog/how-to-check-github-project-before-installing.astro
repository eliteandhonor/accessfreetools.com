  { href: 'https://github.com/ossf/scorecard', label: 'OpenSSF Scorecard' },
  { href: 'https://docs.npmjs.com/cli/v11/using-npm/scripts/', label: 'npm documentation: Scripts' },
  { href: 'https://github.com/Bhanunamikaze/Agentic-SEO-Skill', label: 'Agentic SEO Skill on GitHub' },
