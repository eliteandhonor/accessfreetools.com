];
const relatedLinks = [
  {
    href: '/blog/open-source-projects-behind-access-free-tools/',
    label: 'The open-source projects behind this site',
    description: 'See which projects made it through this sort of review and what job each one has.',
  },
  {
    href: '/blog/free-ai-skills-open-source-tools-organic-growth/',
