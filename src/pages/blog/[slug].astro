---
import CalculatorGuideArticle from '../../components/CalculatorGuideArticle.astro';
import DailyEditorialArticle from '../../components/DailyEditorialArticle.astro';
import { dailyEditorialArticles, type DailyEditorialArticle as DailyArticle } from '../../data/dailyEditorialArticles';
import { aiBlogGuides, type AiGuideDefinition } from '../../data/aiBlogGuides';
import { isRedirectedBlogGuideSlug } from '../../data/blogGuideCanonicals';
import { financeBlogGuides, type FinanceGuideDefinition } from '../../data/financeBlogGuides';
import { healthBlogGuides, type HealthGuideDefinition } from '../../data/healthBlogGuides';
import { utilityBlogGuides, type UtilityGuideDefinition } from '../../data/utilityBlogGuides';

export const prerender = true;

export function getStaticPaths() {
  const dynamicBlogGuides = [...financeBlogGuides, ...healthBlogGuides, ...utilityBlogGuides, ...aiBlogGuides].filter(
    (guide) => !isRedirectedBlogGuideSlug(guide.slug),
  );

  return [...dynamicBlogGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  })), ...dailyEditorialArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))];
}

interface Props {
  guide?: FinanceGuideDefinition | HealthGuideDefinition | UtilityGuideDefinition | AiGuideDefinition;
  article?: DailyArticle;
}

const { guide, article } = Astro.props;
---

{article ? <DailyEditorialArticle article={article} /> : guide && <CalculatorGuideArticle
  toolSlug={guide.toolSlug}
  label={guide.label}
  title={guide.title}
  description={guide.description}
  path={guide.path}
  intro={guide.intro}
  quickStart={guide.quickStart}
  sections={guide.sections}
  sidecarText={guide.sidecarText}
  faqItems={'faqItems' in guide ? guide.faqItems : undefined}
  faqDisplayCount={'faqDisplayCount' in guide ? guide.faqDisplayCount : undefined}
  bestUsesIntro={'bestUsesIntro' in guide ? guide.bestUsesIntro : undefined}
/>}
