---
export const prerender = true;
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import { getBlogGuideSlugForTool } from '../../data/blogGuideCanonicals';
import { blogPosts } from '../../data/blogPosts';
import { categories } from '../../data/categories';
import { tools } from '../../data/tools';
import { toolMatchesDiscoveryCategory } from '../../lib/toolDiscovery';
import '../../styles/category-index-discovery.css';

const liveCategories = categories.filter(category =>
  tools.some(tool => toolMatchesDiscoveryCategory(tool, category.slug)),
);
const categoryStats = liveCategories.map(category => {
  const categoryTools = tools.filter(tool => toolMatchesDiscoveryCategory(tool, category.slug));
  const guideSlugs = new Set(categoryTools.map(tool => getBlogGuideSlugForTool(tool.slug)));
  return {
    ...category,
    toolCount: categoryTools.length,
    guideCount: blogPosts.filter(post => guideSlugs.has(post.slug)).length,
    featuredTools: categoryTools.slice(0, category.slug === 'image-tools' ? 5 : 3),
  };
});
const contextHeavyPaths = [
  {
    href: '/tools/watts-to-amps-calculator/',
    title: 'Watts to Amps Calculator',
    text: 'Use watts, volts, phase type, and power factor to estimate current. This is not an electrical safety check.',
  },
  {
    href: '/blog/how-to-use-watts-to-amps-calculator/',
    title: 'Watts to amps guide',
    text: 'Read why voltage and phase can change the result, and check the electrical limits before using an estimate around real equipment.',
  },
  {
    href: '/tools/wallpaper-calculator/',
    title: 'Wallpaper Calculator',
    text: 'Estimate rolls from room size, doors, windows, usable roll coverage, and waste percent.',
  },
  {
    href: '/blog/how-to-use-wallpaper-calculator/',
    title: 'Wallpaper calculator guide',
    text: 'Allow for pattern repeat when choosing usable coverage and waste. Check the supplier instructions and dye lots before buying rolls.',
  },
];
---

<BaseLayout
  title="Tool Categories | Access Free Tools"
  description="Browse Access Free Tools by task, including calculators, converters, finance, health, home projects, developer tools, AI tools, and study helpers."
  path="/categories/"
>
  <BreadcrumbStructuredData items={[{ name: 'Home', path: '/' }, { name: 'Categories', path: '/categories/' }]} />
  <CollectionStructuredData
    name="Tool Categories"
    description="Browse Access Free Tools by category."
    path="/categories/"
    items={liveCategories.map(category => ({ name: category.name, path: `/categories/${category.slug}/`, description: category.summary }))}
  />

  <div class="category-index-discovery">
    <section class="category-index-opening" aria-labelledby="category-index-heading">
      <p class="breadcrumb"><a href="/">Home</a> / Categories</p>
      <h1 id="category-index-heading">Tool Categories</h1>
      <p>Choose a subject or search for the task you want to finish.</p>
      <form class="category-index-search" action="/tools/" method="get" role="search">
        <label for="category-tool-search">Search free tools</label>
        <div>
          <input id="category-tool-search" name="q" type="search" placeholder="Try percentage discount or image to text" />
          <button class="button-primary" type="submit">Search</button>
        </div>
      </form>
      <nav class="category-index-choices" aria-label="Choose a tool category">
        {categoryStats.map(category => (
          <a href={`/categories/${category.slug}/`} data-category-slug={category.slug}>
            <strong>{category.name}</strong>
            <span class="category-index-count">{category.toolCount}<span class="sr-only"> tools</span></span>
          </a>
        ))}
      </nav>
      <p class="category-index-count-note">Numbers show tools available in each category. Some tools fit more than one category.</p>
    </section>

    <section class="category-index-examples" aria-labelledby="category-index-examples-heading">
      <h2 id="category-index-examples-heading">Explore examples</h2>
      <p>Open the details when you want to compare subjects and see a few tools in each.</p>
      <details class="category-index-inventory">
        <summary>View category descriptions and tool examples</summary>
        <div class="category-index-example-grid">
          {categoryStats.map(category => (
            <article data-category-slug={category.slug}>
              <h3><a href={`/categories/${category.slug}/`}>{category.name}</a></h3>
              <p>{category.summary}</p>
              <p class="category-index-example-count">{category.toolCount} tools and {category.guideCount} guides</p>
              <ul>
                {category.featuredTools.map(tool => (
                  <li><a href={`/tools/${tool.slug}/`}>{tool.name}</a><span>{tool.summary}</span></li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </details>
    </section>

    <section class="category-index-context" aria-labelledby="category-index-context-heading">
      <h2 id="category-index-context-heading">Check the assumptions</h2>
      <p>Construction and electrical tools provide planning estimates. Use the guide to understand what the result leaves out.</p>
      <div class="category-index-context-links">
        {contextHeavyPaths.map(item => <a href={item.href}><strong>{item.title}</strong><span>{item.text}</span></a>)}
      </div>
      <p class="category-index-resource"><a href="/free-calculator-resources/">Free Calculator Resources</a> has links for students, teachers, writers, and community projects.</p>
    </section>
  </div>
</BaseLayout>
