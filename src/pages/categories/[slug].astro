---
import BaseLayout from '../../components/BaseLayout.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import CollectionStructuredData from '../../components/CollectionStructuredData.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getBlogGuideSlugForTool } from '../../data/blogGuideCanonicals';
import { blogPosts } from '../../data/blogPosts';
import { categories, getCategory, type ToolCategory } from '../../data/categories';
import { getToolsByCategory, tools } from '../../data/tools';

export const prerender = true;

export function getStaticPaths() {
  return categories
    .filter((category) => tools.some((tool) => tool.category === category.slug))
    .map((category) => ({
      params: { slug: category.slug },
      props: { category },
    }));
}

interface Props {
  category: ToolCategory;
}

const { category } = Astro.props;
const categoryTools = getToolsByCategory(category.slug);
const categoryName = getCategory(category.slug)?.name ?? category.name;
