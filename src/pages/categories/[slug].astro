    'Practical notes for export dimensions, color states, and platform-specific requirements.',
  ],
  'ai-tools': [
    'Browser-only AI helpers for OCR, text summaries, sentiment, language checks, image labels, and writing feedback.',
    'Local-first workflows where text or images are not uploaded to Access Free Tools.',
    'Plain-language model limits so visitors know when to double-check an AI result.',
  ],
  converters: [
    'Fast metric and U.S. customary conversions for length, mass, volume, temperature, and future unit tools.',
    'Formula steps that show whether a conversion uses a factor or a temperature offset.',
    'Clear caveats for regulated, scientific, lab, engineering, or legal measurement work.',
  ],
};
const taskNotes = categoryTasks[category.slug] ?? [
  'Fast tools grouped by the task visitors are trying to complete.',
  'Clear summaries, examples, and related guides for the tools in this category.',
  'A growing category hub that can expand into subtopics as Access Free Tools grows.',
];
---

<BaseLayout
  title={categorySeo.title}
  description={categorySeo.description}
  path={`/categories/${category.slug}/`}
>
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Categories', path: '/categories/' },
      { name: category.name, path: `/categories/${category.slug}/` },
    ]}
  />
  <CollectionStructuredData
    name={categorySeo.heading}
    description={categorySeo.description}
    path={`/categories/${category.slug}/`}
    items={categoryTools.map((tool) => ({
      name: tool.name,
      path: `/tools/${tool.slug}/`,
      description: tool.summary,
    }))}
  />

  <section class="page-intro">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/categories/">Categories</a></p>
    <h1>{categorySeo.heading}</h1>
    <p>{categorySeo.intro}</p>
  </section>

  {
    category.slug === 'calculators' && (
      <section class="visual-seo-strip" aria-labelledby="calculator-intent-heading">
        <div>
          <h2 id="calculator-intent-heading">Find the right calculator faster</h2>
          <p>
            Pick the path that matches the question you are trying to answer. It is faster than
            opening a giant list and guessing which page fits.
          </p>
        </div>
        <div class="visual-seo-links">
          {calculatorIntentLinks.map((link) => (
            <a href={link.href}>
              <strong>{link.title}</strong>
              <span>{link.text}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    categoryIntent && (
      <section class="visual-seo-strip" aria-labelledby={`${category.slug}-intent-heading`}>
        <div>
          <h2 id={`${category.slug}-intent-heading`}>{categoryIntent.heading}</h2>
          <p>{categoryIntent.text}</p>
        </div>
        <div class="visual-seo-links">
          {categoryIntent.links.map((link) => (
            <a href={link.href}>
              <strong>{link.title}</strong>
              <span>{link.text}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="category-overview section-band section-band-soft">
    <div class="category-stat-grid" aria-label={`${category.name} category summary`}>
      <article>
        <span>{categoryTools.length}</span>
        <p>{categoryTools.length === 1 ? 'tool' : 'tools'} available</p>
      </article>
      <article>
        <span>{categoryGuides.length}</span>
        <p>{categoryGuides.length === 1 ? 'guide' : 'guides'} available</p>
      </article>
      <article>
        <span>Free</span>
        <p>No signup needed</p>
      </article>
    </div>

    {
      categoryTrustNote && (
        <aside class={`trust-note ${categoryTrustNote.className}`} aria-label={`${category.name} trust note`}>
          <strong>{categoryTrustNote.title}</strong>
          <p>{categoryTrustNote.text}</p>
        </aside>
      )
    }

    {
      category.slug === 'calculators' && (
        <div class="category-context-grid">
          <div>
            <h2>Popular calculator paths</h2>
            <p>
              These links match the main ways people search for free calculators: simple everyday math, percentage
              problems, scientific functions, money estimates, health estimates, and unit conversion.
            </p>
          </div>
          <div>
            <h2>Start by task</h2>
            <div class="category-link-list">
              {calculatorHubLinks.map((link) => (
                <a href={link.href}>
                  <strong>{link.title}</strong>
                  <span>{link.text}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {
      categoryGuideLinks && (
        <div class="category-context-grid">
          <div>
            <h2>{categoryGuideLinks.heading}</h2>
            <p>{categoryGuideLinks.text}</p>
          </div>
          <div>
            <h2>Priority guides</h2>
            <div class="category-link-list">
              {categoryGuideLinks.links.map((link) => (
                <a href={link.href}>
                  <strong>{link.title}</strong>
                  <span>{link.text}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )
    }

    <div class="category-context-grid">
      <div>
        <h2>What this category helps with</h2>
        <ul class="guide-bullet-list">
          {taskNotes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
      <div>
        <h2>Start with these tools</h2>
        <div class="category-link-list">
          {topTools.map((tool) => (
            <a href={`/tools/${tool.slug}/`}>
              <strong>{tool.name}</strong>
              <span>{tool.summary}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="section-heading">
      <h2>{allToolsHeading}</h2>
      <p>Open a tool, try the examples, then use the matching guide when you need more explanation.</p>
    </div>
    <div class="tool-grid">
      {categoryTools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>

  {
    categoryGuides.length > 0 && (
      <section class="section-band category-guide-band">
        <div class="section-heading">
          <h2>Guides for this category</h2>
          <p>Each guide uses its matching tool, with example numbers and plain limits.</p>
        </div>
        <div class="blog-list-grid">
          {categoryGuides.slice(0, 9).map((post) => (
            <article class="blog-post-card">
              <span>{post.label}</span>
              <h2>
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              </h2>
              <p>{post.summary}</p>
              <a class="card-link" href={`/blog/${post.slug}/`}>
                Read {post.label}
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
