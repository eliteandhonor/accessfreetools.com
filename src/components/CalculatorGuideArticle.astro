---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbStructuredData from './BreadcrumbStructuredData.astro';
import ToolArtFigure from './ToolArtFigure.astro';
import { getCategory } from '../data/categories';
import { formatDisplayDate, getBlogDates } from '../data/siteDates';
import { getDeepAuditRecord } from '../data/toolDeepAudit';
import { getToolArt } from '../data/toolArt';
import { getTool } from '../data/tools';

interface GuideSection {
  title: string;
  paragraphs: string[];
  bullets?: string[];
  links?: Array<{
    href: string;
    label: string;
  }>;
}

interface Props {
  toolSlug: string;
  label: string;
  title: string;
  description: string;
  path: string;
  intro: string;
  quickStart: string[];
  sections: GuideSection[];
  sidecarText: string;
}

const {
  toolSlug,
  label,
  title,
  description,
  path,
  intro,
  quickStart,
  sections,
  sidecarText,
} = Astro.props;
const tool = getTool(toolSlug);
const category = tool ? getCategory(tool.category) : undefined;
const examples = tool?.examples ?? [];
const useCases = tool?.useCases ?? [];
const faqItems = tool?.faq ?? [];
const auditRecord = getDeepAuditRecord(toolSlug);
const hasManualDeepReview = auditRecord?.status === 'deep-reviewed';
const hasSourceSection = sections.some((section) => /research|reference|source/i.test(section.title));
const relatedTools = (tool?.relatedSlugs ?? [])
  .map((relatedSlug) => getTool(relatedSlug))
  .filter((relatedTool): relatedTool is NonNullable<typeof relatedTool> => Boolean(relatedTool));
const articleDates = getBlogDates(path.match(/^\/blog\/([^/]+)\/?$/)?.[1] ?? '');
const guideArt = tool ? getToolArt(tool.slug, 'guide') : undefined;
const imageUrl = guideArt
  ? `https://accessfreetools.com${guideArt.imagePath}`
  : 'https://accessfreetools.com/social/free-guides.png';
const defaultPageTitle = `${title} | Access Free Tools`;
const compactPageTitle = tool ? `${tool.name} Guide | Access Free Tools` : defaultPageTitle;
const seoPageTitle =
  defaultPageTitle.length > 65 && compactPageTitle.length < defaultPageTitle.length
    ? compactPageTitle
    : defaultPageTitle;
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  mainEntityOfPage: `https://accessfreetools.com${path}`,
  image: imageUrl,
  datePublished: articleDates.published,
  dateModified: articleDates.modified,
  author: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: 'https://accessfreetools.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: 'https://accessfreetools.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://accessfreetools.com/favicon.svg',
    },
  },
};
---

<BaseLayout
  title={seoPageTitle}
  description={description}
  path={path}
  socialImagePath={guideArt?.imagePath ?? '/social/free-guides.png'}
  socialImageAlt={guideArt?.alt}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: title, path },
    ]}
  />

  <article class="blog-article">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {label}</p>

    <header class="blog-article-header">
      <span>{label}</span>
      <h1>{title}</h1>
      <p class="article-meta-line">Access Free Tools editorial guide. Updated {formatDisplayDate(articleDates.modified)}.</p>
      <p>{intro}</p>
      {tool && <a class="button-primary" href={`/tools/${tool.slug}/`}>Open the {tool.name}</a>}
    </header>

    {guideArt && <ToolArtFigure entry={guideArt} eager={true} />}

    <div class="blog-article-layout">
      <div class="blog-article-body">
        <section class="content-section">
          <h2>Quick start</h2>
          <ol class="instruction-list">
            {quickStart.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        {useCases.length > 0 && (
          <section class="content-section">
            <h2>Best uses</h2>
            <p>
              These are the situations this tool is meant for. If your task is close to one of
              these, the examples and notes below can help you choose the right inputs.
            </p>
            <ul class="guide-bullet-list">
              {useCases.slice(0, 4).map((useCase) => <li>{useCase}</li>)}
            </ul>
          </section>
        )}

        {sections.map((section) => (
          <section class="content-section">
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && section.bullets.length > 0 && (
              <ul class="guide-bullet-list">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            {section.links && section.links.length > 0 && (
              <ul class="source-link-list">
                {section.links.map((link) => {
                  const isExternal = /^https?:\/\//i.test(link.href);

                  return (
                    <li>
                      {isExternal ? (
                        <a href={link.href} rel="noreferrer" target="_blank">{link.label}</a>
                      ) : (
                        <a href={link.href}>{link.label}</a>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
        ))}

        {examples.length > 0 && (
          <section class="content-section">
            <h2>Examples from the calculator</h2>
            <div class="example-grid">
              {examples.map((example) => (
                <article>
                  <span>{example.label}</span>
                  <strong>{example.expression}</strong>
                  <p>{example.result}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {faqItems.length > 0 && (
          <section class="content-section">
            <h2>FAQ in plain language</h2>
            <div class="guide-question-list">
              {faqItems.slice(0, 6).map((item) => (
                <article>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {auditRecord && auditRecord.sources.length > 0 && !hasSourceSection && (
          <section class="content-section">
            <h2>{hasManualDeepReview ? 'Review sources' : 'Reference sources'}</h2>
            {hasManualDeepReview ? (
              <p>
                This guide is reviewed against formula, input, FAQ, blog, UI, SEO, and privacy
                checks. These references shaped the latest review.
              </p>
            ) : (
              <p>
                These references support the formula, input, FAQ, blog, SEO, and privacy checks
                for this guide. Manual deep reviews are tracked separately for tool-specific visual
                polish and edge-case testing.
              </p>
            )}
            <ul class="source-link-list">
              {auditRecord.sources.map((source) => (
                <li>
                  <a href={source.href} rel="noreferrer" target="_blank">{source.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {relatedTools.length > 0 && (
          <section class="content-section">
            <h2>Related tools</h2>
            <ul class="guide-link-list">
              {relatedTools.map((relatedTool) => (
                <li>
                  <a href={`/tools/${relatedTool.slug}/`}>{relatedTool.name}</a>
                  <span>{relatedTool.summary}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="content-section">
          <h2>Keep exploring</h2>
          <p>
            If this guide helped but your question is slightly different, these paths keep you in
            the same useful part of the site instead of forcing you back to search.
          </p>
          <ul class="guide-link-list">
            {tool && (
              <li>
                <a href={`/categories/${tool.category}/`}>{category?.name ?? 'Related category'}</a>
                <span>Browse the full category for nearby calculators and comparison tools.</span>
              </li>
            )}
            <li>
              <a href="/tools/">All free tools</a>
              <span>Search the complete Access Free Tools library by task, category, or tool name.</span>
            </li>
            <li>
              <a href="/blog/">All calculator and utility guides</a>
              <span>Find more plain-language examples, formulas, mistakes, and result explanations.</span>
            </li>
            <li>
              <a href="/free-calculator-resources/">Free calculator resources</a>
              <span>Use the resource hub when you want a broader starting point for calculator pages.</span>
            </li>
          </ul>
        </section>

        <section class="content-section">
          <h2>Privacy and copying results</h2>
          <p>
            Recent answers stay visible only while you work in the current browser tab. They are
            not sent to a server.
          </p>
          <p>
            Use Copy answer when you want to paste the expression and result into notes, homework,
            a message, or another document. Check the units and assumptions before copying.
          </p>
        </section>
      </div>

      <aside class="article-sidecar">
        <h2>Open the tool</h2>
        <p>{sidecarText}</p>
        {tool && <a class="button-primary" href={`/tools/${tool.slug}/`}>{tool.name}</a>}
      </aside>
    </div>
  </article>
</BaseLayout>
