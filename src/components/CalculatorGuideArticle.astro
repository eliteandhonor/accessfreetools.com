---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbStructuredData from './BreadcrumbStructuredData.astro';
import ToolArtFigure from './ToolArtFigure.astro';
import { getCategory } from '../data/categories';
import { formatDisplayDate, getBlogDates } from '../data/siteDates';
import { getDeepAuditRecord } from '../data/toolDeepAudit';
import { getToolArt } from '../data/toolArt';
import { getTool } from '../data/tools';

interface GuideSection {
  title: string;
  paragraphs: string[];
  bullets?: string[];
  links?: Array<{
    href: string;
    label: string;
  }>;
}

interface GuideFaqItem {
  question: string;
  answer: string;
}

interface Props {
  toolSlug: string;
  label: string;
  title: string;
  description: string;
  path: string;
  intro: string;
  quickStart: string[];
  sections: GuideSection[];
  sidecarText: string;
  faqItems?: GuideFaqItem[];
  bestUsesIntro?: string;
  keepExploringIntro?: string;
}

const {
  toolSlug,
  label,
  title,
  description,
  path,
  intro,
  quickStart,
  sections,
  sidecarText,
  faqItems: customFaqItems,
  bestUsesIntro,
  keepExploringIntro,
} = Astro.props;
const tool = getTool(toolSlug);
const category = tool ? getCategory(tool.category) : undefined;
const examples = tool?.examples ?? [];
const examplesHeading = tool ? `Worked examples for ${tool.name}` : 'Worked examples';
const useCases = tool?.useCases ?? [];
const faqItems = customFaqItems ?? tool?.faq ?? [];
const auditRecord = getDeepAuditRecord(toolSlug);
const hasManualDeepReview = auditRecord?.status === 'deep-reviewed';
const hasSourceSection = sections.some((section) => /research|reference|source/i.test(section.title));
const relatedTools = (tool?.relatedSlugs ?? [])
  .map((relatedSlug) => getTool(relatedSlug))
  .filter((relatedTool): relatedTool is NonNullable<typeof relatedTool> => Boolean(relatedTool));
const articleDates = getBlogDates(path.match(/^\/blog\/([^/]+)\/?$/)?.[1] ?? '');
const guideArt = tool ? getToolArt(tool.slug, 'guide') : undefined;
const isCalculatorGuide = Boolean(tool && (tool.name.endsWith('Calculator') || tool.category === 'calculators'));
const categoryBrowseText =
  tool?.category === 'text-tools'
    ? 'Browse the full category for nearby text tools and editing checks.'
    : 'Browse the full category for related tools that help with the same job.';
const allGuidesLabel = isCalculatorGuide ? 'All calculator and utility guides' : 'All tool and utility guides';
const allGuidesText = isCalculatorGuide
  ? 'Find more plain-language examples, formulas, mistakes, and result explanations.'
  : 'Find more plain-language examples, logic notes, mistakes, and result explanations.';
const resourcesLabel = isCalculatorGuide ? 'Free calculator resources' : 'Free tool resources';
const resourcesText = isCalculatorGuide
  ? 'Start here when you are not sure which calculator page fits.'
  : 'Start here when you are not sure which tool page fits.';
const guidePrivacyCopyBySlug: Partial<Record<string, string>> = {
  'business-loan-calculator':
    'Use Copy answer when you want to save the monthly payment, total interest, origination fee, cash received, and total cost with fee. Check the written lender offer before treating the estimate as approval or an exact cost.',
  'auto-loan-calculator':
    'Use Copy answer when you want to save the payment, amount financed, sales tax, total interest, and total paid. Check the written lender or dealer offer before treating the estimate as a real approval.',
  'age-calculator':
    'Use Copy answer when you want to save the birth date, as-of date, exact age, total days, or next birthday note. Check the cutoff date and any official rule before using it on a form.',
  'height-calculator':
    'Use Copy answer when you want to save the parent heights, estimated adult height, centimeter value, or rough range. Check the child estimate type and growth-chart context before using it in a serious health conversation.',
  'bra-size-calculator':
    'Use Copy answer when you want to save the underbust, bust, band, cup, and bust-minus-band estimate before comparing nearby sizes with the exact brand chart. Use initials or notes instead of personal details when privacy matters.',
  'sleep-calculator':
    'Use Copy answer when you want to save the suggested bedtime or wake-up time, sleep-time line, and fall-asleep buffer. If sleep problems keep happening, the next step is a sleep diary or healthcare provider, not more cycle math.',
  'ad-revenue-calculator':
    'Use Copy answer when you want to save the monthly estimate, daily estimate, estimated clicks, and page RPM. Check your ad account reports before treating any estimate as real earnings.',
  'love-calculator':
    'Use Copy answer only if you want to save the game score for yourself. Do not use it to tease, pressure, or embarrass someone else, and use nicknames or initials when privacy matters.',
  'roofing-calculator':
    'Use Copy answer when you want to save the roof squares, bundle count, pitch factor, and waste percent before checking the real roof, product wrapper, and local rules. Do not treat it as a contractor takeoff.',
  'text-case-converter':
    'Use Copy answer when you want to paste the converted text into a heading, filename, URL draft, document, message, or code-style name. Check capitalization, acronyms, punctuation, line breaks, and project rules before copying.',
  'paver-base-calculator':
    'Use Copy answer when you want to save the paver area, compacted base depth, base cubic yards, base tons, bedding sand volume, and waste percent before checking supplier sizes, compaction, drainage, and installation rules.',
  'shoe-size-conversion':
    'Use Copy answer when you want to save the measured foot length, US men, US women, UK, EU, and foot-inches estimates before comparing both nearby half sizes against the shoe brand chart.',
  'day-of-the-week-calculator':
    'Use Copy answer when you want to save the calendar date, weekday name, ISO weekday number, and Sunday-based index. Check time-zone edge cases separately when an event happens near midnight.',
  'time-zone-calculator':
    'Use Copy answer when you want to save the UTC input, converted local date and time, UTC offset, and IANA zone name. Check the original schedule or official system before relying on it for flights, legal deadlines, or critical meetings.',
  'dice-roller':
    'Use Copy answer when you want to save the dice count, sides, rolls, subtotal, modifier, and final total for notes, a game log, or a classroom example. Do not use copied rolls as official proof for gambling, legal drawings, audits, or certified random selection.',
};
const privacyCopy = {
  copy:
    (tool ? guidePrivacyCopyBySlug[tool.slug] : undefined) ??
    (tool?.category === 'text-tools'
      ? 'Use Copy answer when you want to paste the count or result into notes, schoolwork, a message, or another document. Check spacing, line breaks, emoji, byte limits, and platform rules before copying.'
      : 'Use Copy answer when you want to save the inputs and result in notes, homework, a message, or a project list. Check the units, labels, and limits before copying.'),
};
const imageUrl = guideArt
  ? `https://accessfreetools.com${guideArt.imagePath}`
  : 'https://accessfreetools.com/social/free-guides.png';
const defaultPageTitle = `${title} | Access Free Tools`;
const compactPageTitle = tool ? `${tool.name} Guide | Access Free Tools` : defaultPageTitle;
const seoPageTitle =
  defaultPageTitle.length > 65 && compactPageTitle.length < defaultPageTitle.length
    ? compactPageTitle
    : defaultPageTitle;
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  mainEntityOfPage: `https://accessfreetools.com${path}`,
  image: imageUrl,
  datePublished: articleDates.published,
  dateModified: articleDates.modified,
  author: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: 'https://accessfreetools.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: 'https://accessfreetools.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://accessfreetools.com/favicon.svg',
    },
  },
};
---

<BaseLayout
  title={seoPageTitle}
  description={description}
  path={path}
  socialImagePath={guideArt?.imagePath ?? '/social/free-guides.png'}
  socialImageAlt={guideArt?.alt}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: title, path },
    ]}
  />

  <article class="blog-article">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {label}</p>

    <header class="blog-article-header">
      <span>{label}</span>
      <h1>{title}</h1>
      <p class="article-meta-line">Updated {formatDisplayDate(articleDates.modified)}.</p>
      <p>{intro}</p>
      {tool && <a class="button-primary" href={`/tools/${tool.slug}/`}>Open the {tool.name}</a>}
    </header>

    {guideArt && <ToolArtFigure entry={guideArt} eager={true} />}

    <div class="blog-article-layout">
      <div class="blog-article-body">
        <section class="content-section">
          <h2>Quick start</h2>
          <ol class="instruction-list">
            {quickStart.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        {useCases.length > 0 && (
          <section class="content-section">
            <h2>Best uses</h2>
            <p>
              {bestUsesIntro ?? 'Start here if one of these sounds like your job. The examples below show which inputs matter most.'}
            </p>
            <ul class="guide-bullet-list">
              {useCases.slice(0, 4).map((useCase) => <li>{useCase}</li>)}
            </ul>
          </section>
        )}

        {sections.map((section) => (
          <section class="content-section">
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && section.bullets.length > 0 && (
              <ul class="guide-bullet-list">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            {section.links && section.links.length > 0 && (
              <ul class="source-link-list">
                {section.links.map((link) => {
                  const isExternal = /^https?:\/\//i.test(link.href);

                  return (
                    <li>
                      {isExternal ? (
                        <a href={link.href} rel="noreferrer" target="_blank">{link.label}</a>
                      ) : (
                        <a href={link.href}>{link.label}</a>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
        ))}

        {examples.length > 0 && (
          <section class="content-section">
            <h2>{examplesHeading}</h2>
            <div class="example-grid">
              {examples.map((example) => (
                <article>
                  <span>{example.label}</span>
                  <strong>{example.expression}</strong>
                  <p>{example.result}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {faqItems.length > 0 && (
          <section class="content-section">
            <h2>FAQ in plain language</h2>
            <div class="guide-question-list">
              {faqItems.slice(0, 7).map((item) => (
                <article>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {auditRecord && auditRecord.sources.length > 0 && !hasSourceSection && (
          <section class="content-section">
            <h2>Sources</h2>
            <p>
              Use these if you want to compare the formula, inputs, or limits with a trusted
              outside explanation.
            </p>
            <ul class="source-link-list">
              {auditRecord.sources.map((source) => (
                <li>
                  <a href={source.href} rel="noreferrer" target="_blank">{source.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {relatedTools.length > 0 && (
          <section class="content-section">
            <h2>Related tools</h2>
            <ul class="guide-link-list">
              {relatedTools.map((relatedTool) => (
                <li>
                  <a href={`/tools/${relatedTool.slug}/`}>{relatedTool.name}</a>
                  <span>{relatedTool.summary}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="content-section">
          <h2>Keep exploring</h2>
          <p>
            {keepExploringIntro ?? 'If this guide is close but not exact, these links keep you near the same kind of problem.'}
          </p>
          <ul class="guide-link-list">
            {tool && (
              <li>
                <a href={`/categories/${tool.category}/`}>{category?.name ?? 'Related category'}</a>
                <span>{categoryBrowseText}</span>
              </li>
            )}
            <li>
              <a href="/tools/">All free tools</a>
              <span>Search the complete Access Free Tools library by task, category, or tool name.</span>
            </li>
            <li>
              <a href="/blog/">{allGuidesLabel}</a>
              <span>{allGuidesText}</span>
            </li>
            <li>
              <a href="/free-calculator-resources/">{resourcesLabel}</a>
              <span>{resourcesText}</span>
            </li>
          </ul>
        </section>

        <section class="content-section">
          <h2>Privacy and copying results</h2>
          <p>
            Recent answers stay visible only while you work in the current browser tab. They are
            not sent to a server.
          </p>
          <p>
            {privacyCopy.copy}
          </p>
        </section>
      </div>

      <aside class="article-sidecar">
        <h2>Open the tool</h2>
        <p>{sidecarText}</p>
        {tool && <a class="button-primary" href={`/tools/${tool.slug}/`}>{tool.name}</a>}
      </aside>
    </div>
  </article>
</BaseLayout>
