---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbStructuredData from './BreadcrumbStructuredData.astro';
import { getTool } from '../data/tools';

interface GuideSection {
  title: string;
  paragraphs: string[];
  bullets?: string[];
  links?: Array<{
    href: string;
    label: string;
  }>;
}

interface Props {
  toolSlug: string;
  label: string;
  title: string;
  description: string;
  path: string;
  intro: string;
  quickStart: string[];
  sections: GuideSection[];
  sidecarText: string;
}

const {
  toolSlug,
  label,
  title,
  description,
  path,
  intro,
  quickStart,
  sections,
  sidecarText,
} = Astro.props;
const tool = getTool(toolSlug);
const examples = tool?.examples ?? [];
const useCases = tool?.useCases ?? [];
const faqItems = tool?.faq ?? [];
const relatedTools = (tool?.relatedSlugs ?? [])
  .map((relatedSlug) => getTool(relatedSlug))
  .filter((relatedTool): relatedTool is NonNullable<typeof relatedTool> => Boolean(relatedTool));
const updatedDate = '2026-04-29';
const imageUrl = 'https://accessfreetools.com/social-card.svg';
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  mainEntityOfPage: `https://accessfreetools.com${path}`,
  image: imageUrl,
  datePublished: updatedDate,
  dateModified: updatedDate,
  author: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: 'https://accessfreetools.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: 'https://accessfreetools.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://accessfreetools.com/favicon.svg',
    },
  },
};
---

<BaseLayout title={`${title} | Access Free Tools`} description={description} path={path}>
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  <BreadcrumbStructuredData
    items={[
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: title, path },
    ]}
  />

  <article class="blog-article">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {label}</p>

    <header class="blog-article-header">
      <span>{label}</span>
      <h1>{title}</h1>
      <p class="article-meta-line">Access Free Tools editorial guide. Updated April 29, 2026.</p>
      <p>{intro}</p>
      {tool && <a class="button-primary" href={`/tools/${tool.slug}/`}>Open the {tool.name}</a>}
    </header>

    <div class="blog-article-layout">
      <div class="blog-article-body">
        <section class="content-section">
          <h2>Quick start</h2>
          <ol class="instruction-list">
            {quickStart.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        {useCases.length > 0 && (
          <section class="content-section">
            <h2>Best uses</h2>
            <p>Use this guide when one of these tasks matches what you are trying to do.</p>
            <ul class="guide-bullet-list">
              {useCases.slice(0, 4).map((useCase) => <li>{useCase}</li>)}
            </ul>
          </section>
        )}

        {sections.map((section) => (
          <section class="content-section">
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && section.bullets.length > 0 && (
              <ul class="guide-bullet-list">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            {section.links && section.links.length > 0 && (
              <ul class="source-link-list">
                {section.links.map((link) => (
                  <li>
                    <a href={link.href} rel="noreferrer" target="_blank">{link.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {examples.length > 0 && (
          <section class="content-section">
            <h2>Examples from the calculator</h2>
            <div class="example-grid">
              {examples.map((example) => (
                <article>
                  <span>{example.label}</span>
                  <strong>{example.expression}</strong>
                  <p>{example.result}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {faqItems.length > 0 && (
          <section class="content-section">
            <h2>Common questions</h2>
            <div class="guide-question-list">
              {faqItems.slice(0, 3).map((item) => (
                <article>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {relatedTools.length > 0 && (
          <section class="content-section">
            <h2>Related tools</h2>
            <ul class="guide-link-list">
              {relatedTools.map((relatedTool) => (
                <li>
                  <a href={`/tools/${relatedTool.slug}/`}>{relatedTool.name}</a>
                  <span>{relatedTool.summary}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="content-section">
          <h2>History, privacy, and copying</h2>
          <p>
            Recent answers stay visible in the page while you work. The history is kept only in the
            current browser tab and is not sent to a server.
          </p>
          <p>
            Copy answer copies the expression and result so you can paste it into notes, homework,
            a message, or another document.
          </p>
        </section>
      </div>

      <aside class="article-sidecar">
        <h2>Open the tool</h2>
        <p>{sidecarText}</p>
        {tool && <a class="button-primary" href={`/tools/${tool.slug}/`}>{tool.name}</a>}
      </aside>
    </div>
  </article>
</BaseLayout>
