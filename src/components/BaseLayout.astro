---
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { getArticleDatesFromPath, toIsoDateTime } from '../data/siteDates';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, path = '/', ogType, noindex = false } = Astro.props;
const site = Astro.site ?? 'https://accessfreetools.com';
const canonical = new URL(path, site).toString();
const socialImage = new URL('/social-card.svg', site).toString();
const feedUrl = new URL('/feed.xml', site).toString();
const resolvedOgType = ogType ?? (path.startsWith('/blog/') && path !== '/blog/' ? 'article' : 'website');
const articleDates = getArticleDatesFromPath(path);
const siteStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${new URL('/', site).toString()}#organization`,
      name: 'Access Free Tools',
      url: new URL('/', site).toString(),
      logo: new URL('/favicon.svg', site).toString(),
    },
    {
      '@type': 'WebSite',
      '@id': `${new URL('/', site).toString()}#website`,
      name: 'Access Free Tools',
      url: new URL('/', site).toString(),
      inLanguage: 'en',
      publisher: {
        '@id': `${new URL('/', site).toString()}#organization`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d7c73" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Access Free Tools Guides" href={feedUrl} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Access Free Tools" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Access Free Tools calculator and utility workspace" />
    {resolvedOgType === 'article' && <meta property="article:published_time" content={toIsoDateTime(articleDates.published)} />}
    {resolvedOgType === 'article' && <meta property="article:modified_time" content={toIsoDateTime(articleDates.modified)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(siteStructuredData)} />
    <script is:inline>
      (() => {
        try {
          const themes = new Set([
            'fresh',
            'coral',
            'violet',
            'lagoon',
            'bloom',
            'sunrise',
            'forest',
            'slate',
            'orchid',
            'mono',
          ]);
          const storedTheme = window.localStorage.getItem('access-tools-theme');
          document.documentElement.dataset.theme = themes.has(storedTheme) ? storedTheme : 'fresh';
        } catch {
          document.documentElement.dataset.theme = 'fresh';
        }
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
