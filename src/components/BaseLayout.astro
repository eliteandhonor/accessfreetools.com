---
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import AdvertisingControls from './AdvertisingControls.astro';
import PreferredSourceCallout from './PreferredSourceCallout.astro';
import { ADSENSE_VERIFICATION_ACCOUNT, isEligiblePublicAdPath } from '../lib/monetization';
import { robotsContentForPath } from '../data/indexationPolicy';
import { verifiedOrganizationSameAs } from '../data/siteEntity';
import { getArticleDatesFromPath, toIsoDateTime } from '../data/siteDates';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  socialImagePath?: string;
  socialImageAlt?: string;
  renderSocialImage?: boolean;
  renderAdvertising?: boolean;
}

const { title, description, path = '/', ogType, noindex = false, socialImagePath, socialImageAlt, renderSocialImage = true, renderAdvertising = true } = Astro.props;
const site = Astro.site ?? 'https://accessfreetools.com';
const canonical = new URL(path, site).toString();
const robotsContent = robotsContentForPath(path, noindex);
const defaultSocialImagePath = (() => {
  if (path === '/') return '/social/access-free-tools.png';
  if (path === '/tools/') return '/social/tools-library.png';
  if (path === '/blog/' || path.startsWith('/blog/')) return '/social/free-guides.png';
  if (path === '/free-calculator-resources/' || path === '/resources/') return '/social/free-calculator-resources.png';
  if (path.startsWith('/categories/calculators/')) return '/social/free-calculators.png';
  if (path.startsWith('/categories/finance/')) return '/social/finance-calculators.png';
  if (path.startsWith('/categories/health-fitness/')) return '/social/health-calculators.png';
  if (path.startsWith('/categories/home-projects/')) return '/social/home-project-calculators.png';
  if (path.startsWith('/categories/ai-tools/')) return '/social/browser-ai-tools.png';
  if (path.startsWith('/categories/developer-tools/')) return '/social/developer-tools.png';
  return '/social/tools-library.png';
})();
const socialImage = new URL(socialImagePath ?? defaultSocialImagePath, site).toString();
const socialImageType = socialImage.endsWith('.webp')
  ? 'image/webp'
  : socialImage.endsWith('.jpg') || socialImage.endsWith('.jpeg')
    ? 'image/jpeg'
    : 'image/png';
const resolvedSocialImageAlt = socialImageAlt ?? 'Access Free Tools calculator and utility workspace';
const feedUrl = new URL('/feed.xml', site).toString();
const pinterestFeedUrl = new URL('/pinterest-feed.xml', site).toString();
const resolvedOgType = ogType ?? (path.startsWith('/blog/') && path !== '/blog/' ? 'article' : 'website');
const articleDates = getArticleDatesFromPath(path);
const shouldRenderClarity = !path.startsWith('/admin/') && path !== '/private-analytics/';
const shouldRenderAdvertising = renderAdvertising && isEligiblePublicAdPath(path);
const shouldRenderPreferredSource =
  resolvedOgType === 'article' && !/\bnoindex\b/i.test(robotsContent ?? '');
const siteStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${new URL('/', site).toString()}#organization`,
      name: 'Access Free Tools',
      url: new URL('/', site).toString(),
      logo: new URL('/favicon.png', site).toString(),
      sameAs: verifiedOrganizationSameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${new URL('/', site).toString()}#website`,
      name: 'Access Free Tools',
      url: new URL('/', site).toString(),
      inLanguage: 'en',
      publisher: {
        '@id': `${new URL('/', site).toString()}#organization`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="google-adsense-account" content={ADSENSE_VERIFICATION_ACCOUNT} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d7c73" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Access Free Tools Guides" href={feedUrl} />
    <link rel="alternate" type="application/rss+xml" title="Access Free Tools Pinterest Pins" href={pinterestFeedUrl} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Access Free Tools" />
    {renderSocialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:type" content={socialImageType} />
      <meta property="og:image:alt" content={resolvedSocialImageAlt} />
    </>}
    {resolvedOgType === 'article' && <meta property="article:published_time" content={toIsoDateTime(articleDates.published)} />}
    {resolvedOgType === 'article' && <meta property="article:modified_time" content={toIsoDateTime(articleDates.modified)} />}
    <meta name="twitter:card" content={renderSocialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {renderSocialImage && <>
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content={resolvedSocialImageAlt} />
    </>}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    {
      shouldRenderPreferredSource && (
        <script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(siteStructuredData)} />
    {
      shouldRenderClarity && (
        <script
          is:inline
          set:html={`(() => {
            const optOutKey = 'access-free-tools-analytics-opt-out';
            const allowedHosts = new Set(['accessfreetools.com', 'www.accessfreetools.com']);

            try {
              if (!allowedHosts.has(location.hostname)) return;
              if (window.localStorage.getItem(optOutKey) === 'true') return;
            } catch {
              return;
            }

            if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return;
            if (document.getElementById('clarity-script')) return;

            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
              t.id="clarity-script";
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "xg7bzx9dxo");
          })();`}
        ></script>
      )
    }
    <script is:inline>
      (() => {
        try {
          const themes = new Set([
            'fresh',
            'coral',
            'violet',
            'lagoon',
            'bloom',
            'sunrise',
            'forest',
            'slate',
            'orchid',
            'mono',
          ]);
          const storedTheme = window.localStorage.getItem('access-tools-theme');
          document.documentElement.dataset.theme = themes.has(storedTheme) ? storedTheme : 'fresh';
        } catch {
          document.documentElement.dataset.theme = 'fresh';
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const optOutKey = 'access-free-tools-analytics-opt-out';
        const analyticsHosts = new Set(['accessfreetools.com', 'www.accessfreetools.com']);
        const visitorKey = 'access-free-tools-visitor-id';
        const sessionKey = 'access-free-tools-session-id';
        const actionPattern =
          /(^=$)|\b(calculate|estimate|convert|generate|run|format|count|check|build|decode|encode|parse|roll|play|copy|equals|find|compare|analyze|summarize|classify|detect|extract|score|create)\b/i;
        const recentActions = new Map();

        const getId = (storage, key) => {
          let value = storage.getItem(key);

          if (!value) {
            value = typeof globalThis.crypto?.randomUUID === 'function'
              ? globalThis.crypto.randomUUID()
              : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
            storage.setItem(key, value);
          }

          return value;
        };

        const shouldTrack = () => {
          if (!analyticsHosts.has(location.hostname)) return false;

          try {
            if (window.localStorage.getItem(optOutKey) === 'true') return false;
          } catch {
            return false;
          }

          if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return false;
          try {
            let path = location.pathname;
            for (let pass = 0; pass < 3 && path.includes('%'); pass += 1) {
              path = decodeURIComponent(path);
            }
            if (path.includes('%')) return false;
            path = new URL(`https://accessfreetools.com${path.replace(/\\/g, '/').replace(/\/{2,}/g, '/')}`).pathname;
            if (/^\/(admin|api|mcp|private-analytics)(\/|$)/i.test(path)) return false;
          } catch {
            return false;
          }
          return true;
        };

        const sendEvent = (eventPayload) => {
          if (!shouldTrack()) return;

          try {
            const payload = {
              language: navigator.language,
              pagePath: location.pathname,
              pageTitle: document.title,
              referrer: document.referrer,
              screenHeight: window.innerHeight,
              screenWidth: window.innerWidth,
              sessionId: getId(window.sessionStorage, sessionKey),
              timezoneOffset: new Date().getTimezoneOffset(),
              visitorId: getId(window.localStorage, visitorKey),
              ...eventPayload,
            };
            const body = JSON.stringify(payload);

            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/analytics/events', new Blob([body], { type: 'application/json' }));
              return;
            }

            fetch('/api/analytics/events', {
              body,
              headers: { 'content-type': 'application/json' },
              keepalive: true,
              method: 'POST',
            }).catch(() => {});
          } catch {
            // Analytics should never get in the way of using the site.
          }
        };

        document.addEventListener('aft:tool-action', (event) => {
          if (!(event instanceof CustomEvent) || !event.detail || typeof event.detail !== 'object') return;
          if (!shouldTrack()) return;

          const cleanDetail = (value, maxLength) =>
            typeof value === 'string' ? value.trim().slice(0, maxLength) : '';
          const action = cleanDetail(event.detail.action, 80);
          const category = cleanDetail(event.detail.category, 80);
          const toolName = cleanDetail(event.detail.toolName, 120);
          const toolSlug = cleanDetail(event.detail.toolSlug, 120);
          const clarityEvent = cleanDetail(event.detail.clarityEvent, 64);
          if (!action || !toolName || !toolSlug) return;

          sendEvent({
            action,
            category,
            toolName,
            toolSlug,
            type: 'tool_action',
          });

          if (/^[a-z0-9_]{1,64}$/.test(clarityEvent)) {
            const clarity = Reflect.get(window, 'clarity');
            if (typeof clarity === 'function') clarity('event', clarityEvent);
          }
        });

        sendEvent({ type: 'page_view' });

        document.addEventListener(
          'click',
          (event) => {
            const target = event.target instanceof Element ? event.target : null;
            const surface = target?.closest('[data-aft-tool-usage-surface]');
            const actionTarget = target?.closest('button, a, input[type="button"], input[type="submit"]');
            if (!surface || !actionTarget || !surface.contains(actionTarget)) return;
            if (actionTarget.hasAttribute('data-aft-analytics-manual')) return;

            const actionLabel = (
              actionTarget.getAttribute('aria-label') ||
              actionTarget.getAttribute('title') ||
              actionTarget.value ||
              actionTarget.textContent ||
              ''
            ).trim();

            if (!actionPattern.test(actionLabel)) return;

            const key = `${surface.dataset.toolSlug || 'tool'}:${actionLabel.toLowerCase()}`;
            const now = Date.now();
            if (now - (recentActions.get(key) || 0) < 1500) return;
            recentActions.set(key, now);

            sendEvent({
              action: actionLabel.slice(0, 80),
              category: surface.dataset.toolCategory || '',
              toolName: surface.dataset.toolName || '',
              toolSlug: surface.dataset.toolSlug || '',
              type: 'tool_action',
            });
          },
          { passive: true },
        );

        document.addEventListener('submit', (event) => {
          const form = event.target instanceof Element ? event.target : null;
          const surface = form?.closest('[data-aft-tool-usage-surface]');
          if (!surface) return;

          sendEvent({
            action: 'Submit tool form',
            category: surface.dataset.toolCategory || '',
            toolName: surface.dataset.toolName || '',
            toolSlug: surface.dataset.toolSlug || '',
            type: 'tool_action',
          });
        });
      })();
    </script>
  </head>
  <body>
    <Fragment set:html="<!--INFOLINKS_OFF-->" />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <Fragment set:html="<!--INFOLINKS_ON-->" />
    <main id="main-content" tabindex="-1">
      <slot />
      {shouldRenderPreferredSource && <PreferredSourceCallout />}
    </main>
    <Fragment set:html="<!--INFOLINKS_OFF-->" />
    <SiteFooter showAdChoices={shouldRenderAdvertising} />
    {renderAdvertising && <AdvertisingControls path={path} />}
    <Fragment set:html="<!--INFOLINKS_ON-->" />
  </body>
</html>
