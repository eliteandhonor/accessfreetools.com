---
import type { ToolDefinition } from '../data/tools';
import { getCalculatorIconMark } from '../data/toolIcons';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const href = `/tools/${tool.slug}/`;
const calculatorMark = getCalculatorIconMark(tool.icon);
---

<a class="tool-card" href={href}>
  <span class:list={['tool-card-icon', calculatorMark && `tool-card-icon-${calculatorMark}`]} aria-hidden="true">
    {
      calculatorMark === 'dice' ? (
        <svg viewBox="0 0 36 36" role="img">
          <rect class="dice-body" x="7" y="7" width="22" height="22" rx="6"></rect>
          <circle class="dice-pip" cx="13" cy="13" r="2"></circle>
          <circle class="dice-pip" cx="23" cy="13" r="2"></circle>
          <circle class="dice-pip" cx="18" cy="18" r="2"></circle>
          <circle class="dice-pip" cx="13" cy="23" r="2"></circle>
          <circle class="dice-pip" cx="23" cy="23" r="2"></circle>
        </svg>
      ) : calculatorMark ? (
        <svg viewBox="0 0 36 36" role="img">
          <rect class="calculator-body" x="8" y="5" width="20" height="26" rx="4"></rect>
          <rect class="calculator-screen" x="11" y="9" width="14" height="5" rx="1.4"></rect>
          {calculatorMark === 'heart' ? (
            <path
              class="calculator-mark"
              d="M18 25.4l-4.4-4.1c-1.8-1.7-1.8-4.4.1-5.4 1.2-.7 2.8-.3 3.7.9.9-1.2 2.5-1.6 3.7-.9 1.9 1.1 1.9 3.8.1 5.4L18 25.4Z"
            ></path>
          ) : calculatorMark === 'fx' ? (
            <text class="calculator-text-mark" x="18" y="25" text-anchor="middle">fx</text>
          ) : calculatorMark === 'percent' ? (
            <text class="calculator-percent-mark" x="18" y="25.5" text-anchor="middle">%</text>
          ) : calculatorMark === 'error' ? (
            <>
              <circle class="calculator-mark" cx="18" cy="21.3" r="5.4"></circle>
              <path class="calculator-mark" d="M18 18.1v3.8"></path>
              <path class="calculator-mark" d="M18 25h.1"></path>
            </>
          ) : calculatorMark === 'power' ? (
            <text class="calculator-power-mark" x="18" y="24.4" text-anchor="middle">x^n</text>
          ) : calculatorMark === 'log' ? (
            <text class="calculator-log-mark" x="18" y="24.8" text-anchor="middle">log</text>
          ) : calculatorMark === 'root' ? (
            <text class="calculator-root-mark" x="18" y="24.8" text-anchor="middle">rt</text>
          ) : calculatorMark === 'ratio' ? (
            <text class="calculator-ratio-mark" x="18" y="24.7" text-anchor="middle">a:b</text>
          ) : calculatorMark === 'quadratic' ? (
            <text class="calculator-quadratic-mark" x="18" y="24.5" text-anchor="middle">x^2</text>
          ) : calculatorMark === 'half-life' ? (
            <text class="calculator-half-life-mark" x="18" y="24.7" text-anchor="middle">t1/2</text>
          ) : calculatorMark === 'binary' ? (
            <text class="calculator-binary-mark" x="18" y="25" text-anchor="middle">01</text>
          ) : calculatorMark === 'hex' ? (
            <text class="calculator-hex-mark" x="18" y="25" text-anchor="middle">0x</text>
          ) : calculatorMark === 'fraction' ? (
            <>
              <path class="calculator-mark" d="M13.2 21.2h9.6"></path>
              <text class="calculator-fraction-mark" x="18" y="19" text-anchor="middle">1</text>
              <text class="calculator-fraction-mark" x="18" y="27.3" text-anchor="middle">2</text>
            </>
          ) : calculatorMark === 'lcm' ? (
            <text class="calculator-lcm-mark" x="18" y="24.8" text-anchor="middle">lcm</text>
          ) : calculatorMark === 'gcf' ? (
            <text class="calculator-gcf-mark" x="18" y="24.8" text-anchor="middle">gcf</text>
          ) : calculatorMark === 'factor' ? (
            <text class="calculator-factor-mark" x="18" y="24.8" text-anchor="middle">fac</text>
          ) : calculatorMark === 'round' ? (
            <text class="calculator-round-mark" x="18" y="24.8" text-anchor="middle">rnd</text>
          ) : calculatorMark === 'matrix' ? (
            <text class="calculator-matrix-mark" x="18" y="24.8" text-anchor="middle">mat</text>
          ) : calculatorMark === 'sci-notation' ? (
            <text class="calculator-sci-notation-mark" x="18" y="24.8" text-anchor="middle">sci</text>
          ) : calculatorMark === 'big-number' ? (
            <text class="calculator-big-number-mark" x="18" y="24.8" text-anchor="middle">big</text>
          ) : calculatorMark === 'stddev' ? (
            <text class="calculator-stddev-mark" x="18" y="24.8" text-anchor="middle">sd</text>
          ) : calculatorMark === 'sequence' ? (
            <text class="calculator-sequence-mark" x="18" y="24.8" text-anchor="middle">seq</text>
          ) : calculatorMark === 'sample-size' ? (
            <text class="calculator-sample-size-mark" x="18" y="24.8" text-anchor="middle">n</text>
          ) : calculatorMark === 'probability' ? (
            <text class="calculator-probability-mark" x="18" y="24.8" text-anchor="middle">p</text>
          ) : calculatorMark === 'stats' ? (
            <text class="calculator-stats-mark" x="18" y="24.8" text-anchor="middle">stat</text>
          ) : calculatorMark === 'mean' ? (
            <text class="calculator-mean-mark" x="18" y="24.8" text-anchor="middle">xbar</text>
          ) : calculatorMark === 'permutation' ? (
            <text class="calculator-permutation-mark" x="18" y="24.8" text-anchor="middle">ncr</text>
          ) : calculatorMark === 'z-score' ? (
            <text class="calculator-z-score-mark" x="18" y="24.8" text-anchor="middle">z</text>
          ) : calculatorMark === 'confidence' ? (
            <text class="calculator-confidence-mark" x="18" y="24.8" text-anchor="middle">ci</text>
          ) : (
            <>
              <path class="calculator-mark" d="M18 16.8v8.2"></path>
              <path class="calculator-mark" d="M13.9 20.9h8.2"></path>
            </>
          )}
        </svg>
      ) : (
        <svg viewBox="0 0 36 36" role="img">
          <path class="calculator-mark" d="M23.5 8.5l4 4-12.8 12.8-5.2 1.2 1.2-5.2L23.5 8.5Z"></path>
          <path class="calculator-mark" d="M20.8 11.2l4 4"></path>
        </svg>
      )
    }
  </span>
  <span>
    <strong>{tool.name}</strong>
    <small>{tool.summary}</small>
  </span>
  <em>Open</em>
</a>
