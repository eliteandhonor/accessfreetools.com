---
import {
  AD_CONSENT_STORAGE_KEY,
  CONSENT_REGION_EXTRA_TIME_ZONES,
  HILLTOPADS_BANNER_SCRIPT_URL,
  HILLTOPADS_IN_PAGE_PUSH_SCRIPT_URL,
  parsePublicFlag,
  shouldServeHilltopAds,
} from '../lib/monetization';

interface Props {
  path: string;
}

const { path } = Astro.props;
const serveAds = shouldServeHilltopAds(path, parsePublicFlag(import.meta.env.PUBLIC_HILLTOPADS_ENABLED, true));
const clientConfig = JSON.stringify({
  bannerScriptUrl: HILLTOPADS_BANNER_SCRIPT_URL,
  consentKey: AD_CONSENT_STORAGE_KEY,
  consentRegionZones: CONSENT_REGION_EXTRA_TIME_ZONES,
  inPagePushScriptUrl: HILLTOPADS_IN_PAGE_PUSH_SCRIPT_URL,
}).replace(/</g, '\\u003c');
---

{
  serveAds && (
    <>
      <aside aria-label="Advertisement" class="advertising-banner" data-hilltopads-banner hidden>
        <p class="advertising-banner__label">
          Advertisement · <a href="/advertising-disclosure/">How advertising works</a>
        </p>
        <div class="advertising-banner__slot" data-hilltopads-banner-slot></div>
      </aside>

      <section aria-labelledby="ad-consent-title" class="ad-consent" data-ad-consent-panel hidden>
        <div>
          <strong id="ad-consent-title">Ads and cookies</strong>
          <p>
            Free tools are paid for by ads from HilltopAds. If you accept, HilltopAds and its partners
            may use cookies and device data to show ads. Tools work the same either way. You can change
            this later in the <a href="/privacy-policy/#ad-choices">Privacy Policy</a>.
          </p>
        </div>
        <div class="ad-consent__actions">
          <button class="button-primary" data-ad-consent="granted" type="button">Accept ads</button>
          <button class="button-secondary" data-ad-consent="denied" type="button">Decline</button>
        </div>
      </section>

      <script
        is:inline
        set:html={`(() => {
          const config = ${clientConfig};
          // Keep local builds and preview hosts from requesting live ads.
          if (location.hostname !== 'accessfreetools.com' && location.hostname !== 'www.accessfreetools.com') return;

          const panel = document.querySelector('[data-ad-consent-panel]');
          const readChoice = () => {
            try { return window.localStorage.getItem(config.consentKey); } catch { return null; }
          };
          const saveChoice = (value) => {
            try { window.localStorage.setItem(config.consentKey, value); } catch {}
          };
          const inConsentRegion = (() => {
            let zone = '';
            try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch {}
            if (!zone) return true;
            return zone.startsWith('Europe/') || config.consentRegionZones.includes(zone);
          })();

          const insertScript = (id, src, parent) => {
            if (document.getElementById(id)) return;
            const script = document.createElement('script');
            script.async = true;
            script.id = id;
            script.referrerPolicy = 'no-referrer-when-downgrade';
            Reflect.set(script, 'settings', {});
            script.src = src;
            parent.append(script);
          };

          const loadAds = () => {
            const banner = document.querySelector('[data-hilltopads-banner]');
            const bannerSlot = document.querySelector('[data-hilltopads-banner-slot]');
            if (banner instanceof HTMLElement && bannerSlot instanceof HTMLElement) {
              banner.hidden = false;
              insertScript('hilltopads-banner-script', config.bannerScriptUrl, bannerSlot);
            }
            insertScript('hilltopads-push-script', config.inPagePushScriptUrl, document.body);
          };

          document.querySelectorAll('[data-ad-consent]').forEach((button) => {
            button.addEventListener('click', () => {
              const choice = button.getAttribute('data-ad-consent');
              if (choice !== 'granted' && choice !== 'denied') return;
              saveChoice(choice);
              if (panel instanceof HTMLElement) panel.hidden = true;
              if (choice === 'granted') loadAds();
              // Ad scripts cannot be unloaded, so a reload applies a withdrawn choice.
              else if (document.getElementById('hilltopads-push-script')) location.reload();
            });
          });

          document.querySelectorAll('[data-ad-choice-reset]').forEach((button) => {
            button.addEventListener('click', () => {
              try { window.localStorage.removeItem(config.consentKey); } catch {}
              if (!(panel instanceof HTMLElement)) return;
              panel.hidden = false;
              panel.querySelector('button')?.focus({ preventScroll: true });
            });
          });

          if (!inConsentRegion) {
            loadAds();
            return;
          }

          const choice = readChoice();
          if (choice === 'granted') loadAds();
          else if (choice === null && panel instanceof HTMLElement) panel.hidden = false;
        })();`}
      />
    </>
  )
}
