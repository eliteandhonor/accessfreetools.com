---
import { getCategoryName, type ToolDefinition } from '../data/tools';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const url = new URL(`/tools/${tool.slug}/`, Astro.site ?? 'https://accessfreetools.com').toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  applicationCategory: 'UtilitiesApplication',
  applicationSubCategory: getCategoryName(tool.category),
  operatingSystem: 'Any',
  url,
  description: tool.seoDescription,
  isAccessibleForFree: true,
  keywords: [tool.name, ...(tool.aliases ?? []), getCategoryName(tool.category), 'free online tool', 'Access Free Tools'],
  publisher: {
    '@type': 'Organization',
    name: 'Access Free Tools',
    url: new URL('/', Astro.site ?? 'https://accessfreetools.com').toString(),
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
