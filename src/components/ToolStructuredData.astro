---
import { getCategoryName, type ToolDefinition } from '../data/tools';
import { getBlogGuidePathForTool } from '../data/blogGuideCanonicals';
import { getDeepAuditRecord } from '../data/toolDeepAudit';

interface Props {
  tool: ToolDefinition;
  imagePath?: string;
}

const { tool, imagePath } = Astro.props;
const url = new URL(`/tools/${tool.slug}/`, Astro.site ?? 'https://accessfreetools.com').toString();
const image = imagePath ? new URL(imagePath, Astro.site ?? 'https://accessfreetools.com').toString() : undefined;
const siteUrl = Astro.site ?? 'https://accessfreetools.com';
const auditRecord = getDeepAuditRecord(tool.slug);
const guideUrl = new URL(getBlogGuidePathForTool(tool.slug), siteUrl).toString();
const publisher = {
  '@type': 'Organization',
  name: 'Access Free Tools',
  url: new URL('/', siteUrl).toString(),
};
const webApplication = {
  '@type': 'WebApplication',
  '@id': `${url}#tool`,
  name: tool.name,
  applicationCategory: tool.applicationCategory ?? 'UtilitiesApplication',
  applicationSubCategory: getCategoryName(tool.category),
  operatingSystem: 'Any',
  url,
  ...(image ? { image, primaryImageOfPage: image } : {}),
  description: tool.seoDescription,
  isAccessibleForFree: true,
  keywords: [tool.name, ...(tool.aliases ?? []), getCategoryName(tool.category), 'free online tool', 'Access Free Tools'],
  featureList: tool.useCases,
  mainEntityOfPage: url,
  softwareHelp: guideUrl,
  dateModified: auditRecord?.reviewedOn,
  reviewedBy: auditRecord ? publisher : undefined,
  citation: auditRecord?.sources.slice(0, 3).map((source) => source.href),
  publisher,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [webApplication],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
